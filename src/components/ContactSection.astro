---
/**
 * ContactSection — čierna sekcia s gradient orbmi, headline a CTA + ci-chan boxy.
 * Používa sa na konci každej stránky.
 *
 * Props:
 *  - accent?: 'audit' | 'stratégiu' | 'plán' | 'call'  — slovo v gradientovom h2
 *  - lead?: string  — popis pod headline
 *
 * Word rotator (v adlify-app.js) automaticky rotuje slovo v .grad
 * keď je obsah jeden zo 4 vyšsie uvedených.
 */

import { fetchSettings } from '../lib/content';
import { t } from '../lib/translations';
import { buildUrl, type Lang } from '../lib/i18n';

interface Props {
  accent?: 'audit' | 'stratégiu' | 'plán' | 'call';
  lead?: string;
  lang?: Lang;
}

const {
  accent = 'audit',
  lead,
  lang = 'sk',
} = Astro.props;

// Map accent SK keyword -> translated word
const accentMap: Record<string, string> = {
  'audit':      t('contactSection.accentAudit', lang),
  'stratégiu': t('contactSection.accentStrategy', lang),
  'plán':      t('contactSection.accentPlan', lang),
  'call':       t('contactSection.accentCall', lang),
};
const accentText = `${accentMap[accent] || accent}.`;

const finalLead = lead || t('contactSection.lead', lang);

// Fetch settings z DB (kontakty)
const settings = await fetchSettings('sk');
// Fallback hodnoty (ak DB nevracia, napr. chyba env vars na Netlify)
const email   = settings.contact_email   || 'info@adlify.eu';
const phone   = settings.contact_phone   || '+421944184045';
// Adresa kancelárie (priorita), fallback na fakturačnú alebo hardcoded NZ
const address = settings.office_address || settings.contact_address || 'Podzámska 4/A, 940 01 Nové Zámky';
---

<section class="contact-section" id="kontakt">
  <!-- Animated orbs + grid pozadie -->
  <div aria-hidden="true" class="contact-orb-a"></div>
  <div aria-hidden="true" class="contact-orb-b"></div>
  <div aria-hidden="true" class="contact-grid-bg"></div>

  <div class="container" style="position: relative;">
    <!-- Eyebrow -->
    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 40px;">
      <span style="font-family: var(--mono); font-size: 12px; opacity: 0.5; letter-spacing: 0.05em;">{t('contactSection.eyebrow', lang)}</span>
      <span style="flex: 1; height: 1px; background: rgba(255, 255, 255, 0.12);"></span>
      <span class="pill" style="background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.12); color: rgba(255, 255, 255, 0.75);">
        <span class="dot"></span>
        <span>{t('contactSection.responsePill', lang)}</span>
      </span>
    </div>

    <!-- Headline -->
    <div style="max-width: 1000px; margin-bottom: 64px;">
      <h2 style="font-size: clamp(48px, 8vw, 128px); font-weight: 700; letter-spacing: -0.045em; line-height: 0.95;">
        <span style="display: block;">{t('contactSection.titlePrefix', lang)}</span>
        <span style="display: inline-block; position: relative;">
          <span class="grad" data-rotator-target data-rotator-words={JSON.stringify([
          accentText,
          t('rotator.contact1', lang),
          t('rotator.contact2', lang),
          t('rotator.contact3', lang),
          t('rotator.contact4', lang),
        ].filter((v, i, a) => a.indexOf(v) === i))} style="display: inline-block;">{accentText}</span>
          <span style="display: inline-block; width: 0.5ch; height: 0.9em; background: var(--grad-start); margin-left: 8px; vertical-align: -0.1em; animation: blink 1s steps(1) infinite;"></span>
        </span>
      </h2>
      <p style="font-size: clamp(17px, 1.6vw, 21px); opacity: 0.65; max-width: 55ch; margin-top: 32px; line-height: 1.5;">
        {finalLead}
      </p>
    </div>

    <!-- Split: hlavné CTA vľavo + 4 ci-chan boxy vpravo -->
    <div class="contact-split">
      <!-- Hlavné CTA -->
      <a href={`${buildUrl(lang, '/kontakt')}#formular`} class="contact-cta">
        <div aria-hidden="true" class="contact-cta-orb"></div>
        <div style="position: relative;">
          <div class="eyebrow" style="opacity: 0.55; color: var(--bg); margin-bottom: 20px;">{t('contactSection.ctaEyebrow', lang)}</div>
          <div style="font-size: clamp(26px, 3vw, 40px); font-weight: 600; letter-spacing: -0.025em; line-height: 1.1; margin-bottom: 24px; max-width: 16ch;">
            {t('contactSection.ctaTitle', lang)}
          </div>
          <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 32px;">
            <div style="display: flex; align-items: center; gap: 10px; font-size: 14px; opacity: 0.7;">
              <span style="width: 8px; height: 8px; border-radius: 50%; background: rgb(34, 197, 94); box-shadow: 0 0 12px rgb(34, 197, 94);"></span>
              <span>{t('contactSection.ctaNote', lang)}</span>
            </div>
            <div style="width: 56px; height: 56px; border-radius: 50%; background: linear-gradient(100deg, var(--grad-start), var(--grad-end)); display: flex; align-items: center; justify-content: center;">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 17 17 7"></path>
                <path d="M7 7h10v10"></path>
              </svg>
            </div>
          </div>
        </div>
      </a>

      <!-- 4 ci-chan kontaktné boxy -->
      <div style="display: flex; flex-direction: column; gap: 12px;">
        <a href={`mailto:${email}`} class="ci-chan">
          <div class="ci-chan-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="5" width="18" height="14" rx="2"></rect>
              <path d="m3 7 9 6 9-6"></path>
            </svg>
          </div>
          <div style="flex: 1;">
            <div class="eyebrow" style="opacity: 0.55; color: var(--bg); margin-bottom: 4px;">{t('contactSection.channelEmail', lang)}</div>
            <div style="font-weight: 500; font-size: 15px;">{email}</div>
          </div>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="opacity: 0.5;">
            <path d="M7 17 17 7"></path>
            <path d="M7 7h10v10"></path>
          </svg>
        </a>

        {phone && (
          <a href={`tel:${phone.replace(/\s/g, '')}`} class="ci-chan">
            <div class="ci-chan-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 16.9v3a2 2 0 0 1-2.2 2 20 20 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A20 20 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7 12 12 0 0 0 .7 2.8 2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5 12 12 0 0 0 2.8.7 2 2 0 0 1 1.7 2z"></path>
              </svg>
            </div>
            <div style="flex: 1;">
              <div class="eyebrow" style="opacity: 0.55; color: var(--bg); margin-bottom: 4px;">{t('contactSection.channelPhone', lang)}</div>
              <div style="font-weight: 500; font-size: 15px;">{phone}</div>
            </div>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="opacity: 0.5;">
              <path d="M7 17 17 7"></path>
              <path d="M7 7h10v10"></path>
            </svg>
          </a>
        )}

        {phone && (
          <a href={`https://wa.me/${phone.replace(/[^\d]/g, '')}`} target="_blank" rel="noopener" class="ci-chan">
            <div class="ci-chan-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
              </svg>
            </div>
            <div style="flex: 1;">
              <div class="eyebrow" style="opacity: 0.55; color: var(--bg); margin-bottom: 4px;">{t('contactSection.channelWhatsapp', lang)}</div>
              <div style="font-weight: 500; font-size: 15px;">{phone}</div>
            </div>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="opacity: 0.5;">
              <path d="M7 17 17 7"></path>
              <path d="M7 7h10v10"></path>
            </svg>
          </a>
        )}

        {address && (
          <div class="ci-chan" style="cursor: default;">
            <div class="ci-chan-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 10c0 7-8 13-8 13s-8-6-8-13a8 8 0 0 1 16 0"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <div style="flex: 1;">
              <div class="eyebrow" style="opacity: 0.55; color: var(--bg); margin-bottom: 4px;">{t('contactSection.channelOffice', lang)}</div>
              <div style="font-weight: 500; font-size: 15px;">{address}</div>
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</section>
