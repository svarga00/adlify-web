---
/**
 * /cookies — Cookies a tracking
 */

import Layout from '../../layouts/Layout.astro';
import { fetchSettings } from '../../lib/content';
import { pageMeta } from '../../lib/pageMeta';
import type { Lang } from '../../lib/i18n';
import { t } from '../../lib/translations';

interface Props {
  lang?: Lang;
}
const { lang = 'sk' } = Astro.props;
const meta = pageMeta.cookies[lang];
const settings = await fetchSettings(lang);

const dateLocale = ({ sk: 'sk-SK', cs: 'cs-CZ', hu: 'hu-HU', en: 'en-GB', de: 'de-DE' } as const)[lang];
const today = new Date().toLocaleDateString(dateLocale);
---

<Layout
  title={meta.title}
  description={meta.description}
  lang={lang}
  pathname="/cookies"
>

  <!-- Subtílny hero -->
  <section class="legal-hero">
    <div class="container" style="max-width: 1080px;">
      <nav class="legal-breadcrumb" aria-label="Breadcrumb">
        <a href="/">{t('legal.crumbHome', lang)}</a>
        <span class="sep">/</span>
        <span>{t('legal.crumbCookies', lang)}</span>
      </nav>
      <div class="legal-eyebrow">{t('cookies.docEyebrow', lang)}</div>
      <h1 class="legal-h1">{t('cookies.h1', lang)}</h1>
      <p class="legal-lead">
        {t('cookies.lead', lang)}
      </p>
      <div class="legal-meta-row">
        <span><strong>{t('legal.effectiveFrom', lang)}:</strong> {today}</span>
        <span class="dot">·</span>
        <span><strong>{t('legal.version', lang)}:</strong> 1.0</span>
        <span class="dot">·</span>
        <a href="#" data-cookie-reset>{t('legal.manageConsent', lang)}</a>
      </div>
    </div>
  </section>

  <section style="padding-bottom: clamp(80px, 10vw, 140px);">
    <div class="container" style="max-width: 1080px;">
      <div class="legal-layout">

        <article class="legal-prose">

          <h2 id="co-su">{t('cookies.s1Title', lang)}</h2>
          <p>{t('cookies.s1Body', lang)}</p>

          <h2 id="ake-pouzivame">{t('cookies.s2Title', lang)}</h2>

          <h3>{t('cookies.s2aHeading', lang)}</h3>
          <p>{t('cookies.s2aBody', lang)}</p>
          <table class="legal-table">
            <thead>
              <tr><th>{t('cookies.tblName', lang)}</th><th>{t('cookies.tblPurpose', lang)}</th><th>{t('cookies.tblDuration', lang)}</th></tr>
            </thead>
            <tbody>
              <tr><td>adlify_consent</td><td>{t('cookies.row1Purpose', lang)}</td><td>{t('cookies.row1Dur', lang)}</td></tr>
              <tr><td>language</td><td>{t('cookies.row2Purpose', lang)}</td><td>{t('cookies.row2Dur', lang)}</td></tr>
            </tbody>
          </table>

          <h3>{t('cookies.s2bHeading', lang)}</h3>
          <p>{t('cookies.s2bBody', lang)}</p>
          <table class="legal-table">
            <thead>
              <tr><th>{t('cookies.tblName', lang)}</th><th>{t('cookies.tblProvider', lang)}</th><th>{t('cookies.tblPurpose', lang)}</th><th>{t('cookies.tblDuration', lang)}</th></tr>
            </thead>
            <tbody>
              <tr><td>_ga, _ga_*</td><td>Google Analytics</td><td>{t('cookies.row3Purpose', lang)}</td><td>{t('cookies.row3Dur', lang)}</td></tr>
              <tr><td>_gid</td><td>Google Analytics</td><td>{t('cookies.row4Purpose', lang)}</td><td>{t('cookies.row4Dur', lang)}</td></tr>
              <tr><td>_clck, _clsk</td><td>Microsoft Clarity</td><td>{t('cookies.row5Purpose', lang)}</td><td>{t('cookies.row5Dur', lang)}</td></tr>
            </tbody>
          </table>

          <h3>{t('cookies.s2cHeading', lang)}</h3>
          <p>{t('cookies.s2cBody', lang)}</p>
          <table class="legal-table">
            <thead>
              <tr><th>{t('cookies.tblName', lang)}</th><th>{t('cookies.tblProvider', lang)}</th><th>{t('cookies.tblPurpose', lang)}</th><th>{t('cookies.tblDuration', lang)}</th></tr>
            </thead>
            <tbody>
              <tr><td>_fbp</td><td>Meta (Facebook)</td><td>{t('cookies.row6Purpose', lang)}</td><td>{t('cookies.row6Dur', lang)}</td></tr>
              <tr><td>_gcl_au</td><td>Google Ads</td><td>{t('cookies.row7Purpose', lang)}</td><td>{t('cookies.row7Dur', lang)}</td></tr>
            </tbody>
          </table>

          <h2 id="ako-spravovat">{t('cookies.s3Title', lang)}</h2>
          <p>{t('cookies.s3Body1', lang)}</p>
          <ul>
            <li>{t('cookies.s3Bullet1', lang)} <a href="#" data-cookie-reset>„{t('cookies.s3BulletLink', lang)}"</a> {t('cookies.s3Bullet1End', lang)}</li>
            <li>{t('cookies.s3Bullet2', lang)}</li>
          </ul>
          <p>{t('cookies.s3Body2', lang)}</p>
          <ul>
            <li><a href="https://support.google.com/chrome/answer/95647" target="_blank" rel="noopener">Google Chrome</a></li>
            <li><a href="https://support.mozilla.org/sk/kb/cookies-informacie-ktore-stranky-ukladaju-na-pocitaci" target="_blank" rel="noopener">Mozilla Firefox</a></li>
            <li><a href="https://support.apple.com/sk-sk/guide/safari/sfri11471/mac" target="_blank" rel="noopener">Safari</a></li>
            <li><a href="https://support.microsoft.com/sk-sk/microsoft-edge" target="_blank" rel="noopener">Microsoft Edge</a></li>
          </ul>

          <h2 id="dosledky">{t('cookies.s4Title', lang)}</h2>
          <p>{t('cookies.s4Body', lang)}</p>

          <h2 id="dalsie">{t('cookies.s5Title', lang)}</h2>
          <p>
            {t('cookies.s5BodyPrefix', lang)} <a href="/ochrana-udajov">{t('cookies.s5BodyLink', lang)}</a>.
          </p>

          <hr />
          <p class="legal-meta">
            {t('legal.lastUpdate', lang)}: {today}<br />
            {t('legal.questionsAt', lang)}: <a href={`mailto:${settings.contact_email || 'info@adlify.eu'}`}>{settings.contact_email || 'info@adlify.eu'}</a>
          </p>
        </article>

        <aside class="legal-sidebar">
          <div class="legal-sidebar-sticky">
            <div class="legal-sidebar-eyebrow">{t('legal.tocEyebrow', lang)}</div>
            <nav class="legal-toc" aria-label={t('legal.tocAria', lang)}>
              <ol>
                <li><a href="#co-su">{t('cookies.toc1', lang)}</a></li>
                <li><a href="#ake-pouzivame">{t('cookies.toc2', lang)}</a></li>
                <li><a href="#ako-spravovat">{t('cookies.toc3', lang)}</a></li>
                <li><a href="#dosledky">{t('cookies.toc4', lang)}</a></li>
                <li><a href="#dalsie">{t('cookies.toc5', lang)}</a></li>
              </ol>
            </nav>
          </div>
        </aside>
      </div>
    </div>
  </section>

</Layout>
