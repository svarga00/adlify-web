---
/**
 * /blog — Blog & Insights listing
 *
 * REFACTOROVANÉ: dáta zo Supabase (web_blog_posts).
 * Featured článok = najnovší is_featured=true.
 * Ak žiadny is_featured, použijeme prvý zoznam.
 */

import Layout from '../../layouts/Layout.astro';
import PageHero from '../PageHero.astro';
import ContactSection from '../ContactSection.astro';
import { fetchAllPosts, fetchFeaturedPost } from '../../lib/content';
import { pageMeta } from '../../lib/pageMeta';
import { buildUrl, type Lang } from '../../lib/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'sk' } = Astro.props;
const meta = pageMeta.blog[lang];

const allPosts = await fetchAllPosts(lang);
const featured = (await fetchFeaturedPost(lang)) || allPosts[0] || null;

// Vyfiltruj featured zo zoznamu aby sa nezobrazoval 2×
const articles = featured ? allPosts.filter((p) => p.id !== featured.id) : allPosts;

// Dynamicke kategórie z dát + "Všetko" ako prvý
const usedCategories = Array.from(new Set(allPosts.map((p) => p.category)));
const allLabel = ({ sk: 'Všetko', cs: 'Vše', hu: 'Mind', en: 'All', de: 'Alle' } as const)[lang];
const categoryFilters = [allLabel, ...usedCategories];

// Helper na format dátumu
const dateLocale = ({ sk: 'sk-SK', cs: 'cs-CZ', hu: 'hu-HU', en: 'en-US', de: 'de-DE' } as const)[lang];
function formatDate(iso: string): string {
  const d = new Date(iso);
  return d.toLocaleDateString(dateLocale, { day: '2-digit', month: '2-digit', year: 'numeric' });
}

function readTime(min: number) {
  return `${min} min`;
}

function catSlug(c: string) {
  return c.toLowerCase().replace(/\s+/g, '-');
}
---

<Layout
  title={meta.title}
  description={meta.description}
  lang={lang}
  pathname="/blog"
>

  <PageHero
    num={meta.hero!.num}
    kind={meta.hero!.kind}
    title={meta.hero!.title}
    titleAccent={meta.hero!.titleAccent}
    lead={meta.hero!.lead}
  />


  <!-- ============================================
       INTRO box — krátky odsek o tóne blogu
       ============================================ -->
  <section class="section" style="padding-top: 0; padding-bottom: clamp(24px, 3vw, 48px);">
    <div class="container" style="max-width: 880px;">
      <div style="background: var(--bg-soft); border-left: 3px solid var(--grad-start); padding: 24px 28px; border-radius: 12px;">
        <p style="font-size: 16px; line-height: 1.7; margin: 0; color: var(--ink-2);">
          <strong>Žiadne marketingové fluffy posty.</strong> Píšeme len o tom, čo robíme každý deň —
          konkrétne kampane, presné čísla, návody, ktoré niekomu reálne pomohli. Bez clickbait nadpisov
          a bez generic "10 tipov".
        </p>
      </div>
    </div>
  </section>


  {allPosts.length === 0 ? (
    <section class="section" style="padding-top: 0;">
      <div class="container">
        <div style="padding: 64px 32px; text-align: center; background: var(--bg-soft); border: 1px solid var(--line); border-radius: 24px; max-width: 720px; margin: 0 auto;">
          <div style="width: 56px; height: 56px; border-radius: 14px; background: linear-gradient(135deg, var(--grad-start), var(--grad-end)); color: white; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px;">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
          </div>
          <h3 style="font-size: 22px; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 12px;">
            Pripravujeme prvé články.
          </h3>
          <p style="font-size: 15px; line-height: 1.6; color: var(--muted); max-width: 50ch; margin: 0 auto 24px;">
            Pracujeme na sérii praktických článkov — od Google Ads cez meranie po automatizácie.
            Medzitým si môžete prejsť naše služby alebo nás kontaktovať s konkrétnou otázkou.
          </p>
          <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
            <a href={buildUrl(lang, '/sluzby')} class="btn btn-ink">
              Pozrieť služby
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            </a>
            <a href={buildUrl(lang, '/kontakt')} class="btn btn-outline">
              Mám otázku
            </a>
          </div>
        </div>
      </div>
    </section>
  ) : (
    <>

      <!-- ============================================
           FEATURED ARTICLE
           ============================================ -->
      {featured && (
        <section style="padding-bottom: clamp(48px, 6vw, 80px);">
          <div class="container">
            <a href={buildUrl(lang, `/blog/${featured.slug}`)} class="featured-card" style="display: grid; grid-template-columns: 1fr 1fr; gap: 0; background: var(--bg); border: 1px solid var(--line); border-radius: 24px; overflow: hidden; color: var(--ink); transition: transform 0.3s, box-shadow 0.3s;">
              <div style={`position: relative; aspect-ratio: 4 / 3; background: ${featured.cover_image_url ? `url('${featured.cover_image_url}') center/cover` : featured.cover_gradient}; min-height: 360px;`}>
                {!featured.cover_image_url && (
                  <div aria-hidden="true" style="position: absolute; inset: 0; background-image: radial-gradient(circle at 30% 40%, rgba(255,255,255,0.25), transparent 50%);"></div>
                )}

                <div style="position: absolute; top: 24px; left: 24px;">
                  <span style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; background: rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.18); border-radius: 999px; font-family: var(--mono); font-size: 10px; font-weight: 700; letter-spacing: 0.08em; color: white;">
                    <span style="width: 6px; height: 6px; border-radius: 50%; background: rgb(34,197,94); box-shadow: 0 0 10px rgb(34,197,94);"></span>
                    FEATURED
                  </span>
                </div>

                <div style="position: absolute; bottom: 24px; left: 24px; color: white;">
                  <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
                    <span style="font-family: var(--mono); font-size: 11px; font-weight: 700; letter-spacing: 0.08em; padding: 4px 10px; background: rgba(255,255,255,0.18); border-radius: 999px;">
                      {featured.category.toUpperCase()}
                    </span>
                    <span style="font-family: var(--mono); font-size: 11px; opacity: 0.8;">·</span>
                    <span style="font-family: var(--mono); font-size: 11px; opacity: 0.8;">{formatDate(featured.published_at)}</span>
                    <span style="font-family: var(--mono); font-size: 11px; opacity: 0.8;">·</span>
                    <span style="font-family: var(--mono); font-size: 11px; opacity: 0.8;">{readTime(featured.read_time_min)}</span>
                  </div>
                </div>
              </div>

              <div style="padding: clamp(32px, 4vw, 56px); display: flex; flex-direction: column; justify-content: center;">
                <h2 style="font-size: clamp(28px, 3.6vw, 44px); font-weight: 700; letter-spacing: -0.025em; line-height: 1.1; margin-bottom: 20px;">
                  {featured.title}
                </h2>
                <p class="body" style="font-size: 16px; line-height: 1.6; max-width: 50ch; margin-bottom: 32px;">
                  {featured.excerpt}
                </p>

                <div style="display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-top: 24px; border-top: 1px solid var(--line);">
                  <div style="display: flex; align-items: center; gap: 12px;">
                    <div style="width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, var(--grad-start), var(--grad-end)); color: white; font-weight: 700; font-size: 13px; display: flex; align-items: center; justify-content: center;">
                      {featured.author_initials}
                    </div>
                    <div>
                      <div style="font-size: 14px; font-weight: 600;">{featured.author_name}</div>
                      <div style="font-size: 12px; color: var(--muted);">{featured.author_role || 'Autor článku'}</div>
                    </div>
                  </div>
                  <span class="btn btn-sm btn-ink">
                    Čítať
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M5 12h14"></path>
                      <path d="m12 5 7 7-7 7"></path>
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          </div>

          <style>
            .featured-card:hover { transform: translateY(-4px); box-shadow: 0 32px 64px -20px rgba(0,0,0,0.18); }
            @media (max-width: 900px) { .featured-card { grid-template-columns: 1fr !important; } }
          </style>
        </section>
      )}


      <!-- ============================================
           KATEGÓRIA FILTRE + GRID OSTATNÝCH
           ============================================ -->
      <section class="section" style="padding-top: 0;">
        <div class="container">

          <div class="cat-bar" style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 48px; padding-bottom: 24px; border-bottom: 1px solid var(--line);">
            {categoryFilters.map((cat, i) => (
              <button
                class={`cat-chip ${i === 0 ? 'active' : ''}`}
                data-cat-filter={catSlug(cat)}
                style={`padding: 8px 16px; border-radius: 999px; font-size: 13px; font-weight: 500; border: 1px solid var(--line); background: ${i === 0 ? 'var(--ink)' : 'transparent'}; color: ${i === 0 ? 'var(--bg)' : 'var(--ink)'}; cursor: pointer; transition: all 0.2s;`}
              >
                {cat}
              </button>
            ))}
          </div>

          <div class="articles-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;">
            {articles.map((a) => (
              <a
                href={buildUrl(lang, `/blog/${a.slug}`)}
                class="article-card"
                data-cat={catSlug(a.category)}
                style="background: var(--bg); border: 1px solid var(--line); border-radius: 20px; overflow: hidden; color: var(--ink); display: flex; flex-direction: column; transition: transform 0.3s, box-shadow 0.3s;"
              >
                <div style={`aspect-ratio: 16 / 9; background: ${a.cover_image_url ? `url('${a.cover_image_url}') center/cover` : a.cover_gradient}; position: relative; overflow: hidden;`}>
                  {!a.cover_image_url && (
                    <div aria-hidden="true" style="position: absolute; inset: 0; background-image: radial-gradient(circle at 30% 40%, rgba(255,255,255,0.2), transparent 50%);"></div>
                  )}
                  <div style="position: absolute; top: 16px; left: 16px;">
                    <span style="display: inline-flex; padding: 4px 10px; background: rgba(0,0,0,0.45); border: 1px solid rgba(255,255,255,0.18); border-radius: 999px; font-family: var(--mono); font-size: 9px; font-weight: 700; letter-spacing: 0.08em; color: white;">
                      {a.category.toUpperCase()}
                    </span>
                  </div>
                </div>

                <div style="padding: 24px; display: flex; flex-direction: column; flex: 1;">
                  <div style="display: flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: 10px; color: var(--muted); margin-bottom: 12px;">
                    <span>{formatDate(a.published_at)}</span>
                    <span>·</span>
                    <span>{readTime(a.read_time_min)}</span>
                  </div>

                  <h3 style="font-size: 18px; font-weight: 600; letter-spacing: -0.015em; line-height: 1.3; margin-bottom: 10px;">{a.title}</h3>

                  <p class="body" style="font-size: 13px; line-height: 1.55; flex: 1; margin-bottom: 16px;">{a.excerpt}</p>

                  <div style="display: flex; align-items: center; justify-content: space-between; padding-top: 14px; border-top: 1px solid var(--line); font-size: 12px; color: var(--muted);">
                    <span>{a.author_name}</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M7 17 17 7"></path>
                      <path d="M7 7h10v10"></path>
                    </svg>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>

        <style>
          .article-card:hover { transform: translateY(-4px); box-shadow: 0 24px 48px -16px rgba(0,0,0,0.12); }
          .cat-chip:hover:not(.active) { background: var(--bg-soft); }
          .cat-chip.active { background: var(--ink) !important; color: var(--bg) !important; border-color: var(--ink) !important; }
          .article-card.hidden { display: none; }
          @media (max-width: 1024px) { .articles-grid { grid-template-columns: 1fr 1fr !important; } }
          @media (max-width: 600px)  { .articles-grid { grid-template-columns: 1fr !important; } }
        </style>
      </section>


      <!-- ============================================
           NEWSLETTER CTA
           ============================================ -->
      <section style="padding: clamp(56px, 7vw, 96px) 0; background: var(--bg-soft);">
        <div class="container" style="max-width: 720px; text-align: center;">
          <h2 style="font-size: clamp(28px, 4vw, 44px); font-weight: 700; letter-spacing: -0.03em; line-height: 1.15; margin-bottom: 16px; max-width: 22ch; margin-left: auto; margin-right: auto;">
            Nový článok raz za 2 týždne. <span class="grad">Bez spamu.</span>
          </h2>
          <p class="lead" style="margin-bottom: 32px;">
            Pracovné nálezy, mini case studies a veci, ktoré nás prekvapili. Odhlásiť sa dá jedným klikom.
          </p>

          <form data-newsletter-form style="display: flex; gap: 8px; max-width: 480px; margin: 0 auto; flex-wrap: wrap;">
            <input
              type="email"
              name="email"
              required
              placeholder="meno@firma.sk"
              class="field"
              style="flex: 1; min-width: 240px;"
            >
            <button type="submit" class="btn btn-grad">
              Prihlásiť
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </button>
          </form>

          <div data-newsletter-status style="margin-top: 16px; font-size: 13px; display: none;"></div>
        </div>
      </section>

    </>
  )}


  <ContactSection accent="call" />


  <script is:inline>
    (function () {
      const chips = document.querySelectorAll('.cat-chip');
      const cards = document.querySelectorAll('.article-card');
      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          chips.forEach((c) => c.classList.remove('active'));
          chip.classList.add('active');
          const filter = chip.dataset.catFilter;
          cards.forEach((card) => {
            const isMatch = filter === 'všetko' || card.dataset.cat === filter;
            card.classList.toggle('hidden', !isMatch);
          });
        });
      });
    })();

    (function () {
      const form = document.querySelector('[data-newsletter-form]');
      const status = document.querySelector('[data-newsletter-status]');
      if (!form || !status) return;
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        const email = fd.get('email');
        if (!email) return;
        status.style.display = 'block';
        status.style.color = 'rgb(22, 163, 74)';
        status.textContent = '✓ Ďakujeme! Prihlásili sme ' + email + ' do newslettra.';
        form.reset();
      });
    })();
  </script>

</Layout>
