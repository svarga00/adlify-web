---
/**
 * /ochrana-udajov — GDPR / Ochrana osobných údajov
 *
 * Vzorová šablóna v súlade s GDPR (EU 2016/679) a slovenským zákonom 18/2018 Z.z.
 * Údaje firmy sa dotahujú zo web_settings.
 */

import Layout from '../../layouts/Layout.astro';
import { fetchSettings } from '../../lib/content';
import { pageMeta } from '../../lib/pageMeta';
import { buildUrl, type Lang } from '../../lib/i18n';
import { t } from '../../lib/translations';

interface Props {
  lang?: Lang;
}
const { lang = 'sk' } = Astro.props;
const meta = pageMeta.privacy[lang];
const settings = await fetchSettings(lang);

const ph = (val: string, label: string) => val || `[${label}]`;
const company    = ph(settings.company_name,    'názov firmy');
const ico        = ph(settings.company_ico,     'IČO');
const address    = ph(settings.contact_address, 'sídlo');
const email      = ph(settings.contact_email,   'e-mail');

const dateLocale = ({ sk: 'sk-SK', cs: 'cs-CZ', hu: 'hu-HU', en: 'en-GB', de: 'de-DE' } as const)[lang];
const today = new Date().toLocaleDateString(dateLocale);
---

<Layout
  title={meta.title}
  description={meta.description}
  lang={lang}
  pathname="/ochrana-udajov"
>

  <!-- Subtílny hero -->
  <section class="legal-hero">
    <div class="container" style="max-width: 1080px;">
      <nav class="legal-breadcrumb" aria-label="Breadcrumb">
        <a href="/">{t('legal.crumbHome', lang)}</a>
        <span class="sep">/</span>
        <span>{t('legal.crumbPrivacy', lang)}</span>
      </nav>
      <div class="legal-eyebrow">{t('privacy.docEyebrow', lang)}</div>
      <h1 class="legal-h1">{t('privacy.h1', lang)}</h1>
      <p class="legal-lead">
        {t('privacy.lead', lang)}
      </p>
      <div class="legal-meta-row">
        <span><strong>{t('legal.effectiveFrom', lang)}:</strong> {today}</span>
        <span class="dot">·</span>
        <span><strong>{t('legal.version', lang)}:</strong> 1.0</span>
        <span class="dot">·</span>
        <a href={`mailto:${settings.contact_email || 'info@adlify.eu'}`}>{settings.contact_email || 'info@adlify.eu'}</a>
      </div>
    </div>
  </section>

  <section style="padding-bottom: clamp(80px, 10vw, 140px);">
    <div class="container" style="max-width: 1080px;">
      <div class="legal-layout">

        <article class="legal-prose">

          <h2 id="prevadzkovatel">{t('privacy.s1Title', lang)}</h2>
          <p>{t('privacy.s1Intro', lang)}</p>
          <ul>
            <li><strong>{company}</strong></li>
            <li>{t('privacy.s1IcoLabel', lang)}: {ico}</li>
            <li>{t('privacy.s1AddressLabel', lang)}: {address}</li>
            <li>{t('privacy.s1ContactLabel', lang)}: {email}</li>
          </ul>
          <p>{t('privacy.s1DpoNote', lang)}</p>

          <h2 id="udaje">{t('privacy.s2Title', lang)}</h2>

          <h3>{t('privacy.s2aTitle', lang)}</h3>
          <ul>
            <li>{t('privacy.s2aItem1', lang)}</li>
            <li>{t('privacy.s2aItem2', lang)}</li>
            <li>{t('privacy.s2aItem3', lang)}</li>
            <li>{t('privacy.s2aItem4', lang)}</li>
            <li>{t('privacy.s2aItem5', lang)}</li>
          </ul>
          <p><strong>{t('privacy.lblPurpose', lang)}:</strong> {t('privacy.s2aPurpose', lang)}</p>
          <p><strong>{t('privacy.lblLegal', lang)}:</strong> {t('privacy.s2aLegal', lang)}</p>
          <p><strong>{t('privacy.lblRetention', lang)}:</strong> {t('privacy.s2aRetention', lang)}</p>

          <h3>{t('privacy.s2bTitle', lang)}</h3>
          <ul>
            <li>{t('privacy.s2bItem1', lang)}</li>
            <li>{t('privacy.s2bItem2', lang)}</li>
          </ul>
          <p><strong>{t('privacy.lblPurpose', lang)}:</strong> {t('privacy.s2bPurpose', lang)}</p>
          <p><strong>{t('privacy.lblLegal', lang)}:</strong> {t('privacy.s2bLegal', lang)}</p>
          <p><strong>{t('privacy.lblRetention', lang)}:</strong> {t('privacy.s2bRetention', lang)}</p>

          <h3>{t('privacy.s2cTitle', lang)}</h3>
          <ul>
            <li>{t('privacy.s2cItem1', lang)}</li>
            <li>{t('privacy.s2cItem2', lang)}</li>
            <li>{t('privacy.s2cItem3', lang)}</li>
          </ul>
          <p><strong>{t('privacy.lblPurpose', lang)}:</strong> {t('privacy.s2cPurpose', lang)}</p>
          <p><strong>{t('privacy.lblLegal', lang)}:</strong> {t('privacy.s2cLegal', lang)}</p>
          <p><strong>{t('privacy.lblRetention', lang)}:</strong> {t('privacy.s2cRetention', lang)}</p>

          <h3>{t('privacy.s2dTitle', lang)}</h3>
          <p>
            {t('privacy.s2dBodyPrefix', lang)} <a href={buildUrl(lang, "/cookies")}>{t('privacy.s2dBodyLink', lang)}</a>{t('privacy.s2dBodySuffix', lang)}
          </p>

          <h2 id="sprostredkovatelia">{t('privacy.s3Title', lang)}</h2>
          <p>{t('privacy.s3Intro', lang)}</p>
          <ul>
            <li><strong>Resend</strong> {t('privacy.s3Resend', lang)}</li>
            <li><strong>Netlify</strong> {t('privacy.s3Netlify', lang)}</li>
            <li><strong>Supabase</strong> {t('privacy.s3Supabase', lang)}</li>
            <li><strong>Google</strong> {t('privacy.s3Google', lang)}</li>
            <li><strong>Meta</strong> {t('privacy.s3Meta', lang)}</li>
            <li>{t('privacy.s3Accountant', lang)}</li>
          </ul>
          <p>{t('privacy.s3UsTransfer', lang)}</p>

          <h2 id="prava">{t('privacy.s4Title', lang)}</h2>
          <p>{t('privacy.s4Intro', lang)}</p>
          <ul>
            <li><strong>{t('privacy.s4r1Label', lang)}</strong> — {t('privacy.s4r1Desc', lang)}</li>
            <li><strong>{t('privacy.s4r2Label', lang)}</strong> — {t('privacy.s4r2Desc', lang)}</li>
            <li><strong>{t('privacy.s4r3Label', lang)}</strong> — {t('privacy.s4r3Desc', lang)}</li>
            <li><strong>{t('privacy.s4r4Label', lang)}</strong> — {t('privacy.s4r4Desc', lang)}</li>
            <li><strong>{t('privacy.s4r5Label', lang)}</strong> — {t('privacy.s4r5Desc', lang)}</li>
            <li><strong>{t('privacy.s4r6Label', lang)}</strong> — {t('privacy.s4r6Desc', lang)}</li>
            <li><strong>{t('privacy.s4r7Label', lang)}</strong> — {t('privacy.s4r7Desc', lang)}</li>
            <li><strong>{t('privacy.s4r8Label', lang)}</strong> — {t('privacy.s4r8Desc', lang)} (<a href="https://dataprotection.gov.sk" target="_blank" rel="noopener">dataprotection.gov.sk</a>).</li>
          </ul>
          <p>
            {t('privacy.s4outro', lang)} <a href={`mailto:${settings.contact_email || 'info@adlify.eu'}`}>{settings.contact_email || 'info@adlify.eu'}</a>
          </p>

          <h2 id="bezpecnost">{t('privacy.s5Title', lang)}</h2>
          <p>{t('privacy.s5Intro', lang)}</p>
          <ul>
            <li>{t('privacy.s5item1', lang)}</li>
            <li>{t('privacy.s5item2', lang)}</li>
            <li>{t('privacy.s5item3', lang)}</li>
            <li>{t('privacy.s5item4', lang)}</li>
            <li>{t('privacy.s5item5', lang)}</li>
          </ul>

          <h2 id="cookies">{t('privacy.s6Title', lang)}</h2>
          <p>
            {t('privacy.s6BodyPrefix', lang)} <a href={buildUrl(lang, "/cookies")}>{t('privacy.s6BodyLink', lang)}</a>.
          </p>

          <h2 id="zmeny">{t('privacy.s7Title', lang)}</h2>
          <p>{t('privacy.s7Body', lang)}</p>

          <hr />
          <p class="legal-meta">
            {t('legal.lastUpdate', lang)}: {today}<br />
            {t('legal.questionsAt', lang)}: <a href={`mailto:${settings.contact_email || 'info@adlify.eu'}`}>{settings.contact_email || 'info@adlify.eu'}</a>
          </p>
        </article>

        <aside class="legal-sidebar">
          <div class="legal-sidebar-sticky">
            <div class="legal-sidebar-eyebrow">{t('legal.tocEyebrow', lang)}</div>
            <nav class="legal-toc" aria-label={t('legal.tocAria', lang)}>
              <ol>
                <li><a href="#prevadzkovatel">{t('privacy.toc1', lang)}</a></li>
                <li><a href="#udaje">{t('privacy.toc2', lang)}</a></li>
                <li><a href="#sprostredkovatelia">{t('privacy.toc3', lang)}</a></li>
                <li><a href="#prava">{t('privacy.toc4', lang)}</a></li>
                <li><a href="#bezpecnost">{t('privacy.toc5', lang)}</a></li>
                <li><a href="#cookies">{t('privacy.toc6', lang)}</a></li>
                <li><a href="#zmeny">{t('privacy.toc7', lang)}</a></li>
              </ol>
            </nav>
          </div>
        </aside>
      </div>
    </div>
  </section>

</Layout>
