---
/**
 * BlogDetail body — prijíma `post` a `lang` ako props.
 *
 * Layout: 2-column grid (article + sidebar) na desktope,
 * stack na mobile. Sidebar má:
 *  - Table of Contents (extrahovaný z H2 v body)
 *  - Súvisiace články (z rovnakej kategórie)
 *  - CTA panel (audit zadarmo)
 *  - Share buttons (LinkedIn, X, copy URL)
 */

import Layout from '../../layouts/Layout.astro';
import ContactSection from '../ContactSection.astro';
import { type BlogPost, fetchAllPosts } from '../../lib/content';
import { buildUrl, type Lang } from '../../lib/i18n';
import { t } from '../../lib/translations';
import { marked, Marked } from 'marked';

interface Props {
  post: BlogPost;
  lang?: Lang;
}

const { post, lang = 'sk' } = Astro.props;

// =====================================
// MARKDOWN render s automatickými ID na H2/H3 pre ToC
// =====================================
function slugify(s: string): string {
  return s
    .toLowerCase()
    .replace(/[áä]/g, 'a').replace(/[éě]/g, 'e').replace(/[íi]/g, 'i')
    .replace(/[óö]/g, 'o').replace(/[úůü]/g, 'u').replace(/[ýÿ]/g, 'y')
    .replace(/[čć]/g, 'c').replace(/[ďđ]/g, 'd').replace(/[ľĺ]/g, 'l')
    .replace(/ň/g, 'n').replace(/[řŕ]/g, 'r').replace(/[šś]/g, 's')
    .replace(/[ťţ]/g, 't').replace(/[žźż]/g, 'z')
    .replace(/[^a-z0-9\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-')
    .slice(0, 60);
}

const tocItems: Array<{ id: string; text: string; level: number }> = [];

// Nová Marked instancia (renderer nezdieľa stav medzi requestmi)
const md = new Marked({
  renderer: {
    heading(token: any) {
      const text = this.parser.parseInline(token.tokens);
      const cleanText = text.replace(/<[^>]+>/g, '').trim();
      const id = slugify(cleanText);
      if (token.depth === 2 || token.depth === 3) {
        tocItems.push({ id, text: cleanText, level: token.depth });
      }
      return `<h${token.depth} id="${id}">${text}</h${token.depth}>\n`;
    },
  },
});

const bodyHtml = md.parse(post.body, { async: false }) as string;

// =====================================
// SÚVISIACE ČLÁNKY — rovnaká kategória, max 3
// =====================================
const allPosts = await fetchAllPosts(lang);
let relatedPosts = allPosts
  .filter((p) => p.id !== post.id && p.category === post.category)
  .slice(0, 3);

// Ak je menej než 3 z kategórie, doplň najnovšími
if (relatedPosts.length < 3) {
  const others = allPosts
    .filter((p) => p.id !== post.id && !relatedPosts.find((r) => r.id === p.id))
    .slice(0, 3 - relatedPosts.length);
  relatedPosts = [...relatedPosts, ...others];
}

// Format dátumu
const dateLocale = ({ sk: 'sk-SK', cs: 'cs-CZ', hu: 'hu-HU', en: 'en-US', de: 'de-DE' } as const)[lang];
function formatDate(iso: string): string {
  const d = new Date(iso);
  return d.toLocaleDateString(dateLocale, { day: '2-digit', month: 'long', year: 'numeric' });
}
function formatDateShort(iso: string): string {
  const d = new Date(iso);
  return d.toLocaleDateString(dateLocale, { day: '2-digit', month: '2-digit', year: 'numeric' });
}

// Share URLs
const siteUrl = 'https://adlify.eu';
const articleUrl = `${siteUrl}${buildUrl(lang, `/blog/${post.slug}`)}`;
const shareTitle = encodeURIComponent(post.title);
const shareUrl = encodeURIComponent(articleUrl);
---

<Layout
  title={`${post.title} — ${t('nav.blog', lang)} | Adlify`}
  description={post.excerpt}
  lang={lang}
  pathname={`/blog/${post.slug}`}
  pageType="article"
  articleData={{
    publishedTime: post.published_at,
    author: post.author_name,
    section: post.category,
  }}
>

  <!-- ============================================
       HERO — kompaktný
       ============================================ -->
  <section style="padding: clamp(60px, 7vw, 100px) 0 clamp(32px, 4vw, 48px); position: relative;">
    <div class="container" style="max-width: 1240px;">

      <!-- Breadcrumb -->
      <a href={buildUrl(lang, '/blog')} style="display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; background: var(--bg-soft); border: 1px solid var(--line); border-radius: 999px; font-family: var(--mono); font-size: 11px; color: var(--ink); margin-bottom: 32px; text-decoration: none; transition: background 0.2s;">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        Späť na blog
      </a>

      <!-- Meta riadok -->
      <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 24px; font-family: var(--mono); font-size: 12px; color: var(--muted);">
        <span style="padding: 4px 10px; background: linear-gradient(100deg, var(--grad-start), var(--grad-end)); color: white; border-radius: 999px; font-weight: 700; letter-spacing: 0.05em;">
          {post.category.toUpperCase()}
        </span>
        <span>·</span>
        <span>{formatDate(post.published_at)}</span>
        <span>·</span>
        <span>{post.read_time_min} min čítania</span>
      </div>

      <!-- Title -->
      <h1 style="font-size: clamp(36px, 5.5vw, 64px); font-weight: 700; letter-spacing: -0.035em; line-height: 1.1; margin-bottom: 24px; max-width: 22ch;">
        {post.title}
      </h1>

      <!-- Excerpt -->
      <p style="font-size: clamp(17px, 1.7vw, 21px); color: var(--muted); line-height: 1.5; max-width: 60ch; margin-bottom: 40px;">
        {post.excerpt}
      </p>

      <!-- Author -->
      <div style="display: flex; align-items: center; gap: 14px; padding: 20px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);">
        <div style="width: 44px; height: 44px; border-radius: 50%; background: linear-gradient(135deg, var(--grad-start), var(--grad-end)); color: white; font-weight: 700; font-size: 14px; display: flex; align-items: center; justify-content: center;">
          {post.author_initials}
        </div>
        <div>
          <div style="font-size: 15px; font-weight: 600;">{post.author_name}</div>
          {post.author_role && (
            <div style="font-size: 13px; color: var(--muted);">{post.author_role}</div>
          )}
        </div>
      </div>
    </div>
  </section>


  <!-- ============================================
       COVER (gradient banner alebo obrázok)
       ============================================ -->
  <section style="padding-bottom: clamp(40px, 5vw, 64px);">
    <div class="container" style="max-width: 1240px;">
      <div style={`aspect-ratio: 21 / 9; background: ${post.cover_image_url ? `url('${post.cover_image_url}') center/cover` : post.cover_gradient}; border-radius: 24px; position: relative; overflow: hidden;`}>
        {!post.cover_image_url && (
          <div aria-hidden="true" style="position: absolute; inset: 0; background-image: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.25), transparent 50%), radial-gradient(circle at 70% 70%, rgba(255,255,255,0.15), transparent 55%); pointer-events: none;"></div>
        )}
      </div>
    </div>
  </section>


  <!-- ============================================
       TELO + SIDEBAR (2 column grid)
       ============================================ -->
  <section style="padding-bottom: clamp(64px, 8vw, 120px);">
    <div class="container" style="max-width: 1240px;">
      <div class="blog-detail-grid">

        <!-- Hlavný stĺpec: článok -->
        <article class="prose" set:html={bodyHtml}></article>

        <!-- Sidebar (sticky na desktope) -->
        <aside class="blog-sidebar">
          <div class="blog-sidebar-sticky">

            {tocItems.length > 0 && (
              <div class="sidebar-card sidebar-toc">
                <div class="sidebar-eyebrow">[ Obsah ]</div>
                <nav>
                  <ul class="toc-list">
                    {tocItems.map((item) => (
                      <li class={`toc-item toc-level-${item.level}`} data-toc-id={item.id}>
                        <a href={`#${item.id}`}>{item.text}</a>
                      </li>
                    ))}
                  </ul>
                </nav>
              </div>
            )}

            <!-- CTA -->
            <div class="sidebar-card sidebar-cta">
              <div aria-hidden="true" class="sidebar-cta-orb"></div>
              <div style="position: relative;">
                <div class="sidebar-eyebrow" style="color: rgba(255,255,255,0.6);">[ Audit zadarmo ]</div>
                <h3 style="font-size: 20px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.2; margin: 8px 0 12px; color: white;">
                  Chcete, aby <span class="grad">my</span> sa pozreli na váš účet?
                </h3>
                <p style="font-size: 13px; line-height: 1.55; color: rgba(255,255,255,0.7); margin-bottom: 20px;">
                  30-minútový audit Google Ads / Meta Ads / merania. Zadarmo, bez záväzku.
                </p>
                <a href={buildUrl(lang, '/kontakt')} class="sidebar-cta-btn">
                  Vyžiadať audit
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M7 17 17 7"></path>
                    <path d="M7 7h10v10"></path>
                  </svg>
                </a>
              </div>
            </div>

            {relatedPosts.length > 0 && (
              <div class="sidebar-card sidebar-related">
                <div class="sidebar-eyebrow">[ Ďalšie články ]</div>
                <ul class="related-list">
                  {relatedPosts.map((rp) => (
                    <li>
                      <a href={buildUrl(lang, `/blog/${rp.slug}`)} class="related-link">
                        <div class="related-thumb" style={`background: ${rp.cover_image_url ? `url('${rp.cover_image_url}') center/cover` : rp.cover_gradient};`}></div>
                        <div class="related-text">
                          <div class="related-cat">{rp.category}</div>
                          <div class="related-title">{rp.title}</div>
                          <div class="related-meta">{formatDateShort(rp.published_at)} · {rp.read_time_min} min</div>
                        </div>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <!-- Share -->
            <div class="sidebar-card sidebar-share">
              <div class="sidebar-eyebrow">[ Zdieľať ]</div>
              <div class="share-buttons">
                <a
                  href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`}
                  target="_blank"
                  rel="noopener"
                  class="share-btn"
                  aria-label="Zdieľať na LinkedIn"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                  <span>LinkedIn</span>
                </a>
                <a
                  href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareTitle}`}
                  target="_blank"
                  rel="noopener"
                  class="share-btn"
                  aria-label="Zdieľať na X"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                  </svg>
                  <span>X / Twitter</span>
                </a>
                <button
                  type="button"
                  class="share-btn"
                  data-copy-url={articleUrl}
                  aria-label="Kopírovať odkaz"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
                    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
                  </svg>
                  <span data-copy-label>Kopírovať odkaz</span>
                </button>
              </div>
            </div>

          </div>
        </aside>
      </div>
    </div>
  </section>


  <!-- ============================================
       LAYOUT STYLES
       ============================================ -->
  <style>
    .blog-detail-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: 56px;
      align-items: flex-start;
    }
    .blog-sidebar {
      position: relative;
    }
    .blog-sidebar-sticky {
      position: sticky;
      top: 100px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .sidebar-card {
      padding: 22px 24px;
      border-radius: 16px;
      background: var(--bg);
      border: 1px solid var(--line);
    }
    .sidebar-eyebrow {
      font-family: var(--mono);
      font-size: 10px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 14px;
    }

    /* ToC */
    .sidebar-toc { max-height: 360px; overflow-y: auto; }
    .toc-list { list-style: none; padding: 0; margin: 0; }
    .toc-item { margin: 0; }
    .toc-item a {
      display: block;
      padding: 7px 0;
      font-size: 13px;
      line-height: 1.4;
      color: var(--muted);
      text-decoration: none;
      border-left: 2px solid transparent;
      padding-left: 12px;
      margin-left: -12px;
      transition: color 0.15s, border-color 0.15s;
    }
    .toc-item a:hover { color: var(--ink); border-left-color: var(--line); }
    .toc-item.toc-active a {
      color: var(--grad-start);
      border-left-color: var(--grad-start);
      font-weight: 600;
    }
    .toc-item.toc-level-3 a { padding-left: 24px; font-size: 12px; }

    /* CTA */
    .sidebar-cta {
      background: var(--ink);
      color: var(--bg);
      border: none;
      position: relative;
      overflow: hidden;
    }
    .sidebar-cta-orb {
      position: absolute;
      top: -40px; right: -40px;
      width: 160px; height: 160px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(241, 100, 52, 0.4), transparent 65%);
      pointer-events: none;
    }
    .sidebar-cta-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 10px 16px;
      border-radius: 999px;
      background: linear-gradient(135deg, var(--grad-start), var(--grad-end));
      color: white;
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
      transition: transform 0.15s;
    }
    .sidebar-cta-btn:hover { transform: translateX(2px); }

    /* Súvisiace */
    .related-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 16px; }
    .related-link {
      display: grid;
      grid-template-columns: 64px 1fr;
      gap: 12px;
      color: var(--ink);
      text-decoration: none;
      align-items: center;
    }
    .related-thumb {
      width: 64px;
      height: 64px;
      border-radius: 10px;
      flex-shrink: 0;
    }
    .related-text { min-width: 0; }
    .related-cat {
      font-family: var(--mono);
      font-size: 9px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--grad-start);
      margin-bottom: 4px;
    }
    .related-title {
      font-size: 13px;
      font-weight: 600;
      line-height: 1.35;
      color: var(--ink);
      margin-bottom: 4px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .related-link:hover .related-title { color: var(--grad-start); }
    .related-meta { font-family: var(--mono); font-size: 10px; color: var(--muted); }

    /* Share */
    .share-buttons { display: flex; flex-direction: column; gap: 8px; }
    .share-btn {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 9px 14px;
      border-radius: 999px;
      background: var(--bg-soft);
      border: 1px solid var(--line);
      color: var(--ink);
      font-size: 13px;
      font-weight: 500;
      text-decoration: none;
      cursor: pointer;
      transition: background 0.15s, border-color 0.15s;
      font-family: inherit;
    }
    .share-btn:hover { background: var(--bg); border-color: var(--ink); }
    .share-btn svg { flex-shrink: 0; opacity: 0.65; }
    .share-btn:hover svg { opacity: 1; }

    /* MOBILE — sidebar pod článkom */
    @media (max-width: 1024px) {
      .blog-detail-grid {
        grid-template-columns: 1fr;
        gap: 48px;
      }
      .blog-sidebar-sticky {
        position: static;
        flex-direction: column;
        gap: 16px;
      }
      .sidebar-toc { max-height: none; }
    }
  </style>


  <!-- ============================================
       PROSE STYLES (markdown content)
       ============================================ -->
  <style is:global>
    .prose {
      font-size: 17px;
      line-height: 1.7;
      color: var(--ink);
    }
    .prose h2 {
      font-size: 28px;
      font-weight: 700;
      letter-spacing: -0.025em;
      line-height: 1.25;
      margin: 48px 0 16px;
      scroll-margin-top: 100px;
    }
    .prose h3 {
      font-size: 22px;
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.3;
      margin: 32px 0 12px;
      scroll-margin-top: 100px;
    }
    .prose p { margin-bottom: 20px; }
    .prose strong { font-weight: 600; }
    .prose ul, .prose ol {
      margin: 16px 0 24px;
      padding-left: 24px;
    }
    .prose li { margin-bottom: 8px; line-height: 1.6; }
    .prose code {
      background: var(--bg-soft);
      padding: 2px 8px;
      border-radius: 6px;
      font-family: var(--mono);
      font-size: 14px;
      color: var(--grad-start);
    }
    .prose pre {
      background: var(--ink);
      color: var(--bg);
      padding: 18px 22px;
      border-radius: 12px;
      overflow-x: auto;
      margin-bottom: 24px;
      font-family: var(--mono);
      font-size: 14px;
      line-height: 1.6;
    }
    .prose pre code { background: transparent; padding: 0; color: inherit; }
    .prose blockquote {
      border-left: 4px solid var(--grad-start);
      padding-left: 24px;
      margin: 32px 0;
      font-style: italic;
      color: var(--muted);
    }
    .prose a {
      color: var(--grad-start);
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
    }
    .prose a:hover { color: var(--grad-end); }
    .prose hr {
      border: 0;
      border-top: 1px solid var(--line);
      margin: 48px 0;
    }
  </style>


  <!-- ============================================
       TOC SCROLL SPY + COPY URL
       ============================================ -->
  <script is:inline>
    (function () {
      const tocItems = document.querySelectorAll('.toc-item');
      if (!tocItems.length) return;

      const ids = Array.from(tocItems).map((el) => el.dataset.tocId).filter(Boolean);
      const headings = ids.map((id) => document.getElementById(id)).filter(Boolean);
      if (!headings.length) return;

      const setActive = (activeId) => {
        tocItems.forEach((item) => {
          item.classList.toggle('toc-active', item.dataset.tocId === activeId);
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          if (visible.length > 0) {
            setActive(visible[0].target.id);
          }
        },
        { rootMargin: '-100px 0px -70% 0px', threshold: 0 }
      );

      headings.forEach((h) => observer.observe(h));
    })();

    // Copy URL button
    (function () {
      const btns = document.querySelectorAll('[data-copy-url]');
      btns.forEach((btn) => {
        btn.addEventListener('click', async () => {
          const url = btn.dataset.copyUrl;
          const label = btn.querySelector('[data-copy-label]');
          if (!url) return;
          try {
            await navigator.clipboard.writeText(url);
            if (label) {
              const orig = label.textContent;
              label.textContent = '✓ Skopírované!';
              setTimeout(() => { label.textContent = orig; }, 2000);
            }
          } catch (e) {
            console.error('Copy failed', e);
          }
        });
      });
    })();
  </script>


  <ContactSection accent="call" />

</Layout>
