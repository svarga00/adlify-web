  <script>
    // === SECTION 5 — Pred a po (BEFORE/AFTER slider) je v /js/adlify-app.js ===
    // === SECTION 7 — Services accordion je v /js/adlify-app.js ===

    // === SECTION 9 — Calculator ===
    (function () {
      const sBudget = document.getElementById('calc-budget');
      const sAov    = document.getElementById('calc-aov');
      const sCr     = document.getElementById('calc-cr');
      if (!sBudget || !sAov || !sCr) return;

      const vBudget = document.querySelector('[data-calc-budget-val]');
      const vAov    = document.querySelector('[data-calc-aov-val]');
      const vCr     = document.querySelector('[data-calc-cr-val]');
      const oRev    = document.querySelector('[data-calc-revenue]');
      const oUplift = document.querySelector('[data-calc-uplift]');
      const oOrders = document.querySelector('[data-calc-orders]');

      const CPC = 0.55; // priemerná cena za klik
      const ORG_BASELINE = 5000; // odhad organického baseline pre uplift %

      const fmtEur = (n) => '€' + Math.round(n).toLocaleString('sk-SK').replace(/\s/g, '\u00A0');

      function paintTrack(el) {
        const min = parseFloat(el.min);
        const max = parseFloat(el.max);
        const val = parseFloat(el.value);
        const pct = ((val - min) / (max - min)) * 100;
        el.style.background = `linear-gradient(90deg, var(--grad-start) 0%, var(--grad-end) ${pct}%, var(--bg-mid) ${pct}%)`;
      }

      function recalc() {
        const budget = parseFloat(sBudget.value);
        const aov    = parseFloat(sAov.value);
        const crPct  = parseFloat(sCr.value);
        const cr     = crPct / 100;

        // Vzorec: kliky = budget / CPC, objednávky = kliky × CR, tržby = obj × AOV
        const clicks  = budget / CPC;
        const orders  = clicks * cr;
        const revenue = orders * aov;
        const uplift  = (revenue / ORG_BASELINE - 1) * 100;

        if (vBudget) vBudget.textContent = fmtEur(budget);
        if (vAov)    vAov.textContent    = fmtEur(aov);
        if (vCr)     vCr.textContent     = crPct.toFixed(1) + '%';
        if (oRev)    oRev.textContent    = fmtEur(revenue);
        if (oUplift) oUplift.textContent = (uplift >= 0 ? '+' : '') + Math.round(uplift) + '%';
        if (oOrders) oOrders.textContent = Math.round(orders).toLocaleString('sk-SK');

        paintTrack(sBudget);
        paintTrack(sAov);
        paintTrack(sCr);
      }

      [sBudget, sAov, sCr].forEach((el) => el.addEventListener('input', recalc));
      recalc();
    })();
  </script>

