        <a href="#formular" class="btn btn-grad" style="padding: 16px 28px; font-size: 16px;">
          Chcem audit zadarmo
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-left: 6px;" aria-hidden="true">
            <path d="M7 17 17 7"></path>
            <path d="M7 7h10v10"></path>
          </svg>
        </a>
        <span style="font-family: var(--mono); font-size: 12px; color: var(--muted);">
