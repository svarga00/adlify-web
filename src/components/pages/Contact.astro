            <!-- Ulice — vedľajšie -->
            <g stroke="#252528" stroke-width="6" stroke-linecap="round" fill="none">
              <path d="M 0 250 L 600 250" />
              <path d="M 0 350 L 600 350" />
              <path d="M 130 0 L 130 400" />
              <path d="M 330 0 L 330 400" />
              <path d="M 430 0 L 430 400" />
              <path d="M 510 100 L 510 400" />
            </g>

            <!-- Ulice — najmenšie spojnice -->
            <g stroke="#1f1f22" stroke-width="2.5" stroke-linecap="round" fill="none" opacity="0.7">
              <path d="M 60 100 L 540 100" />
              <path d="M 60 220 L 540 220" />
              <path d="M 60 310 L 540 310" />
              <path d="M 80 0 L 80 400" />
              <path d="M 180 0 L 180 400" />
              <path d="M 280 0 L 280 400" />
              <path d="M 380 0 L 380 400" />
              <path d="M 480 0 L 480 400" />
            </g>

            <!-- Stredové dlaždice osvetlené (centrum) -->
            <g fill="#262629" opacity="0.85">
              <rect x="240" y="160" width="70" height="70" rx="2" />
              <rect x="240" y="280" width="90" height="50" rx="2" />
            </g>

            <!-- Pin glow -->
            <circle cx="285" cy="200" r="120" fill="url(#pinGlow)" />

            <!-- Pin pulzy -->
            <circle cx="285" cy="200" r="40" fill="none" stroke="#F16434" stroke-width="1" opacity="0.55">
              <animate attributeName="r" from="40" to="80" dur="3s" repeatCount="indefinite" />
              <animate attributeName="opacity" from="0.55" to="0" dur="3s" repeatCount="indefinite" />
            </circle>
            <circle cx="285" cy="200" r="35" fill="none" stroke="#F16434" stroke-width="1" opacity="0.7">
              <animate attributeName="r" from="35" to="70" dur="3s" begin="1s" repeatCount="indefinite" />
              <animate attributeName="opacity" from="0.7" to="0" dur="3s" begin="1s" repeatCount="indefinite" />
            </circle>

            <!-- Pin shadow -->
            <ellipse cx="285" cy="218" rx="14" ry="3" fill="#000" opacity="0.4" />

            <!-- Pin -->
            <g transform="translate(285, 200)">
              <circle r="22" fill="url(#pinGrad)" />
              <polygon points="0,28 -6,18 6,18" fill="#E85D9C" />
              <path d="M 0 -12 L 3.5 -3 L 13 -2 L 5.5 4.5 L 8 14 L 0 9 L -8 14 L -5.5 4.5 L -13 -2 L -3.5 -3 Z" fill="white" transform="scale(0.55)" />
