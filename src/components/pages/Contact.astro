            )}
            {billingAddress && (
              <div>
                <div class="eyebrow" style="margin-bottom: 6px;">Sídlo firmy</div>
                <div style="font-size: 16px; font-weight: 500; line-height: 1.45;">{billingAddress}</div>
              </div>
            )}
            {company.ico && (
              <div>
                <div class="eyebrow" style="margin-bottom: 6px;">IČO</div>
                <div style="font-size: 16px; font-weight: 500; font-family: var(--mono);">{company.ico}</div>
              </div>
            )}
            {company.dic && (
              <div>
                <div class="eyebrow" style="margin-bottom: 6px;">DIČ</div>
