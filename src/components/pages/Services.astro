---
/**
 * /sluzby — Naše služby
 *
 * Štruktúra: 5 kategórií, 14 služieb. Sticky kategória menu vľavo,
 * obsah vpravo. Funguje aj bez DB — služby sú hardcoded.
 *
 * Pre každú službu:
 *  - title, desc (krátky popis)
 *  - bullets (čo presne robíme)
 *  - icon (SVG path content)
 */

import Layout from '../../layouts/Layout.astro';
import PageHero from '../PageHero.astro';
import ContactSection from '../ContactSection.astro';
import { fetchAllCases, fetchTestimonials, fetchFaq } from '../../lib/content';
import { industries } from '../../lib/industries';
import { SERVICE_DETAIL_SLUGS } from '../../data/serviceDetails';
import { buildUrl, type Lang } from '../../lib/i18n';
import { pageMeta } from '../../lib/pageMeta';
import { t } from '../../lib/translations';

interface Props {
  lang?: Lang;
}
const { lang = 'sk' } = Astro.props;
const meta = pageMeta.services[lang];

// Cases / testimonials / FAQ pre dolné sekcie (DB)
const [cases, testimonials, faqs] = await Promise.all([
  fetchAllCases(lang),
  fetchTestimonials(lang, 3),
  fetchFaq(lang, 6),
]);

