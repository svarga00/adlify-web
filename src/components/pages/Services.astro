  </style>

  <!-- Scrollspy: označí aktívnu kategóriu v sidebar pri scrolle -->
  <script is:inline>
    (function () {
      const sections = document.querySelectorAll('[data-cat]');
      const links = document.querySelectorAll('[data-cat-link]');
      if (!sections.length || !links.length) return;

      function setActive(slug) {
        links.forEach((l) => l.classList.toggle('active', l.dataset.catLink === slug));
      }

      // Highlight first by default
      setActive(sections[0].dataset.cat || null);

      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            // Find topmost intersecting section
            let topMost: IntersectionObserverEntry | null = null;
            for (const e of entries) {
              if (e.isIntersecting) {
                if (!topMost || e.boundingClientRect.top < topMost.boundingClientRect.top) {
                  topMost = e;
                }
              }
            }
            if (topMost) {
              const slug = (topMost.target).dataset.cat;
              if (slug) setActive(slug);
            }
          },
          { rootMargin: '-100px 0px -60% 0px', threshold: 0 }
        );
        sections.forEach((s) => io.observe(s));
      }
    })();
  </script>

</Layout>
