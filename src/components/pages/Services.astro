// Flat zoznam pre stranny indexer / sitemap
const allServices = categories.flatMap((c) => c.services.map((s) => ({ ...s, categorySlug: c.slug })));
---

<Layout
  title={meta.title}
  description={meta.description}
  lang={lang}
  pathname="/sluzby"
>

  <PageHero
    num={meta.hero!.num}
    kind={meta.hero!.kind}
    title={meta.hero!.title}
    titleAccent={meta.hero!.titleAccent}
    lead={meta.hero!.lead}
  />


  <!-- ============================================
       INTRO box
       ============================================ -->
  <section class="section" style="padding-top: 0; padding-bottom: clamp(24px, 3vw, 48px);">
    <div class="container" style="max-width: 880px;">
      <div style="background: var(--bg-soft); border-left: 3px solid var(--grad-start); padding: 24px 28px; border-radius: 12px;">
        <p style="font-size: 16px; line-height: 1.7; margin: 0; color: var(--ink-2);">
          <strong>Nezačíname výberom kanálu.</strong> Začíname tým, čo váš biznis potrebuje — viac
          objednávok, viac dopytov, lepšiu cenu za zákazníka. A potom vyberáme, ktorá služba (alebo
          ich kombinácia) na to sedí najlepšie. Nasleduje 5 oblastí, v ktorých vám vieme pomôcť.
        </p>
      </div>
    </div>
  </section>


  <!-- ============================================
       KATEGÓRIE + SLUŽBY (sticky sidebar layout)
       ============================================ -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div class="svc-layout-v2">

        <!-- LEFT: Sticky kategória menu -->
        <aside class="svc-cats-nav">
          <div class="eyebrow" style="margin-bottom: 20px;">[ 5 oblastí ]</div>
          <ul class="svc-cats-list">
            {categories.map((cat, i) => (
              <li>
                <a href={`#${cat.slug}`} class="svc-cat-link" data-cat-link={cat.slug}>
                  <span class="svc-cat-num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="svc-cat-text">
                    <span class="svc-cat-title">{cat.title}</span>
                    <span class="svc-cat-count">{cat.services.length} {cat.services.length === 1 ? 'služba' : (cat.services.length < 5 ? 'služby' : 'služieb')}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </aside>

        <!-- RIGHT: Kategórie obsah -->
        <div class="svc-cats-content">
          {categories.map((cat, ci) => (
            <section id={cat.slug} class="svc-category" data-cat={cat.slug}>
              <!-- Header kategórie -->
              <header class="svc-category-head">
                <div class="eyebrow" style="margin-bottom: 12px;">[ {String(ci + 1).padStart(2, '0')} — {cat.title.toUpperCase()} ]</div>
                <h2 class="h2" style="margin-bottom: 12px; max-width: 22ch;">{cat.title}</h2>
                <p class="lead" style="font-size: 16px; max-width: 60ch; margin-bottom: 32px;">{cat.desc}</p>
              </header>

              <!-- Služby tejto kategórie -->
              <div class="svc-cards">
                {cat.services.map((s) => (
                  <article class="svc-card">
                    <div class="svc-card-head">
                      <div class="svc-card-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} aria-hidden="true"></svg>
                      </div>
                      <div class="svc-card-title-wrap">
                        <h3 class="svc-card-title">{s.title}</h3>
                        <p class="svc-card-desc">{s.desc}</p>
                      </div>
                    </div>

                    {s.bullets && (
                      <ul class="svc-card-bullets">
                        {s.bullets.map((b) => (
                          <li>
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="rgb(34,197,94)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            <span>{b}</span>
                          </li>
                        ))}
                      </ul>
                    )}

                    {SERVICE_DETAIL_SLUGS.includes(s.slug) && (
                      <a href={buildUrl(lang, `/sluzby/${s.slug}`)} class="svc-card-link">
                        Detail služby
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M7 17 17 7"></path>
                          <path d="M7 7h10v10"></path>
                        </svg>
                      </a>
                    )}
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>
    </div>
  </section>


  <!-- ============================================
       VYBRANÉ PRÍPADOVÉ ŠTÚDIE
       ============================================ -->
  {cases.length > 0 && (
    <section class="section" style="background: var(--bg-soft);">
      <div class="container">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
          <span class="eyebrow">[ Výsledky ]</span>
          <span style="flex: 1; height: 1px; background: var(--line);"></span>
        </div>
        <div class="sec-head">
          <h2 class="h1" style="max-width: 14ch;">Tu sú výsledky.</h2>
          <p class="lead">Nepredávame sľuby. Predávame čísla, ktoré hovoria samé za seba.</p>
        </div>

        <div class="cases-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 48px;">
          {cases.slice(0, 3).map((c) => (
            <a href={buildUrl(lang, `/pripadove-studie/${c.slug}`)} class="case-card" style="background: var(--bg); border: 1px solid var(--line); border-radius: 20px; padding: 28px; transition: border-color 0.2s, transform 0.2s; color: var(--ink); display: flex; flex-direction: column;">
              {c.category && (
                <div class="eyebrow" style="margin-bottom: 16px; font-size: 10px;">{c.category}</div>
              )}
              <h3 style="font-size: 22px; font-weight: 600; letter-spacing: -0.015em; line-height: 1.2; margin-bottom: 12px;">{c.name}</h3>
              <p style="font-size: 14px; color: var(--muted); line-height: 1.5; margin-bottom: 24px; flex: 1;">{c.summary}</p>

              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding-top: 20px; border-top: 1px solid var(--line);">
                {c.metric_a_value && (
                  <div>
                    <div class="num grad" style="font-size: 26px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.1;">{c.metric_a_value}</div>
                    <div style="font-size: 11px; color: var(--muted); margin-top: 4px;">{c.metric_a_label}</div>
                  </div>
                )}
                {c.metric_b_value && (
                  <div>
                    <div class="num grad" style="font-size: 26px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.1;">{c.metric_b_value}</div>
                    <div style="font-size: 11px; color: var(--muted); margin-top: 4px;">{c.metric_b_label}</div>
                  </div>
                )}
              </div>
            </a>
          ))}
        </div>

        <div style="text-align: center; margin-top: 48px;">
          <a href={buildUrl(lang, '/pripadove-studie')} class="btn btn-ink">
            Všetky prípadové štúdie
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>

      <style>
        .case-card:hover { border-color: var(--ink) !important; transform: translateY(-4px); }
        @media (max-width: 1024px) { .cases-grid { grid-template-columns: 1fr 1fr !important; } }
        @media (max-width: 640px)  { .cases-grid { grid-template-columns: 1fr !important; } }
      </style>
    </section>
  )}


  <!-- ============================================
       BALÍČKY PRE ODVETVIA
       ============================================ -->
  <section id="odvetvia" class="section" style="scroll-margin-top: 80px;">
    <div class="container">
      <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
        <span class="eyebrow">[ Balíčky pre odvetvia ]</span>
        <span style="flex: 1; height: 1px; background: var(--line);"></span>
      </div>
      <div class="sec-head">
        <h2 class="h1" style="max-width: 18ch;">Pre vaše <span class="grad">odvetvie.</span></h2>
        <p class="lead">Zostavili sme hotové balíky pre 6 najčastejších typov podnikov. Predvídate, čo dostanete a koľko zaplatíte.</p>
      </div>

      <!-- Intro box -->
      <div style="background: var(--bg-soft); border-left: 3px solid var(--grad-start); padding: 20px 24px; border-radius: 12px; margin-top: 32px; max-width: 920px;">
        <p style="font-size: 15px; line-height: 1.65; margin: 0; color: var(--ink-2);">
          <strong>Prečo balíky pre odvetvia?</strong> Lebo kaderníctvo, autoservis a B2B kovovýroba potrebujú úplne iné nástroje.
          Hotový balík vám ušetrí čas — viete, čo dostanete, predtým ako sa vôbec spojíme. A balíky sú flexibilné, vždy ich prispôsobíme vašej situácii.
        </p>
      </div>

      <div class="industries-grid" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-top: 40px;">
        {industries.map((p, i) => (
          <a href={buildUrl(lang, `/odvetvia/${p.slug}`)} class="industry-card-big">
            <!-- Header row -->
            <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 14px;">
              <div>
                <div class="eyebrow" style="margin-bottom: 8px; font-size: 10px;">[ Balíček {String(i + 1).padStart(2, '0')} ]</div>
                <h3 style="font-size: clamp(20px, 2.2vw, 24px); font-weight: 700; letter-spacing: -0.02em; line-height: 1.15; margin: 0;">{p.name}</h3>
              </div>
              <div class="industry-card-arrow">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 17 17 7"></path>
                  <path d="M7 7h10v10"></path>
                </svg>
              </div>
            </div>

            <!-- Tagline -->
