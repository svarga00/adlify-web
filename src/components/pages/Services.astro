    }
    .svc-cat-text { display: flex; flex-direction: column; gap: 2px; }
    .svc-cat-title { font-size: 15px; font-weight: 600; line-height: 1.3; }
    .svc-cat-count { font-size: 11px; color: var(--muted); }

    .svc-cats-content { display: flex; flex-direction: column; gap: 80px; }
    .svc-category { scroll-margin-top: 80px; }
    .svc-category-head { padding-bottom: 24px; border-bottom: 1px solid var(--line); }

    .svc-cards { display: flex; flex-direction: column; gap: 16px; margin-top: 32px; }
    .svc-card {
      background: var(--bg);
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 28px 32px;
      transition: border-color 0.15s, transform 0.15s;
    }
    .svc-card:hover { border-color: var(--ink-2); }

    .svc-card-head { display: flex; align-items: flex-start; gap: 20px; margin-bottom: 16px; }
    .svc-card-icon {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--grad-start), var(--grad-end));
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .svc-card-title-wrap { flex: 1; }
    .svc-card-title { font-size: 19px; font-weight: 700; letter-spacing: -0.015em; margin: 0 0 6px 0; }
    .svc-card-desc { font-size: 14px; color: var(--muted); line-height: 1.55; margin: 0; }

    .svc-card-bullets { list-style: none; padding: 0; margin: 16px 0 0 0; display: grid; grid-template-columns: 1fr 1fr; gap: 8px 24px; padding-left: 68px; }
    .svc-card-bullets li { display: flex; align-items: flex-start; gap: 8px; font-size: 13px; line-height: 1.45; color: var(--ink-2); }
    .svc-card-link {
