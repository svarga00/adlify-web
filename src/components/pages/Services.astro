        <h2 class="h1" style="max-width: 16ch; margin-bottom: 56px;">Čo o nás hovoria.</h2>

        <div class="testim-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;">
          {testimonials.map((t) => (
            <div style="background: var(--bg); border: 1px solid var(--line); border-radius: 20px; padding: 32px; display: flex; flex-direction: column;">
