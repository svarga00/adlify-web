---
/**
 * /sluzby/[slug] — Detail stránka pre jednu službu
 *
 * Načíta dáta zo serviceDetails.ts + related case studies z Supabase.
 * Štruktúra: Hero → Specs → Process → ČoDostaneš → Pre koho → Cena → FAQ → Related cases → CTA
 */

import Layout from '../../layouts/Layout.astro';
import ContactSection from '../ContactSection.astro';
import { buildUrl, type Lang } from '../../lib/i18n';
import { fetchAllCases } from '../../lib/content';
import type { ServiceDetail } from '../../data/serviceDetails';
import { svcT } from '../../data/serviceDetails';
import { t } from '../../lib/translations';

interface Props {
  service: ServiceDetail;
  lang?: Lang;
}
const { service, lang = 'sk' } = Astro.props;

// Načítaj related case studies z DB
const allCases = await fetchAllCases(lang);
const relatedCases = service.relatedCases
  ? allCases.filter((c) => service.relatedCases!.includes(c.slug)).slice(0, 2)
  : [];
---

<Layout
  title={svcT(service.seoTitle, lang) || `${service.title} — Adlify`}
  description={svcT(service.seoDescription, lang) || svcT(service.tagline, lang)}
  lang={lang}
  pathname={`/sluzby/${service.slug}`}
>

  <!-- ============================================
       HERO
       ============================================ -->
  <section class="section" style="padding-top: clamp(60px, 8vw, 120px); padding-bottom: clamp(40px, 5vw, 64px);">
    <div class="container">
      <!-- Breadcrumb -->
      <nav style="display: flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: 12px; color: var(--muted); margin-bottom: 32px;" aria-label="Breadcrumb">
        <a href={buildUrl(lang, '/sluzby')} style="color: var(--muted); text-decoration: none;">{t('serviceDetail.crumbServices', lang)}</a>
        <span style="opacity: 0.4;">/</span>
        <a href={buildUrl(lang, `/sluzby#${service.categorySlug}`)} style="color: var(--muted); text-decoration: none;">{svcT(service.category, lang).toUpperCase()}</a>
        <span style="opacity: 0.4;">/</span>
        <span style="color: var(--grad-start);">{service.title.toUpperCase()}</span>
      </nav>

      <div style="display: grid; grid-template-columns: 1.3fr 1fr; gap: 64px; align-items: end;" class="svc-hero-grid">
        <div>
          <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 24px;">
            <div style="width: 56px; height: 56px; border-radius: 14px; background: linear-gradient(135deg, var(--grad-start), var(--grad-end)); color: white; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={service.icon} aria-hidden="true"></svg>
            </div>
            <div class="eyebrow">{t('serviceDetail.eyebrowPrefix', lang)} · {svcT(service.category, lang)} ]</div>
          </div>

          <h1 style="font-size: clamp(40px, 6vw, 84px); font-weight: 700; letter-spacing: -0.04em; line-height: 1.02; margin-bottom: 20px;">
            {service.title}
          </h1>
          <p style="font-size: clamp(18px, 1.5vw, 22px); font-weight: 500; line-height: 1.4; max-width: 26ch; color: var(--ink-2);">
            <span class="grad">{svcT(service.tagline, lang)}</span>
          </p>
        </div>

        <div>
          <p class="body" style="font-size: 16px; line-height: 1.7;">
            {svcT(service.lead, lang)}
          </p>
          <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px;">
            <a href={`${buildUrl(lang, '/kontakt')}#formular`} class="btn btn-grad">
              {t('serviceDetail.heroCta', lang)}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-left: 6px;" aria-hidden="true">
                <path d="M7 17 17 7"></path><path d="M7 7h10v10"></path>
              </svg>
            </a>
            <a href={buildUrl(lang, '/cennik')} class="btn btn-outline">{t('serviceDetail.heroCtaSecondary', lang)}</a>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ============================================
       SPECS — 4 metriky setupu
       ============================================ -->
  <section style="padding-bottom: clamp(48px, 6vw, 80px);">
    <div class="container">
      <div class="svc-specs" style="display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);">
        {service.specs.map((spec, i) => (
          <div style={`padding: 28px 24px; ${i < service.specs.length - 1 ? 'border-right: 1px solid var(--line);' : ''}`}>
            <div class="eyebrow" style="font-size: 10px; margin-bottom: 8px;">{svcT(spec.label, lang)}</div>
            <div style="font-size: 20px; font-weight: 600; letter-spacing: -0.01em;">{svcT(spec.value, lang)}</div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ============================================
       POSTUP — ako pracujeme
       ============================================ -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 40px;">
        <span class="eyebrow">{t('serviceDetail.processEyebrow', lang)}</span>
        <span style="flex: 1; height: 1px; background: var(--line);"></span>
      </div>
      <div class="sec-head" style="margin-bottom: 48px;">
        <h2 class="h2" style="max-width: 18ch;">{t('serviceDetail.processTitle', lang)}</h2>
        <p class="lead">{t('serviceDetail.processLead', lang)}</p>
      </div>

      <div class="svc-process-grid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 0;">
        {service.process.map((step, i) => (
          <div style={`padding: 32px 28px 32px 0; position: relative; ${i < service.process.length - 1 ? 'border-right: 1px solid var(--line);' : ''}`}>
            {i < service.process.length - 1 && (
              <div style="position: absolute; right: -8px; top: 36px; width: 16px; height: 16px; border-right: 1px solid var(--line); border-top: 1px solid var(--line); transform: rotate(45deg); background: var(--bg);"></div>
            )}
            <div style="display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 50%; background: var(--ink); color: var(--bg); font-family: var(--mono); font-size: 13px; font-weight: 700; margin-bottom: 18px;">
              {String(step.num).padStart(2, '0')}
            </div>
            <h3 style="font-size: 18px; font-weight: 600; letter-spacing: -0.015em; margin-bottom: 10px; padding-right: 16px;">{svcT(step.title, lang)}</h3>
            <p class="body" style="font-size: 14px; line-height: 1.6; padding-right: 16px;">{svcT(step.desc, lang)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ============================================
       ČO DOSTANEŠ — bullets list
       ============================================ -->
  <section class="section" style="background: var(--bg-soft);">
    <div class="container">
      <div style="display: grid; grid-template-columns: 1fr 1.3fr; gap: 64px;" class="svc-what-grid">
        <div>
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
            <span class="eyebrow">{t('serviceDetail.whatEyebrow', lang)}</span>
            <span style="flex: 1; height: 1px; background: var(--line);"></span>
          </div>
          <h2 class="h2" style="max-width: 18ch; margin-bottom: 20px;">{t('serviceDetail.whatTitle', lang)}</h2>
          <p class="body" style="font-size: 16px; line-height: 1.65; max-width: 38ch;">
            {t('serviceDetail.whatLead', lang)}
          </p>
        </div>

        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0; border-top: 1px solid var(--line);">
          {service.whatYouGet.map((item) => (
            <li style="display: flex; align-items: flex-start; gap: 16px; padding: 18px 0; border-bottom: 1px solid var(--line);">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="rgb(34,197,94)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 2px;" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span style="font-size: 15px; line-height: 1.55;">{svcT(item, lang)}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>


  <!-- ============================================
       PRE KOHO + CENA — split layout
       ============================================ -->
  <section class="section">
    <div class="container">
      <div class="svc-pricewhom-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 32px;">

        <!-- Pre koho -->
        <div>
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
            <span class="eyebrow">{t('serviceDetail.forWhomEyebrow', lang)}</span>
            <span style="flex: 1; height: 1px; background: var(--line);"></span>
          </div>
          <h3 style="font-size: 24px; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 24px;">{t('serviceDetail.forWhomTitle', lang)}</h3>
          <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 16px;">
            {service.forWhom.map((item) => (
              <li style="display: flex; align-items: flex-start; gap: 14px;">
                <span style="flex-shrink: 0; width: 6px; height: 6px; border-radius: 50%; background: linear-gradient(135deg, var(--grad-start), var(--grad-end)); margin-top: 9px;"></span>
                <span style="font-size: 15px; line-height: 1.6;">{svcT(item, lang)}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Cena -->
        <div style="background: var(--ink); color: var(--bg); border-radius: 24px; padding: 36px; display: flex; flex-direction: column; justify-content: space-between; position: relative; overflow: hidden;">
          <div aria-hidden="true" style="position: absolute; inset: -20%; background: radial-gradient(circle at 80% 20%, color-mix(in srgb, var(--grad-start) 28%, transparent), transparent 50%); pointer-events: none;"></div>
          <div style="position: relative;">
            <div class="eyebrow" style="color: rgba(255,255,255,0.55); margin-bottom: 16px;">{t('serviceDetail.priceEyebrow', lang)}</div>
            <div style="font-size: 36px; font-weight: 700; letter-spacing: -0.025em; line-height: 1.05; margin-bottom: 12px;" class="grad">
              {svcT(service.priceFrom, lang)}
            </div>
            {svcT(service.priceNote, lang) && (
              <p style="font-size: 14px; line-height: 1.6; color: rgba(255,255,255,0.7); max-width: 36ch;">
                {svcT(service.priceNote, lang)}
              </p>
            )}
          </div>
          <div style="position: relative; margin-top: 32px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,0.12); display: flex; gap: 12px; flex-wrap: wrap;">
            <a href={buildUrl(lang, '/cennik')} style="display: inline-flex; align-items: center; gap: 6px; padding: 10px 18px; border-radius: 999px; background: var(--bg); color: var(--ink); font-size: 14px; font-weight: 600; text-decoration: none;">
              {t('serviceDetail.priceCtaPrimary', lang)}
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 17 17 7"></path><path d="M7 7h10v10"></path>
              </svg>
            </a>
            <a href={`${buildUrl(lang, '/kontakt')}#formular`} style="display: inline-flex; align-items: center; gap: 6px; padding: 10px 18px; border-radius: 999px; border: 1px solid rgba(255,255,255,0.25); color: var(--bg); font-size: 14px; font-weight: 600; text-decoration: none;">
              {t('serviceDetail.priceCtaSecondary', lang)}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- ============================================
       MINI FAQ
       ============================================ -->
  <section class="section" style="background: var(--bg-soft);">
    <div class="container" style="max-width: 860px;">
      <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
        <span class="eyebrow">{t('serviceDetail.faqEyebrow', lang)}</span>
        <span style="flex: 1; height: 1px; background: var(--line);"></span>
      </div>
      <h2 class="h2" style="max-width: 18ch; margin-bottom: 40px;">{t('serviceDetail.faqTitlePrefix', lang)} {service.title}.</h2>

      <div style="display: flex; flex-direction: column; border-top: 1px solid var(--line);">
        {service.faq.map((item, i) => (
          <details class="faq-item" style="border-bottom: 1px solid var(--line); padding: 0;" open={i === 0}>
            <summary style="padding: 26px 4px; cursor: pointer; display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; font-size: 17px; font-weight: 600; letter-spacing: -0.015em; line-height: 1.35; list-style: none;">
              <span>{svcT(item.q, lang)}</span>
              <svg class="faq-chev" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 3px; transition: transform 0.25s;" aria-hidden="true">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </summary>
            <div style="padding: 0 56px 26px 4px; font-size: 15px; line-height: 1.65; color: var(--muted);">
              {svcT(item.a, lang)}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>


  <!-- ============================================
       RELATED CASE STUDIES
       ============================================ -->
  {relatedCases.length > 0 && (
    <section class="section">
      <div class="container">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
          <span class="eyebrow">{t('serviceDetail.relatedEyebrow', lang)}</span>
          <span style="flex: 1; height: 1px; background: var(--line);"></span>
        </div>
        <h2 class="h2" style="max-width: 22ch; margin-bottom: 40px;">{t('serviceDetail.relatedTitle', lang)}</h2>

        <div class="svc-cases-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
          {relatedCases.map((c) => (
            <a href={buildUrl(lang, `/pripadove-studie/${c.slug}`)} class="case-card" style="display: block; color: inherit;">
              <div class="case-cover" style={`background: ${c.cover_gradient};`}>
                <div class="case-cover-mesh"></div>
                <div style="position: absolute; top: 24px; left: 24px; color: white;">
                  <div style="font-size: 11px; font-family: var(--mono); letter-spacing: 0.03em; opacity: 0.85; margin-bottom: 6px;">{c.tag}</div>
                  <div style="font-size: 32px; font-weight: 700; letter-spacing: -0.03em;">{c.name}</div>
                </div>
                <div class="case-arrow">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M7 17 17 7"></path>
                    <path d="M7 7h10v10"></path>
                  </svg>
                </div>
              </div>
              <div style="padding-top: 20px;">
                <p class="body" style="font-size: 14px; line-height: 1.55; margin-bottom: 16px;">
                  {c.summary}
                </p>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; padding-top: 16px; border-top: 1px solid var(--line);">
                  <div>
                    <div class="eyebrow" style="font-size: 10px; margin-bottom: 4px;">{c.metric_a_label}</div>
                    <div class="num grad" style="font-size: 24px; font-weight: 700; letter-spacing: -0.02em;">{c.metric_a_value}</div>
                  </div>
                  <div>
                    <div class="eyebrow" style="font-size: 10px; margin-bottom: 4px;">{c.metric_b_label}</div>
                    <div class="num" style="font-size: 24px; font-weight: 700; letter-spacing: -0.02em;">{c.metric_b_value}</div>
                  </div>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}


  <ContactSection accent="audit" lang={lang} />

</Layout>

<style>
  /* Open state chevron rotation */
  details[open] .faq-chev { transform: rotate(180deg); }

  /* Responsive */
  @media (max-width: 1024px) {
    .svc-hero-grid { grid-template-columns: 1fr !important; gap: 40px !important; }
    .svc-process-grid { grid-template-columns: 1fr 1fr !important; }
    .svc-process-grid > div { border-right: none !important; padding-right: 24px !important; }
    .svc-process-grid > div:nth-child(odd) { border-right: 1px solid var(--line) !important; }
    .svc-process-grid > div > div[aria-hidden] { display: none; }
    .svc-what-grid { grid-template-columns: 1fr !important; gap: 40px !important; }
    .svc-pricewhom-grid { grid-template-columns: 1fr !important; }
    .svc-cases-grid { grid-template-columns: 1fr !important; }
    .svc-specs { grid-template-columns: repeat(2, 1fr) !important; }
    .svc-specs > div:nth-child(2) { border-right: none !important; }
    .svc-specs > div:nth-child(1), .svc-specs > div:nth-child(2) { border-bottom: 1px solid var(--line); }
  }

  @media (max-width: 640px) {
    .svc-process-grid { grid-template-columns: 1fr !important; }
    .svc-process-grid > div { border-right: none !important; border-bottom: 1px solid var(--line); padding-bottom: 32px; }
    .svc-process-grid > div:last-child { border-bottom: none; }
    .svc-specs { grid-template-columns: 1fr !important; }
    .svc-specs > div { border-right: none !important; border-bottom: 1px solid var(--line); }
    .svc-specs > div:last-child { border-bottom: none; }
  }
</style>
