---
/**
 * /pripadove-studie — Case Studies listing
 *
 * REFACTOROVANÉ: dáta fetchované zo Supabase (web_case_studies).
 * Linky vedú na detail /pripadove-studie/[slug].
 */

import Layout from '../../layouts/Layout.astro';
import PageHero from '../PageHero.astro';
import ContactSection from '../ContactSection.astro';
import { fetchAllCases } from '../../lib/content';
import { pageMeta } from '../../lib/pageMeta';
import type { Lang } from '../../lib/i18n';
import { buildUrl } from '../../lib/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'sk' } = Astro.props;
const meta = pageMeta.cases[lang];

const cases = await fetchAllCases(lang);

// Definícia filter chips — odvodená dynamicky z kategórií čo sú v dátach
const allCategories = ['e-commerce', 'dtc', 'local', 'b2c', 'b2b'];
const usedCategories = Array.from(new Set(cases.map((c) => c.category)));
const visibleCategories = allCategories.filter((c) => usedCategories.includes(c));

const filterLabels: Record<string, string> = {
  'all':         'Všetky',
  'e-commerce':  'E-commerce',
  'dtc':         'DTC',
  'local':       'Local',
  'b2c':         'B2C',
  'b2b':         'B2B',
};
const filters = ['all', ...visibleCategories].map((key) => ({ key, label: filterLabels[key] || key }));
---

<Layout
  title={meta.title}
  description={meta.description}
  lang={lang}
  pathname="/pripadove-studie"
>

  <PageHero
    num={meta.hero!.num}
    kind={meta.hero!.kind}
    title={meta.hero!.title}
    titleAccent={meta.hero!.titleAccent}
    lead={meta.hero!.lead}
  />


  <!-- ============================================
       INTRO — krátky odsek o prípadových štúdiách
       ============================================ -->
  <section class="section" style="padding-top: 0; padding-bottom: clamp(40px, 4vw, 64px);">
    <div class="container" style="max-width: 880px;">
      <div style="background: var(--bg-soft); border-left: 3px solid var(--grad-start); padding: 24px 28px; border-radius: 12px;">
        <p style="font-size: 16px; line-height: 1.7; margin: 0; color: var(--ink-2);">
          <strong>Prečo zverejňujeme reálne čísla?</strong> Lebo veríme, že vidieť konkrétny príklad
          povie viac než desať odhadov a sľubov. Každá štúdia obsahuje konkrétne metriky, obdobie,
          kanály a popis toho, čo sme robili. Mená klientov zverejňujeme len s ich súhlasom.
        </p>
      </div>
    </div>
  </section>


  <section class="section" style="padding-top: 0;">
    <div class="container">

      {cases.length === 0 ? (
        <!-- Fallback — pre návštevníka, nie pre developera -->
        <div style="padding: 64px 32px; text-align: center; background: var(--bg-soft); border: 1px solid var(--line); border-radius: 24px; max-width: 720px; margin: 0 auto;">
          <div style="width: 56px; height: 56px; border-radius: 14px; background: linear-gradient(135deg, var(--grad-start), var(--grad-end)); color: white; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px;">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="2"></rect>
              <path d="M9 9h6v6H9z"></path>
            </svg>
          </div>
          <h3 style="font-size: 22px; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 12px;">
            Pripravujeme prvé verejné štúdie.
          </h3>
          <p style="font-size: 15px; line-height: 1.6; color: var(--muted); max-width: 50ch; margin: 0 auto 24px;">
            Niekoľko klientov je v procese odsúhlasovania zverejnenia výsledkov. Medzitým vám čísla
            radi ukážeme priamo na stretnutí — anonymizované alebo so súhlasom toho-ktorého klienta.
          </p>
          <a href="/kontakt#formular" class="btn btn-ink">
            Spýtať sa na referencie
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
        </div>
      ) : (
        <>
          <!-- Filtre -->
          <div class="filter-bar" style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 48px; padding-bottom: 24px; border-bottom: 1px solid var(--line);">
            {filters.map((f, i) => (
              <button
                class={`cs-chip ${i === 0 ? 'active' : ''}`}
                data-cs-filter={f.key}
                type="button"
                style={`padding: 8px 16px; border-radius: 999px; font-size: 13px; font-weight: 500; border: 1px solid var(--line); background: ${i === 0 ? 'var(--ink)' : 'transparent'}; color: ${i === 0 ? 'var(--bg)' : 'var(--ink)'}; cursor: pointer; transition: all 0.2s;`}
              >
                {f.label}
              </button>
            ))}
          </div>

          <!-- Grid case kariet -->
          <div class="cases-grid">
            {cases.map((c) => (
              <a
                href={buildUrl(lang, `/pripadove-studie/${c.slug}`)}
                class="case-card cs-item"
                data-cs-category={c.category}
                style="display: block; color: inherit;"
              >
                <div class="case-cover" style={`background: ${c.cover_gradient};`}>
                  <div class="case-cover-mesh"></div>
                  <div style="position: absolute; top: 24px; left: 24px; color: white;">
                    <div style="font-size: 11px; font-family: var(--mono); letter-spacing: 0.03em; opacity: 0.85; margin-bottom: 6px;">{c.tag}</div>
                    <div style="font-size: 32px; font-weight: 700; letter-spacing: -0.03em;">{c.name}</div>
                  </div>
                  <div class="case-arrow">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M7 17 17 7"></path>
                      <path d="M7 7h10v10"></path>
                    </svg>
                  </div>
                </div>

                <div style="padding: 24px;">
                  <p class="body" style="font-size: 14px; line-height: 1.55; margin-bottom: 20px; min-height: 3em;">
                    {c.summary}
                  </p>

                  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; padding-top: 20px; border-top: 1px solid var(--line);">
                    <div>
                      <div class="eyebrow" style="font-size: 10px; margin-bottom: 6px;">{c.metric_a_label}</div>
                      <div class="num grad" style="font-size: 28px; font-weight: 700; letter-spacing: -0.02em;">{c.metric_a_value}</div>
                    </div>
                    <div>
                      <div class="eyebrow" style="font-size: 10px; margin-bottom: 6px;">{c.metric_b_label}</div>
                      <div class="num" style="font-size: 28px; font-weight: 700; letter-spacing: -0.02em;">{c.metric_b_value}</div>
                    </div>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </>
      )}
    </div>

    <style>
      .cs-chip:hover:not(.active) { background: var(--bg-soft); }
      .cs-chip.active { background: var(--ink) !important; color: var(--bg) !important; border-color: var(--ink) !important; }
      .cs-item.hidden { display: none !important; }
    </style>
  </section>


  <ContactSection accent="stratégiu" />


  <script is:inline>
    (function () {
      const chips = document.querySelectorAll('.cs-chip');
      const items = document.querySelectorAll('.cs-item');
      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          chips.forEach((c) => c.classList.remove('active'));
          chip.classList.add('active');
          const filter = chip.dataset.csFilter;
          items.forEach((item) => {
            const isMatch = filter === 'all' || item.dataset.csCategory === filter;
            item.classList.toggle('hidden', !isMatch);
          });
        });
      });
    })();
  </script>

</Layout>
