---
/**
 * CaseDetail body — prijíma `caseStudy` a `lang` ako props.
 * Page wrapper zaisťuje getStaticPaths.
 */

import Layout from '../../layouts/Layout.astro';
import ContactSection from '../ContactSection.astro';
import { type CaseStudy } from '../../lib/content';
import { buildUrl, type Lang } from '../../lib/i18n';
import { t } from '../../lib/translations';

interface Props {
  caseStudy: CaseStudy;
  lang?: Lang;
}

const { caseStudy: cs, lang = 'sk' } = Astro.props;

// Helper: split paragraph block na P-tagy
function paragraphs(text: string | undefined) {
  if (!text) return [];
  return text.split(/\n\n+/).map((p) => p.trim()).filter(Boolean);
}
---

<Layout
  title={`${cs.name} — ${t('nav.cases', lang)} | Adlify`}
  description={cs.summary}
  lang={lang}
  pathname={`/pripadove-studie/${cs.slug}`}
>

  <!-- ============================================
       HERO — gradientové pozadie + meta info
       ============================================ -->
  <section style={`background: ${cs.cover_gradient}; padding: clamp(80px, 10vw, 140px) 0 clamp(60px, 8vw, 100px); position: relative; overflow: hidden; color: white;`}>
    <!-- Mesh overlay -->
    <div aria-hidden="true" style="position: absolute; inset: 0; background-image: radial-gradient(circle at 20% 30%, rgba(255,255,255,0.15), transparent 50%), radial-gradient(circle at 80% 70%, rgba(255,255,255,0.1), transparent 55%); pointer-events: none;"></div>

    <div class="container" style="position: relative;">
      <!-- Breadcrumb / back -->
      <a href={buildUrl(lang, '/pripadove-studie')} style="display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; background: rgba(0,0,0,0.25); border: 1px solid rgba(255,255,255,0.18); border-radius: 999px; font-family: var(--mono); font-size: 11px; color: white; margin-bottom: 32px; text-decoration: none;">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        {t('caseDetail.backToAll', lang)}
      </a>

      <!-- Tag -->
      <div style="font-family: var(--mono); font-size: 12px; letter-spacing: 0.05em; opacity: 0.85; margin-bottom: 16px;">{cs.tag}</div>

      <!-- Názov klienta -->
      <h1 style="font-size: clamp(48px, 8vw, 112px); font-weight: 700; letter-spacing: -0.04em; line-height: 0.95; margin-bottom: 24px;">
        {cs.name}
      </h1>

      <!-- Hero subtitle -->
      {cs.hero_subtitle && (
        <p style="font-size: clamp(18px, 1.8vw, 24px); opacity: 0.85; max-width: 60ch; line-height: 1.4; margin-bottom: 48px;">
          {cs.hero_subtitle}
        </p>
      )}

      <!-- Meta grid: Industry, Duration, Budget, Services -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 24px; padding-top: 32px; border-top: 1px solid rgba(255,255,255,0.18);">
        {cs.industry && (
          <div>
            <div class="eyebrow" style="opacity: 0.65; color: white; margin-bottom: 6px;">{t('caseDetail.lblIndustry', lang)}</div>
            <div style="font-size: 15px; font-weight: 600;">{cs.industry}</div>
          </div>
        )}
        {cs.duration && (
          <div>
            <div class="eyebrow" style="opacity: 0.65; color: white; margin-bottom: 6px;">{t('caseDetail.lblDuration', lang)}</div>
            <div style="font-size: 15px; font-weight: 600;">{cs.duration}</div>
          </div>
        )}
        {cs.budget && (
          <div>
            <div class="eyebrow" style="opacity: 0.65; color: white; margin-bottom: 6px;">{t('caseDetail.lblBudget', lang)}</div>
            <div style="font-size: 15px; font-weight: 600;">{cs.budget}</div>
          </div>
        )}
        {cs.services_used && cs.services_used.length > 0 && (
          <div>
            <div class="eyebrow" style="opacity: 0.65; color: white; margin-bottom: 6px;">{t('caseDetail.lblServices', lang)}</div>
            <div style="font-size: 15px; font-weight: 600;">{cs.services_used.join(', ')}</div>
          </div>
        )}
      </div>
    </div>
  </section>


  <!-- ============================================
       KPI GRID — pred/po čísla (4 stĺpce)
       ============================================ -->
  {cs.kpis && cs.kpis.length > 0 && (
    <section class="section" style="background: var(--bg-soft); padding-top: clamp(48px, 6vw, 80px);">
      <div class="container">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 32px;">
          <span class="eyebrow">{t('caseDetail.kpisEyebrow', lang)}</span>
          <span style="flex: 1; height: 1px; background: var(--line);"></span>
        </div>

        <div class="kpi-grid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 20px; overflow: hidden;">
          {cs.kpis.map((kpi) => (
            <div style="background: var(--bg); padding: 28px;">
              <div class="eyebrow" style="margin-bottom: 14px;">{kpi.label}</div>
              <div style="display: flex; align-items: baseline; gap: 8px; margin-bottom: 6px;">
                <span style="font-size: 13px; color: var(--muted-2); text-decoration: line-through; font-family: var(--mono);">{kpi.before}</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--muted);" aria-hidden="true">
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </div>
              <div class="num grad" style="font-size: clamp(28px, 3vw, 40px); font-weight: 700; letter-spacing: -0.02em; line-height: 1; margin-bottom: 6px;">
                {kpi.after}
              </div>
              <div style="font-size: 12px; font-family: var(--mono); font-weight: 600; color: rgb(22, 163, 74);">
                {kpi.delta}
              </div>
            </div>
          ))}
        </div>
      </div>

      <style>
        @media (max-width: 900px) { .kpi-grid { grid-template-columns: 1fr 1fr !important; } }
        @media (max-width: 540px) { .kpi-grid { grid-template-columns: 1fr !important; } }
      </style>
    </section>
  )}


  <!-- ============================================
       OBSAH — Výzva, Prístup, Výsledky
       ============================================ -->
  <section class="section">
    <div class="container" style="max-width: 880px;">

      {cs.challenge && (
        <article style="margin-bottom: 64px;">
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px;">
            <span class="eyebrow">{t('caseDetail.s1Eyebrow', lang)}</span>
            <span style="flex: 1; height: 1px; background: var(--line);"></span>
          </div>
          <h2 class="h2" style="margin-bottom: 24px;">{t('caseDetail.s1Title', lang)}</h2>
          {paragraphs(cs.challenge).map((p) => (
            <p class="body" style="font-size: 16px; line-height: 1.7; margin-bottom: 18px;">{p}</p>
          ))}
        </article>
      )}

      {cs.approach && (
        <article style="margin-bottom: 64px;">
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px;">
            <span class="eyebrow">{t('caseDetail.s2Eyebrow', lang)}</span>
            <span style="flex: 1; height: 1px; background: var(--line);"></span>
          </div>
          <h2 class="h2" style="margin-bottom: 24px;">{t('caseDetail.s2Title', lang)}</h2>
          {paragraphs(cs.approach).map((p) => (
            <p class="body" style="font-size: 16px; line-height: 1.7; margin-bottom: 18px;">{p}</p>
          ))}
        </article>
      )}

      {cs.results && (
        <article style="margin-bottom: 64px;">
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 20px;">
            <span class="eyebrow">{t('caseDetail.s3Eyebrow', lang)}</span>
            <span style="flex: 1; height: 1px; background: var(--line);"></span>
          </div>
          <h2 class="h2" style="margin-bottom: 24px;">{t('caseDetail.s3Title', lang)}</h2>
          {paragraphs(cs.results).map((p) => (
            <p class="body" style="font-size: 16px; line-height: 1.7; margin-bottom: 18px;">{p}</p>
          ))}
        </article>
      )}

      <!-- Testimonial -->
      {cs.testimonial && (
        <aside style="background: var(--bg-soft); border-left: 4px solid var(--grad-start); border-radius: 0 16px 16px 0; padding: 32px 36px; margin: 48px 0; position: relative;">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--grad-start)" stroke-width="1.4" style="opacity: 0.4; position: absolute; top: 24px; right: 24px;" aria-hidden="true">
            <path d="M3 21c3 0 7-1 7-8V5c0-1.25-.756-2.017-2-2H4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2 1 0 1 0 1 1v1c0 1-1 2-2 2s-1 .008-1 1.031V20c0 1 0 1 1 1z"></path>
            <path d="M15 21c3 0 7-1 7-8V5c0-1.25-.757-2.017-2-2h-4c-1.25 0-2 .75-2 1.972V11c0 1.25.75 2 2 2h.75c0 2.25.25 4-2.75 4v3c0 1 0 1 1 1z"></path>
          </svg>
          <p style="font-size: clamp(18px, 1.8vw, 22px); line-height: 1.5; font-weight: 500; letter-spacing: -0.015em; max-width: 60ch; margin-bottom: 16px;">
            "{cs.testimonial}"
          </p>
          {cs.testimonial_by && (
            <div style="font-size: 14px; font-weight: 600; color: var(--muted);">— {cs.testimonial_by}</div>
          )}
        </aside>
      )}
    </div>
  </section>


  <ContactSection accent="stratégiu" lang={lang} />

</Layout>
