---
/**
 * /ako-to-funguje — How It Works
 *
 * Sekcie:
 *  1. PageHero
 *  2. 6-krokový timeline (Deň 0 → Deň 30+)
 *  3. Klientsky portál preview (mock dashboard)
 *  4. 9 benefitov (3×3 grid)
 *  5. "Čo dostanete v každom pláne" — zoznam
 *  6. CTA strip "Chcete vidieť, čo sa dá s vaším účtom?"
 *  7. ContactSection
 */

import Layout from '../../layouts/Layout.astro';
import PageHero from '../PageHero.astro';
import ContactSection from '../ContactSection.astro';
import { pageMeta } from '../../lib/pageMeta';
import type { Lang } from '../../lib/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'sk' } = Astro.props;
const meta = pageMeta.howItWorks[lang];

// 6-krokový timeline
const steps = [
  {
    day:    'Deň 0',
    sub:    '30-min discovery call',
    title:  'Bezplatný audit',
    desc:   'Pošlete nám prístup do svojich účtov (alebo screenshoty). Pozrieme sa na meranie, kampane, web a do 24 h vám pošleme audit s konkrétnymi nálezmi a odhadom potenciálu.',
  },
  {
    day:    'Deň 3—5',
    sub:    'Roadmap na 90 dní',
    title:  'Stratégia a návrh',
    desc:   'Rozpíšeme čo robiť, prečo to robiť, akým tempom a aký výsledok očakávame. Dostanete jasný plán s míľnikmi, KPI a budgetom rozdeleným po kanáloch.',
  },
  {
    day:    'Deň 7',
    sub:    'Bez veľkých záväzkov',
    title:  'Podpis zmluvy',
    desc:   'Mesačný paušál, NDA, GDPR DPA. Minimum 3 mesiace, potom mesačné výpovedné obdobie. Žiadne provízie z reklamy, žiadne skryté poplatky.',
  },
  {
    day:    'Deň 8—14',
    sub:    'Meranie, kampane, prístupy',
    title:  'Onboarding a setup',
    desc:   'Nasadíme pokročilé meranie, Google Analytics, tag manager, pokročilé prepojenie s reklamnými platformami. Pripravíme kreatívu, kľúčové slová, segmenty. Vy dostanete prístup do klientskeho portálu.',
  },
  {
    day:    'Deň 15',
    sub:    'Kampane idú live',
    title:  'Spustenie',
    desc:   'Postupné spúšťanie po kanáloch s denným monitoringom. Prvý týždeň ladíme bidding, publiká a kreatívu na základe reálnych dát.',
  },
  {
    day:    'Deň 30+',
    sub:    'Týždenné reporty + portál 24/7',
    title:  'Prvé výsledky a optimalizácia',
    desc:   'Pravidelná synchronizácia, transparentné dáta v portáli, mesačná retrospektíva. Postupne škálujeme to, čo funguje.',
  },
];

// 9 benefitov
const benefits = [
  { title: 'Žiadne provízie z reklamy',     desc: 'Fixný mesačný paušál. Nemotivuje nás míňať vám zbytočne — motivuje nás priniesť výsledok.' },
  { title: 'Reálne dáta v portáli 24/7',    desc: 'Vidíte presne to, čo my. Tržby, ROAS, CPA, kampane, kreatívu — bez prikrašľovania.' },
  { title: 'Pokročilé meranie',             desc: 'Nasadíme správne meranie od dňa jedna. Žiadne stratené konverzie, žiadne odhady.' },
  { title: 'Senior tím od dňa 1',           desc: 'Žiadny juniori cvičiaci sa na vašom budgete. Každý kanál vedie certifikovaný špecialista.' },
  { title: 'Týždenné optimalizácie',        desc: 'Nečakáme na koniec mesiaca. Každý týždeň ladíme bidding, publiká a kreatívu.' },
  { title: 'GDPR a NDA štandardne',         desc: 'Server v EÚ, DPA podpísaná, NDA na požiadanie. Vaše dáta neopustia náš stack.' },
  { title: 'Slack alebo Teams kanál',       desc: 'Priamy kanál s tímom. Bez pingpongu cez ticketing systém.' },
  { title: 'Mesačná retrospektíva',         desc: 'Čo fungovalo, čo nie, čo plánujeme. 60 minút raz za mesiac, transparentne.' },
  { title: 'Garancia pravdy',               desc: 'Ak vám neprinesieme výsledok, povieme vám to ako prví. Aj keď to znamená, že vás budeme posielať preč.' },
];

// Čo dostanete v každom pláne
const inEveryPlan = [
  'Onboarding workshop a stratégia',
  'Setup pokročilého merania (Google Analytics + tag manager)',
  'Pokročilé prepojenie s reklamnými platformami pre Meta a Google',
  'Klientsky portál s real-time dátami',
  'Týždenné automatické reporty na e-mail',
  'Slack / Teams kanál s tímom',
  'Mesačná retrospektíva (60 min call)',
  'Konzultácia s analytikom',
  'NDA + GDPR DPA',
  'Audit reklamy a vstupnej stránky',
  'Notifikácie na anomálie v kampaniach',
  'Mesačné review s odporúčaniami',
];
---

<Layout
  title={meta.title}
  description={meta.description}
  lang={lang}
  pathname="/ako-to-funguje"
>

  <PageHero
    num={meta.hero!.num}
    kind={meta.hero!.kind}
    title={meta.hero!.title}
    titleAccent={meta.hero!.titleAccent}
    lead={meta.hero!.lead}
  />


  <!-- ============================================
       6-KROKOVÝ TIMELINE
       ============================================ -->
  <section class="section" style="background: var(--bg-soft); padding-top: 0;">
    <div class="container">
      <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 56px;">
        <span class="eyebrow">[ 01 — TIMELINE ]</span>
        <span style="flex: 1; height: 1px; background: var(--line);"></span>
        <span class="pill" style="background: var(--bg);">
          <span class="dot"></span>
          <span>6 KROKOV · ~30 DNÍ</span>
        </span>
      </div>

      <div class="timeline" style="position: relative;">
        <!-- Vertikálna línia (vľavo cez všetky kroky) -->
        <div aria-hidden="true" class="timeline-line" style="position: absolute; left: 28px; top: 28px; bottom: 28px; width: 2px; background: linear-gradient(180deg, var(--grad-start) 0%, var(--grad-end) 100%); opacity: 0.3;"></div>

        {steps.map((s, i) => (
          <div class="timeline-step rv" style="display: grid; grid-template-columns: 56px 1fr; gap: 32px; padding-bottom: 48px; position: relative;">
            <!-- Číslo bublina -->
            <div style="position: relative; z-index: 1;">
              <div style="width: 56px; height: 56px; border-radius: 50%; background: var(--bg); border: 2px solid var(--line); display: flex; align-items: center; justify-content: center; font-family: var(--mono); font-weight: 700; font-size: 14px; color: var(--ink);">
                {String(i + 1).padStart(2, '0')}
              </div>
            </div>

            <!-- Obsah -->
            <div style="background: var(--bg); border: 1px solid var(--line); border-radius: 20px; padding: clamp(24px, 3vw, 36px); position: relative; overflow: hidden;">
              <!-- Mini orb -->
              <div aria-hidden="true" style="position: absolute; top: -40px; right: -40px; width: 160px; height: 160px; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--grad-start) 15%, transparent), transparent 70%); opacity: 0.6; pointer-events: none;"></div>

              <div style="position: relative;">
                <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 20px; flex-wrap: wrap;">
                  <div class="pill" style="background: linear-gradient(100deg, var(--grad-start), var(--grad-end)); color: white; border: none; font-weight: 600;">
                    {s.day}
                  </div>
                  <span class="eyebrow">{s.sub}</span>
                </div>

                <h3 class="h2" style="font-size: clamp(24px, 2.6vw, 36px); margin-bottom: 14px;">{s.title}</h3>
                <p class="body" style="font-size: 15px; max-width: 70ch;">{s.desc}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ============================================
       KLIENTSKY PORTÁL PREVIEW
       ============================================ -->
  <section class="section">
    <div class="container">
      <div class="sec-head">
        <div>
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
            <span class="eyebrow">[ 02 — KLIENTSKY PORTÁL ]</span>
            <span style="flex: 1; height: 1px; background: var(--line);"></span>
            <span class="pill"><span class="dot"></span><span>Live preview</span></span>
          </div>
          <h2 class="h1" style="max-width: 14ch;">
            Vaše dáta. <span class="grad">Real-time.</span>
          </h2>
        </div>
        <p class="lead">
          Klientsky portál Adlify One vám dáva prístup ku všetkým dátam v reálnom čase. Žiadne čakanie na mesačný report, žiadne vyžiadanie údajov mailom.
        </p>
      </div>

      <div class="portal-grid" style="display: grid; grid-template-columns: 1fr 1.4fr; gap: 32px; align-items: start;">
        <!-- LEFT: Bullet list -->
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 18px;">
          {[
            'Prehľad nákladov, tržieb a ROAS po kanáloch',
            'Audit log — kto čo a kedy zmenil',
            'Týždenné a mesačné PDF reporty na stiahnutie',
            'Notifikácie na anomálie a milníky',
            'Zdieľanie dashboardu s tímom (read-only)',
          ].map((b) => (
            <li style="display: flex; align-items: flex-start; gap: 14px; font-size: 16px; line-height: 1.5;">
              <div style="width: 28px; height: 28px; border-radius: 50%; background: linear-gradient(135deg, var(--grad-start), var(--grad-end)); color: white; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 1px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <span>{b}</span>
            </li>
          ))}
        </ul>

        <!-- RIGHT: Mock dashboard -->
        <div style="background: linear-gradient(180deg, #0d0d0d, #1a1a1a); border-radius: 24px; overflow: hidden; border: 1px solid rgba(255,255,255,0.08); color: white; box-shadow: 0 40px 100px -30px rgba(0,0,0,0.4);">
          <!-- Window chrome -->
          <div style="display: flex; align-items: center; gap: 12px; padding: 14px 20px; border-bottom: 1px solid rgba(255,255,255,0.08); background: rgba(0,0,0,0.4);">
            <div style="display: flex; gap: 6px;">
              <span style="width: 10px; height: 10px; border-radius: 50%; background: #ff5f56;"></span>
              <span style="width: 10px; height: 10px; border-radius: 50%; background: #ffbd2e;"></span>
              <span style="width: 10px; height: 10px; border-radius: 50%; background: #27c93f;"></span>
            </div>
            <div style="flex: 1; display: flex; align-items: center; gap: 6px; padding: 6px 14px; background: rgba(255,255,255,0.06); border-radius: 8px; font-family: var(--mono); font-size: 11px; opacity: 0.7;">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              portal.adlify.eu/dashboard
            </div>
          </div>

          <!-- Body s 2-stĺp layoutom -->
          <div style="display: grid; grid-template-columns: 200px 1fr; min-height: 460px;">
            <!-- Sidebar -->
            <div style="border-right: 1px solid rgba(255,255,255,0.08); padding: 24px 16px; display: flex; flex-direction: column; gap: 4px;">
              <div style="font-family: var(--mono); font-size: 10px; opacity: 0.4; padding: 6px 12px; letter-spacing: 0.05em;">NAVIGÁCIA</div>
              <div style="padding: 10px 12px; border-radius: 8px; background: rgba(255,255,255,0.08); font-size: 13px; font-weight: 600;">Prehľad</div>
              <div style="padding: 10px 12px; border-radius: 8px; font-size: 13px; opacity: 0.6;">Kampane</div>
              <div style="padding: 10px 12px; border-radius: 8px; font-size: 13px; opacity: 0.6;">Reporty</div>
              <div style="padding: 10px 12px; border-radius: 8px; font-size: 13px; opacity: 0.6;">Tím</div>

              <div style="margin-top: auto; padding: 16px 12px; border-top: 1px solid rgba(255,255,255,0.08); font-size: 12px;">
                <div style="font-weight: 600;">NovaShop a.s.</div>
                <div style="opacity: 0.55; margin-top: 2px;">Plán: Growth</div>
              </div>
            </div>

            <!-- Main panel -->
            <div style="padding: 28px;">
              <!-- Header -->
              <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 28px; flex-wrap: wrap; gap: 12px;">
                <div>
                  <div style="font-size: 20px; font-weight: 700; letter-spacing: -0.02em;">Prehľad · Október 2026</div>
                  <div style="font-size: 12px; opacity: 0.55; margin-top: 4px;">Aktualizované pred 2 minútami</div>
                </div>
                <div class="pill" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.12); color: rgba(255,255,255,0.85);">
                  <span class="dot"></span>
                  <span>LIVE</span>
                </div>
              </div>

              <!-- 3 KPI -->
              <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 28px;">
                {[
                  { label: 'TRŽBY',     val: '€87 412', delta: '+24%' },
                  { label: 'ROAS',       val: '5.42×',   delta: '+0.8' },
                  { label: 'KONVERZIE', val: '1 284',   delta: '+18%' },
                ].map((kpi) => (
                  <div style="padding: 14px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.06); border-radius: 12px;">
                    <div style="font-family: var(--mono); font-size: 9px; opacity: 0.5; letter-spacing: 0.05em; margin-bottom: 6px;">{kpi.label}</div>
                    <div style="font-size: 22px; font-weight: 700; letter-spacing: -0.02em;">{kpi.val}</div>
                    <div style="font-size: 11px; font-weight: 700; color: rgb(134,239,172); margin-top: 2px;">{kpi.delta}</div>
                  </div>
                ))}
              </div>

              <!-- Mini graf (gradient bary) -->
              <div style="margin-bottom: 24px;">
                <div style="font-family: var(--mono); font-size: 10px; opacity: 0.55; margin-bottom: 10px; display: flex; justify-content: space-between;">
                  <span>Tržby vs. náklady · 30 dní</span>
                  <span>Mediánny ROAS 5.4×</span>
                </div>
                <div style="display: flex; gap: 3px; align-items: flex-end; height: 80px;">
                  {Array.from({ length: 30 }).map((_, i) => {
                    const h = 30 + (i * 60) / 29 + (Math.sin(i * 0.7) * 8);
                    return <div style={`flex: 1; background: linear-gradient(180deg, var(--grad-start), var(--grad-end)); border-radius: 2px 2px 1px 1px; height: ${h}%;`}></div>;
                  })}
                </div>
              </div>

              <!-- Footer: 2 mini boxy -->
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                <div style="padding: 12px 14px; background: rgba(255,255,255,0.03); border-radius: 10px; font-size: 11px;">
                  <div style="font-family: var(--mono); opacity: 0.5; margin-bottom: 8px; letter-spacing: 0.05em;">TOP KANÁLY</div>
                  <div style="display: flex; flex-direction: column; gap: 4px;">
                    <div style="display: flex; justify-content: space-between;"><span>Google Ads</span><span style="opacity: 0.7;">42%</span></div>
                    <div style="display: flex; justify-content: space-between;"><span>Meta Ads</span><span style="opacity: 0.7;">31%</span></div>
                    <div style="display: flex; justify-content: space-between;"><span>Email</span><span style="opacity: 0.7;">18%</span></div>
                    <div style="display: flex; justify-content: space-between;"><span>SEO</span><span style="opacity: 0.7;">9%</span></div>
                  </div>
                </div>
                <div style="padding: 12px 14px; background: rgba(255,255,255,0.03); border-radius: 10px; font-size: 11px;">
                  <div style="font-family: var(--mono); opacity: 0.5; margin-bottom: 8px; letter-spacing: 0.05em;">NEDÁVNE OPTIMALIZÁCIE</div>
                  <div style="display: flex; flex-direction: column; gap: 4px;">
                    <div style="opacity: 0.85;">Bidding +12% · Search</div>
                    <div style="opacity: 0.85;">Nová kreatíva · Meta</div>
                    <div style="opacity: 0.85;">Pauza · 3 ad sety</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <style>
      @media (max-width: 1024px) {
        .portal-grid { grid-template-columns: 1fr !important; }
      }
    </style>
  </section>


  <!-- ============================================
       9 BENEFITOV
       ============================================ -->
  <section class="section" style="background: var(--bg-soft);">
    <div class="container">
      <div class="sec-head">
        <div>
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
            <span class="eyebrow">[ 03 — BENEFITY ]</span>
            <span style="flex: 1; height: 1px; background: var(--line);"></span>
          </div>
          <h2 class="h1" style="max-width: 14ch;">
            Prečo si vyberajú <span class="grad">nás.</span>
          </h2>
        </div>
        <p class="lead">
          9 dôvodov, prečo s nami spolupracujú e-shopy a remeselníci po celej strednej Európe.
        </p>
      </div>

      <div class="benefits-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 20px; overflow: hidden;">
        {benefits.map((b, i) => (
          <div style="background: var(--bg); padding: 32px;">
            <div class="eyebrow" style="margin-bottom: 12px; font-size: 11px;">{String(i + 1).padStart(2, '0')}</div>
            <h3 class="h3" style="font-size: 18px; line-height: 1.3; margin-bottom: 12px;">{b.title}</h3>
            <p class="body" style="font-size: 14px;">{b.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <style>
      @media (max-width: 900px) { .benefits-grid { grid-template-columns: 1fr 1fr !important; } }
      @media (max-width: 540px) { .benefits-grid { grid-template-columns: 1fr !important; } }
    </style>
  </section>


  <!-- ============================================
       "V CENE" — zoznam vecí v každom pláne
       ============================================ -->
  <section class="section">
    <div class="container">
      <div class="sec-head">
        <div>
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
            <span class="eyebrow">[ 04 — V CENE ]</span>
            <span style="flex: 1; height: 1px; background: var(--line);"></span>
          </div>
          <h2 class="h1" style="max-width: 14ch;">
            Čo dostanete v <span class="grad">každom pláne.</span>
          </h2>
        </div>
        <p class="lead">
          Bez ohľadu na to, či ste Starter alebo Scale, toto patrí ku každej spolupráci.
        </p>
      </div>

      <div class="incl-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
        {inEveryPlan.map((item) => (
          <div style="display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 24px; background: var(--bg-soft); border: 1px solid var(--line); border-radius: 14px;">
            <div style="display: flex; align-items: center; gap: 14px; min-width: 0;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="rgb(34,197,94)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span style="font-size: 14px; font-weight: 500;">{item}</span>
            </div>
            <span style="padding: 4px 10px; background: rgb(34,197,94); color: white; border-radius: 999px; font-family: var(--mono); font-size: 9px; font-weight: 700; letter-spacing: 0.05em; flex-shrink: 0;">
              V CENE
            </span>
          </div>
        ))}
      </div>
    </div>

    <style>
      @media (max-width: 720px) { .incl-grid { grid-template-columns: 1fr !important; } }
    </style>
  </section>


  <!-- ============================================
       MID CTA STRIP
       ============================================ -->
  <section style="padding: clamp(56px, 7vw, 100px) 0; background: var(--ink); color: var(--bg); position: relative; overflow: hidden;">
    <div aria-hidden="true" style="position: absolute; top: -50%; left: 50%; transform: translateX(-50%); width: 800px; height: 800px; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--grad-start) 30%, transparent), transparent 60%); filter: blur(60px); opacity: 0.4; pointer-events: none;"></div>

    <div class="container" style="position: relative; text-align: center;">
      <h2 style="font-size: clamp(32px, 5vw, 56px); font-weight: 700; letter-spacing: -0.03em; line-height: 1.1; max-width: 18ch; margin: 0 auto 24px;">
        Chcete vidieť, čo sa dá s <span class="grad">vaším účtom?</span>
      </h2>
      <p style="font-size: clamp(15px, 1.4vw, 18px); opacity: 0.7; max-width: 50ch; margin: 0 auto 36px; line-height: 1.55;">
        Pošleme audit do 24 hodín. Bez záväzku, bez predajného tlaku, bez prezentácií plných buzzwordov.
      </p>
      <button class="btn btn-grad" style="padding: 18px 32px; font-size: 16px;">
        Získať bezplatný audit
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </button>
    </div>
  </section>


  <ContactSection accent="call" />

</Layout>
