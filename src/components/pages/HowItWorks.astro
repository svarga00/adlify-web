---
/**
 * /ako-to-funguje — How It Works
 *
 * Sekcie:
 *  1. PageHero
 *  2. 6-krokový timeline (Deň 0 → Deň 30+)
 *  3. Klientsky portál preview (mock dashboard)
 *  4. 9 benefitov (3×3 grid)
 *  5. "Čo dostanete v každom pláne" — zoznam
 *  6. CTA strip "Chcete vidieť, čo sa dá s vaším účtom?"
 *  7. ContactSection
 */

import Layout from '../../layouts/Layout.astro';
import PageHero from '../PageHero.astro';
import ContactSection from '../ContactSection.astro';
import { pageMeta } from '../../lib/pageMeta';
import { buildUrl, type Lang } from '../../lib/i18n';
import { t } from '../../lib/translations';

interface Props {
  lang?: Lang;
}
const { lang = 'sk' } = Astro.props;
const meta = pageMeta.howItWorks[lang];

// 6-krokový timeline (lokalizované)
const steps = [
  { day: t('htw.step1Day', lang), sub: t('htw.step1Sub', lang), title: t('htw.step1Title', lang), desc: t('htw.step1Desc', lang) },
  { day: t('htw.step2Day', lang), sub: t('htw.step2Sub', lang), title: t('htw.step2Title', lang), desc: t('htw.step2Desc', lang) },
  { day: t('htw.step3Day', lang), sub: t('htw.step3Sub', lang), title: t('htw.step3Title', lang), desc: t('htw.step3Desc', lang) },
  { day: t('htw.step4Day', lang), sub: t('htw.step4Sub', lang), title: t('htw.step4Title', lang), desc: t('htw.step4Desc', lang) },
  { day: t('htw.step5Day', lang), sub: t('htw.step5Sub', lang), title: t('htw.step5Title', lang), desc: t('htw.step5Desc', lang) },
  { day: t('htw.step6Day', lang), sub: t('htw.step6Sub', lang), title: t('htw.step6Title', lang), desc: t('htw.step6Desc', lang) },
];

// 9 benefitov (lokalizované)
const benefits = [
  { title: t('htw.b1Title', lang), desc: t('htw.b1Desc', lang) },
  { title: t('htw.b2Title', lang), desc: t('htw.b2Desc', lang) },
  { title: t('htw.b3Title', lang), desc: t('htw.b3Desc', lang) },
  { title: t('htw.b4Title', lang), desc: t('htw.b4Desc', lang) },
  { title: t('htw.b5Title', lang), desc: t('htw.b5Desc', lang) },
  { title: t('htw.b6Title', lang), desc: t('htw.b6Desc', lang) },
  { title: t('htw.b7Title', lang), desc: t('htw.b7Desc', lang) },
  { title: t('htw.b8Title', lang), desc: t('htw.b8Desc', lang) },
  { title: t('htw.b9Title', lang), desc: t('htw.b9Desc', lang) },
];

// Čo dostanete v každom pláne (lokalizované)
const inEveryPlan = [
  t('htw.iep1', lang),   // Onboarding workshop a stratégia
  t('htw.iep2', lang),   // Setup pokročilého merania (GA + Tag Manager)
  t('htw.iep3', lang),   // Pokročilé prepojenie s reklamnými platformami Meta + Google
  t('htw.iep4', lang),   // Klientsky portál s real-time dátami
  t('htw.iep5', lang),   // Týždenné automatické reporty na e-mail
  t('htw.iep9', lang),   // Audit reklamy a vstupnej stránky
  t('htw.iep10', lang),  // Notifikácie na anomálie v kampaniach
  t('htw.iep11', lang),  // Mesačné review s odporúčaniami
];
---

<Layout
  title={meta.title}
  description={meta.description}
  lang={lang}
  pathname="/ako-to-funguje"
>

  <PageHero
    num={meta.hero!.num}
    kind={meta.hero!.kind}
    title={meta.hero!.title}
    titleAccent={meta.hero!.titleAccent}
    lead={meta.hero!.lead}
  />


  <!-- ============================================
       6-KROKOVÝ TIMELINE
       ============================================ -->
  <section class="section" style="background: var(--bg-soft); padding-top: 0;">
    <div class="container">
      <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 56px;">
        <span class="eyebrow">{t('htw.timelineEyebrow', lang)}</span>
        <span style="flex: 1; height: 1px; background: var(--line);"></span>
        <span class="pill" style="background: var(--bg);">
          <span class="dot"></span>
          <span>{t('htw.timelinePill', lang)}</span>
        </span>
      </div>

      <div class="timeline" style="position: relative;">
        <!-- Vertikálna línia (vľavo cez všetky kroky) -->
        <div aria-hidden="true" class="timeline-line" style="position: absolute; left: 28px; top: 28px; bottom: 28px; width: 2px; background: linear-gradient(180deg, var(--grad-start) 0%, var(--grad-end) 100%); opacity: 0.3;"></div>

        {steps.map((s, i) => (
          <div class="timeline-step rv" style="display: grid; grid-template-columns: 56px 1fr; gap: 32px; padding-bottom: 48px; position: relative;">
            <!-- Číslo bublina -->
            <div style="position: relative; z-index: 1;">
              <div style="width: 56px; height: 56px; border-radius: 50%; background: var(--bg); border: 2px solid var(--line); display: flex; align-items: center; justify-content: center; font-family: var(--mono); font-weight: 700; font-size: 14px; color: var(--ink);">
                {String(i + 1).padStart(2, '0')}
              </div>
            </div>

            <!-- Obsah -->
            <div style="background: var(--bg); border: 1px solid var(--line); border-radius: 20px; padding: clamp(24px, 3vw, 36px); position: relative; overflow: hidden;">
              <!-- Mini orb -->
              <div aria-hidden="true" style="position: absolute; top: -40px; right: -40px; width: 160px; height: 160px; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--grad-start) 15%, transparent), transparent 70%); opacity: 0.6; pointer-events: none;"></div>

              <div style="position: relative;">
                <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 20px; flex-wrap: wrap;">
                  <div class="pill" style="background: linear-gradient(100deg, var(--grad-start), var(--grad-end)); color: white; border: none; font-weight: 600;">
                    {s.day}
                  </div>
                  <span class="eyebrow">{s.sub}</span>
                </div>

                <h3 class="h2" style="font-size: clamp(24px, 2.6vw, 36px); margin-bottom: 14px;">{s.title}</h3>
                <p class="body" style="font-size: 15px; max-width: 70ch;">{s.desc}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ============================================
       KLIENTSKY PORTÁL PREVIEW
       ============================================ -->
  <section class="section" data-portal-section>
    <div class="container">
      <div class="sec-head">
        <div>
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px; flex-wrap: wrap;">
            <span class="eyebrow">{t('htw.portalEyebrow', lang)}</span>
            <span style="flex: 1; height: 1px; background: var(--line); min-width: 40px;"></span>
            <span style="display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; background: linear-gradient(100deg, var(--grad-start), var(--grad-end)); color: white; border-radius: 999px; font-size: 11px; font-weight: 700; letter-spacing: 0.04em;">
              {t('htw.portalBadge', lang)}
            </span>
          </div>
          <h2 class="h1" style="max-width: 18ch;">
            {t('htw.portalTitlePrefix', lang)} <span class="grad">{t('htw.portalTitleAccent', lang)}</span>
          </h2>
        </div>
        <p class="lead">
          {t('htw.portalLead1', lang)} <strong style="color: var(--ink);">{t('htw.portalLead2', lang)}</strong>{t('htw.portalLead3', lang)}
        </p>
      </div>

      <div class="portal-grid" style="display: grid; grid-template-columns: 1fr 1.4fr; gap: 32px; align-items: start;">
        <!-- LEFT: Bullet list -->
        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 18px;">
          {[
            { title: t('htw.portalBullet1Title', lang), desc: t('htw.portalBullet1Desc', lang) },
            { title: t('htw.portalBullet2Title', lang), desc: t('htw.portalBullet2Desc', lang) },
            { title: t('htw.portalBullet3Title', lang), desc: t('htw.portalBullet3Desc', lang) },
            { title: t('htw.portalBullet4Title', lang), desc: t('htw.portalBullet4Desc', lang) },
            { title: t('htw.portalBullet5Title', lang), desc: t('htw.portalBullet5Desc', lang) },
            { title: t('htw.portalBullet6Title', lang), desc: t('htw.portalBullet6Desc', lang) },
          ].map((b) => (
            <li style="display: flex; align-items: flex-start; gap: 14px;">
              <div style="width: 28px; height: 28px; border-radius: 50%; background: linear-gradient(135deg, var(--grad-start), var(--grad-end)); color: white; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 2px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <div>
                <div style="font-size: 15px; font-weight: 600; line-height: 1.4; margin-bottom: 4px;">{b.title}</div>
                <div style="font-size: 13px; color: var(--muted); line-height: 1.5;">{b.desc}</div>
              </div>
            </li>
          ))}
        </ul>

        <!-- RIGHT: Mock dashboard -->
        <div style="background: linear-gradient(180deg, #0d0d0d, #1a1a1a); border-radius: 24px; overflow: hidden; border: 1px solid rgba(255,255,255,0.08); color: white; box-shadow: 0 40px 100px -30px rgba(0,0,0,0.4);">
          <!-- Window chrome -->
          <div style="display: flex; align-items: center; gap: 12px; padding: 14px 20px; border-bottom: 1px solid rgba(255,255,255,0.08); background: rgba(0,0,0,0.4);">
            <div style="display: flex; gap: 6px;">
              <span style="width: 10px; height: 10px; border-radius: 50%; background: #ff5f56;"></span>
              <span style="width: 10px; height: 10px; border-radius: 50%; background: #ffbd2e;"></span>
              <span style="width: 10px; height: 10px; border-radius: 50%; background: #27c93f;"></span>
            </div>
            <div style="flex: 1; display: flex; align-items: center; gap: 6px; padding: 6px 14px; background: rgba(255,255,255,0.06); border-radius: 8px; font-family: var(--mono); font-size: 11px; opacity: 0.7;">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <rect x="3" y="11" width="18" height="11" rx="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              portal.adlify.eu/dashboard
            </div>
          </div>

          <!-- Body s 2-stĺp layoutom -->
          <div style="display: grid; grid-template-columns: 200px 1fr; min-height: 460px;">
            <!-- Sidebar -->
            <div style="border-right: 1px solid rgba(255,255,255,0.08); padding: 24px 16px; display: flex; flex-direction: column; gap: 4px;">
              <div style="font-family: var(--mono); font-size: 10px; opacity: 0.4; padding: 6px 12px; letter-spacing: 0.05em;">{t('htw.dashNav', lang)}</div>
              <div style="padding: 10px 12px; border-radius: 8px; background: rgba(255,255,255,0.08); font-size: 13px; font-weight: 600;">{t('htw.dashOverview', lang)}</div>
              <div style="padding: 10px 12px; border-radius: 8px; font-size: 13px; opacity: 0.6;">{t('htw.dashCampaigns', lang)}</div>
              <div style="padding: 10px 12px; border-radius: 8px; font-size: 13px; opacity: 0.6;">{t('htw.dashReports', lang)}</div>
              <div style="padding: 10px 12px; border-radius: 8px; font-size: 13px; opacity: 0.6;">{t('htw.dashTeam', lang)}</div>

              <div style="margin-top: auto; padding: 16px 12px; border-top: 1px solid rgba(255,255,255,0.08); font-size: 12px;">
                <div style="font-weight: 600;">{t('htw.dashCompany', lang)}</div>
                <div style="opacity: 0.55; margin-top: 2px;">{t('htw.dashPlan', lang)}</div>
              </div>
            </div>

            <!-- Main panel -->
            <div style="padding: 28px;">
              <!-- Header -->
              <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 28px; flex-wrap: wrap; gap: 12px;">
                <div>
                  <div style="font-size: 20px; font-weight: 700; letter-spacing: -0.02em;">{t('htw.dashHeader', lang)}</div>
                  <div data-portal-updated style="font-size: 12px; opacity: 0.55; margin-top: 4px;">{t('htw.dashUpdated', lang)}</div>
                </div>
                <div class="pill" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.12); color: rgba(255,255,255,0.85);">
                  <span class="dot"></span>
                  <span>LIVE</span>
                </div>
              </div>

              <!-- 3 KPI -->
              <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-bottom: 28px;">
                {[
                  { label: t('htw.dashKpi1', lang), val: '€87 412', delta: '+24%', target: 87412, fmt: 'eur',  deltaTarget: 24 },
                  { label: t('htw.dashKpi2', lang), val: '5.42×',   delta: '+0.8', target: 5.42,  fmt: 'roas', deltaTarget: 0.8 },
                  { label: t('htw.dashKpi3', lang), val: '1 284',   delta: '+18%', target: 1284,  fmt: 'num',  deltaTarget: 18 },
                ].map((kpi) => (
                  <div style="padding: 14px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.06); border-radius: 12px;">
                    <div style="font-family: var(--mono); font-size: 9px; opacity: 0.5; letter-spacing: 0.05em; margin-bottom: 6px;">{kpi.label}</div>
                    <div data-portal-kpi data-target={kpi.target} data-fmt={kpi.fmt} style="font-size: 22px; font-weight: 700; letter-spacing: -0.02em;">{kpi.val}</div>
                    <div data-portal-delta data-target={kpi.deltaTarget} data-fmt={kpi.fmt === 'roas' ? 'plain' : 'pct'} style="font-size: 11px; font-weight: 700; color: rgb(134,239,172); margin-top: 2px;">{kpi.delta}</div>
                  </div>
                ))}
              </div>

              <!-- Mini graf (gradient bary) -->
              <div style="margin-bottom: 24px;">
                <div style="font-family: var(--mono); font-size: 10px; opacity: 0.55; margin-bottom: 10px; display: flex; justify-content: space-between;">
                  <span>{t('htw.dashChartTitle', lang)}</span>
                  <span>{t('htw.dashChartMedian', lang)}</span>
                </div>
                <div data-portal-chart style="display: flex; gap: 3px; align-items: flex-end; height: 80px;">
                  {Array.from({ length: 30 }).map((_, i) => {
                    const h = 30 + (i * 60) / 29 + (Math.sin(i * 0.7) * 8);
                    return <div data-portal-bar data-h={h} style={`flex: 1; background: linear-gradient(180deg, var(--grad-start), var(--grad-end)); border-radius: 2px 2px 1px 1px; height: 0%; transition: height 0.6s cubic-bezier(0.22, 1, 0.36, 1);`}></div>;
                  })}
                </div>
              </div>

              <!-- Footer: 2 mini boxy -->
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                <div style="padding: 12px 14px; background: rgba(255,255,255,0.03); border-radius: 10px; font-size: 11px;">
                  <div style="font-family: var(--mono); opacity: 0.5; margin-bottom: 8px; letter-spacing: 0.05em;">{t('htw.dashTopChannels', lang)}</div>
                  <div style="display: flex; flex-direction: column; gap: 4px;">
                    <div style="display: flex; justify-content: space-between;"><span>Google Ads</span><span style="opacity: 0.7;">42%</span></div>
                    <div style="display: flex; justify-content: space-between;"><span>Meta Ads</span><span style="opacity: 0.7;">31%</span></div>
                    <div style="display: flex; justify-content: space-between;"><span>Email</span><span style="opacity: 0.7;">18%</span></div>
                    <div style="display: flex; justify-content: space-between;"><span>SEO</span><span style="opacity: 0.7;">9%</span></div>
                  </div>
                </div>
                <div style="padding: 12px 14px; background: rgba(255,255,255,0.03); border-radius: 10px; font-size: 11px;">
                  <div style="font-family: var(--mono); opacity: 0.5; margin-bottom: 8px; letter-spacing: 0.05em;">{t('htw.dashRecentOpt', lang)}</div>
                  <div style="display: flex; flex-direction: column; gap: 4px;">
                    <div style="opacity: 0.85;">{t('htw.dashOpt1', lang)}</div>
                    <div style="opacity: 0.85;">{t('htw.dashOpt2', lang)}</div>
                    <div style="opacity: 0.85;">{t('htw.dashOpt3', lang)}</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <style>
      @media (max-width: 1024px) {
        .portal-grid { grid-template-columns: 1fr !important; }
      }
    </style>
  </section>


  <!-- ============================================
       9 BENEFITOV
       ============================================ -->
  <section class="section" style="background: var(--bg-soft);">
    <div class="container">
      <div class="sec-head">
        <div>
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
            <span class="eyebrow">{t('htw.benefitsEyebrow', lang)}</span>
            <span style="flex: 1; height: 1px; background: var(--line);"></span>
          </div>
          <h2 class="h1" style="max-width: 14ch;">
            {t('htw.benefitsTitlePrefix', lang)} <span class="grad">{t('htw.benefitsTitleAccent', lang)}</span>
          </h2>
        </div>
        <p class="lead">
          {t('htw.benefitsLead', lang)}
        </p>
      </div>

      <div class="benefits-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 20px; overflow: hidden;">
        {benefits.map((b, i) => (
          <div style="background: var(--bg); padding: 32px;">
            <div class="eyebrow" style="margin-bottom: 12px; font-size: 11px;">{String(i + 1).padStart(2, '0')}</div>
            <h3 class="h3" style="font-size: 18px; line-height: 1.3; margin-bottom: 12px;">{b.title}</h3>
            <p class="body" style="font-size: 14px;">{b.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <style>
      @media (max-width: 900px) { .benefits-grid { grid-template-columns: 1fr 1fr !important; } }
      @media (max-width: 540px) { .benefits-grid { grid-template-columns: 1fr !important; } }
    </style>
  </section>


  <!-- ============================================
       "V CENE" — zoznam vecí v každom pláne
       ============================================ -->
  <section class="section">
    <div class="container">
      <div class="sec-head">
        <div>
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
            <span class="eyebrow">{t('htw.inclEyebrow', lang)}</span>
            <span style="flex: 1; height: 1px; background: var(--line);"></span>
          </div>
          <h2 class="h1" style="max-width: 14ch;">
            {t('htw.inclTitlePrefix', lang)} <span class="grad">{t('htw.inclTitleAccent', lang)}</span>
          </h2>
        </div>
        <p class="lead">
          {t('htw.inclLead', lang)}
        </p>
      </div>

      <div class="incl-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
        {inEveryPlan.map((item) => (
          <div style="display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 24px; background: var(--bg-soft); border: 1px solid var(--line); border-radius: 14px;">
            <div style="display: flex; align-items: center; gap: 14px; min-width: 0;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="rgb(34,197,94)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0;" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span style="font-size: 14px; font-weight: 500;">{item}</span>
            </div>
            <span style="padding: 4px 10px; background: rgb(34,197,94); color: white; border-radius: 999px; font-family: var(--mono); font-size: 9px; font-weight: 700; letter-spacing: 0.05em; flex-shrink: 0;">
              {t('htw.inclBadge', lang)}
            </span>
          </div>
        ))}
      </div>
    </div>

    <style>
      @media (max-width: 720px) { .incl-grid { grid-template-columns: 1fr !important; } }
    </style>
  </section>


  <!-- ============================================
       MID CTA STRIP
       ============================================ -->
  <section style="padding: clamp(56px, 7vw, 100px) 0; background: var(--ink); color: var(--bg); position: relative; overflow: hidden;">
    <div aria-hidden="true" style="position: absolute; top: -50%; left: 50%; transform: translateX(-50%); width: 800px; height: 800px; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--grad-start) 30%, transparent), transparent 60%); filter: blur(60px); opacity: 0.4; pointer-events: none;"></div>

    <div class="container" style="position: relative; text-align: center;">
      <h2 style="font-size: clamp(32px, 5vw, 56px); font-weight: 700; letter-spacing: -0.03em; line-height: 1.1; max-width: 18ch; margin: 0 auto 24px;">
        {t('htw.midCtaTitlePrefix', lang)} <span class="grad">{t('htw.midCtaTitleAccent', lang)}</span>
      </h2>
      <p style="font-size: clamp(15px, 1.4vw, 18px); opacity: 0.7; max-width: 50ch; margin: 0 auto 36px; line-height: 1.55;">
        {t('htw.midCtaLead', lang)}
      </p>
      <a href={`${buildUrl(lang, "/kontakt")}#formular`} class="btn btn-grad" style="padding: 18px 32px; font-size: 16px;">
        {t('htw.midCtaButton', lang)}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </section>


  <ContactSection accent="call" lang={lang} />

  <!-- ============================================
       INTERAKTÍVNY PORTAL DASHBOARD
       Spustí sa keď sa sekcia dostane do view.
       Animuje KPI count-up + bary fill-in.
       ============================================ -->
  <script is:inline>
    (function () {
      const section = document.querySelector('[data-portal-section]');
      if (!section) return;

      let started = false;

      // Helper: format number podľa typu
      function formatVal(val, fmt) {
        switch (fmt) {
          case 'eur':
            return '€' + Math.round(val).toLocaleString('sk-SK').replace(/,/g, ' ').replace(/\u00A0/g, ' ');
          case 'roas':
            return val.toFixed(2) + '×';
          case 'num':
            return Math.round(val).toLocaleString('sk-SK').replace(/,/g, ' ').replace(/\u00A0/g, ' ');
          case 'pct':
            return '+' + Math.round(val) + '%';
          case 'plain':
            return '+' + val.toFixed(1);
          default:
            return String(val);
        }
      }

      // Easing pre count-up
      var easeOut = function(t) { return 1 - Math.pow(1 - t, 3); };

      function animateCountUp(el, target, fmt, duration) {
        duration = duration || 1800;
        var start = performance.now();
        function tick(now) {
          const elapsed = now - start;
          const t = Math.min(elapsed / duration, 1);
          const eased = easeOut(t);
          const current = target * eased;
          el.textContent = formatVal(current, fmt);
          if (t < 1) requestAnimationFrame(tick);
          else el.textContent = formatVal(target, fmt);
        }
        requestAnimationFrame(tick);
      }

      function startAnimation() {
        if (started) return;
        started = true;

        // 1) KPI count-up (rovno spustí všetky 3 paralelne)
        const kpis = section!.querySelectorAll('[data-portal-kpi]');
        kpis.forEach((el) => {
          const target = parseFloat(el.dataset.target || '0');
          const fmt = el.dataset.fmt || 'num';
          el.textContent = formatVal(0, fmt);
          animateCountUp(el, target, fmt);
        });

        // 2) Delta count-up (s drobným delay aby šlo po KPI)
        const deltas = section!.querySelectorAll('[data-portal-delta]');
        setTimeout(() => {
          deltas.forEach((el) => {
            const target = parseFloat(el.dataset.target || '0');
            const fmt = el.dataset.fmt || 'pct';
            el.textContent = formatVal(0, fmt);
            animateCountUp(el, target, fmt, 1200);
          });
        }, 400);

        // 3) Bary fill-in (staggered zľava doprava)
        const bars = section!.querySelectorAll('[data-portal-bar]');
        bars.forEach((bar, i) => {
          const finalH = parseFloat(bar.dataset.h || '0');
          setTimeout(() => {
            bar.style.height = finalH + '%';
          }, 200 + i * 35); // 35ms stagger
        });

        // 4) Cyklus "Aktualizované pred X minútami"
        const updatedEl = section!.querySelector('[data-portal-updated]');
        if (updatedEl) {
          const phrases = [
            'Aktualizované pred 2 minútami',
            'Aktualizované pred 1 minútou',
            'Aktualizované práve teraz',
            'Aktualizované pred chvíľou',
          ];
          let idx = 0;
          setInterval(() => {
            idx = (idx + 1) % phrases.length;
            updatedEl.textContent = phrases[idx];
          }, 4500);
        }
      }

      // Spustí pri prvom scroll-in
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                startAnimation();
                io.disconnect();
              }
            }
          },
          { threshold: 0.25 }
        );
        io.observe(section);
      } else {
        // Fallback: spustí ihned
        startAnimation();
      }
    })();
  </script>

</Layout>
