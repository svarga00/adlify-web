  <!-- ============================================
       FAQ (Otázky o cenníku)
       ============================================ -->
  <section class="section" style="background: var(--bg-soft); padding-top: clamp(56px, 6vw, 96px);">
    <div class="container" style="max-width: 880px;">
      <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 48px;">
        <span class="eyebrow">[ Otázky o cenníku ]</span>
