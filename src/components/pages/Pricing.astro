---
/**
 * /cennik — Cenník
 *
 * Sekcie:
 *  1. PageHero (s benefit chips)
 *  2. Pricing toggle (Mesačne / Ročne −15%)
 *  3. 3 plán karty (Starter, Growth, Scale)
 *  4. Detailné porovnanie (tabuľka)
 *  5. Jednorazové projekty (3 karty)
 *  6. FAQ
 *  7. ContactSection
 */

import Layout from '../../layouts/Layout.astro';
import PageHero from '../PageHero.astro';
import ContactSection from '../ContactSection.astro';
import { fetchPricingPlans, type PricingPlan } from '../../lib/content';
import { pageMeta } from '../../lib/pageMeta';
import type { Lang } from '../../lib/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'sk' } = Astro.props;
const meta = pageMeta.pricing[lang];

// Cenníkové plány zo Supabase (web_pricing)
// Ak DB nie je dostupná alebo je prázdna, použije sa hardcoded fallback nižšie.
const plansFromDb = await fetchPricingPlans(lang);

// Fallback (zachovaný pre prípad že DB je prázdna pri prvom builde)
const fallbackPlans: PricingPlan[] = [
  {
    id: 'fb-starter', slug: 'starter', name: 'Starter', tagline: 'Pre začiatok',
    description: 'Ideálne pre živnostníkov, ktorí chcú vyskúšať online reklamu',
    price_monthly: 149, price_setup: 0, icon: '🚀',
    badge_label: 'Pre začiatok', badge_color: '#F16434',
    is_popular: false, is_custom: false,
    features: [
      { label: '1 reklamná platforma', included: true },
      { label: '1 kampaň', included: true },
      { label: '2 reklamné vizuály', included: true },
      { label: 'Reklamné texty (copy)', included: true },
      { label: 'Základná optimalizácia', included: true },
      { label: 'Mesačný report', included: true },
      { label: 'Email podpora', included: true },
    ],
    cta_label: 'Vybrať Starter',
  },
  {
    id: 'fb-pro', slug: 'pro', name: 'Pro', tagline: 'Najobľúbenejšie',
    description: 'Pre firmy, ktoré chcú rásť na viacerých platformách',
    price_monthly: 249, price_setup: 0, icon: '⭐',
    badge_label: 'Najobľúbenejšie', badge_color: '#F16434',
    is_popular: true, is_custom: false,
    features: [
      { label: '2 platformy (FB/IG + Google)', included: true },
      { label: 'Až 3 kampane súčasne', included: true },
      { label: '4 reklamné vizuály', included: true },
      { label: 'A/B testovanie', included: true },
      { label: 'Optimalizácia každé 2 týždne', included: true },
      { label: 'Detailný report', included: true },
      { label: 'Email + telefón podpora', included: true },
    ],
    cta_label: 'Vybrať Pro',
  },
  {
    id: 'fb-enterprise', slug: 'enterprise', name: 'Enterprise', tagline: 'Pre firmy',
    description: 'Pre e-shopy a firmy s vyšším rozpočtom na reklamu',
    price_monthly: 399, price_setup: 0, icon: '💎',
    badge_label: 'Pre firmy', badge_color: '#F16434',
    is_popular: false, is_custom: false,
    features: [
      { label: 'Všetky platformy + remarketing', included: true },
      { label: 'Až 5 kampaní súčasne', included: true },
      { label: '8 reklamných vizuálov', included: true },
      { label: 'Pokročilé A/B testovanie', included: true },
      { label: 'Týždenná optimalizácia', included: true },
      { label: 'Strategické konzultácie', included: true },
      { label: 'Prioritná podpora + WhatsApp', included: true },
    ],
    cta_label: 'Vybrať Enterprise',
  },
  {
    id: 'fb-premium', slug: 'premium', name: 'Premium', tagline: 'VIP',
    description: 'Individuálna cena podľa rozsahu a potrieb vášho projektu',
    price_monthly: 799, price_setup: 0, icon: '🏆',
    badge_label: 'VIP', badge_color: '#F59E0B',
    is_popular: false, is_custom: true,
    features: [
      { label: 'Všetky platformy + remarketing', included: true },
      { label: 'Neobmedzený počet kampaní', included: true },
      { label: 'Neobmedzené vizuály', included: true },
      { label: 'Dedikovaný account manager', included: true },
      { label: 'Denná optimalizácia', included: true },
      { label: 'Mesačné strategické stretnutia', included: true },
      { label: '24/7 VIP podpora', included: true },
    ],
    cta_label: 'Kontaktujte nás',
  },
];

const plans: PricingPlan[] = plansFromDb.length > 0 ? plansFromDb : fallbackPlans;

// Comparison rows: '✓' | '—' | string ako poznámka
const compareRows = [
  { group: 'Kanály', rows: [
    { label: 'Google Ads',                          values: ['✓', '✓', '✓'] },
    { label: 'Meta Ads (Facebook + Instagram)',     values: ['voliteľne', '✓', '✓'] },
    { label: 'TikTok Ads',                          values: ['—', 'voliteľne', '✓'] },
    { label: 'LinkedIn Ads',                        values: ['—', 'voliteľne', '✓'] },
    { label: 'Microsoft Ads (Bing)',                values: ['—', '✓', '✓'] },
    { label: 'E-mail marketing (Klaviyo / Mailchimp)', values: ['—', 'voliteľne', '✓'] },
  ]},
  { group: 'Tracking & analytika', rows: [
    { label: 'Nastavenie Google Analytics + audit', values: ['✓', '✓', '✓'] },
    { label: 'Google Tag Manager',                  values: ['✓', '✓', '✓'] },
    { label: 'Enhanced ecommerce',                  values: ['—', '✓', '✓'] },
    { label: 'Pokročilé meranie',                   values: ['—', '—', '✓'] },
    { label: 'Looker Studio dashboard',             values: ['—', '✓', '✓'] },
    { label: 'Customer Data Platform',              values: ['—', '—', '✓'] },
  ]},
  { group: 'Reporting & komunikácia', rows: [
    { label: 'Týždenný report (e-mail)',            values: ['✓', '✓', '✓'] },
    { label: 'Mesačný strategický call',            values: ['—', '✓', '✓'] },
    { label: 'Slack komunikácia',                   values: ['—', '✓', '✓'] },
    { label: 'Live dashboard 24/7',                 values: ['—', '—', '✓'] },
    { label: 'Kvartálny QBR',                       values: ['—', '—', '✓'] },
  ]},
  { group: 'Tím & SLA', rows: [
    { label: 'Dedikovaný špecialista',              values: ['—', '✓', '✓'] },
    { label: 'Senior tím (2+ ľudí)',                values: ['—', '—', '✓'] },
    { label: 'Strategický partner',                 values: ['—', '—', '✓'] },
    { label: 'Reakcia do',                          values: ['48 hod', '24 hod', '4 hod'] },
  ]},
];

// Jednorazové projekty
const oneOffs = [
  { title: 'Audit účtu',                       desc: 'Detailný audit Google/Meta Ads s konkrétnymi odporúčaniami. 7–10 dní.', price: 290 },
  { title: 'Google Analytics + tag manager setup', desc: 'Kompletný setup analytiky vrátane pokročilého sledovania e-shopu a pokročilého GTM.', price: 490 },
  { title: 'Optimalizácia konverzií',          desc: '4-týždňový sprint zameraný na konverzie. UX audit, A/B testy, implementácia.', price: 990 },
];

// FAQ
const faqs = [
  { q: 'Musím platiť vopred?',
    a: 'Áno, naše služby sa platia vopred na začiatku každého mesiaca. Pri 6-mesačnej alebo 12-mesačnej spolupráci je možná aj jednorazová platba so zľavou.' },
  { q: 'Sú v cene aj reklamné rozpočty?',
    a: 'Nie. Cena je za našu prácu (správa kampaní, kreatívy, optimalizácia, reporting). Reklamný rozpočet (Google, Meta, atď.) si platíte priamo platformám zo svojej karty.' },
  { q: 'Účtujete províziu z budgetu?',
    a: 'Nikdy. Fixný paušál — nemotivujeme vás utrácať viac, motivujeme vás zarábať viac.' },
  { q: 'Môžem zmeniť balík počas spolupráce?',
    a: 'Samozrejme. Môžete kedykoľvek upgradovať na vyšší balík (zmena platná od ďalšieho mesiaca). Downgrade je možný po dovŕšení dohodnutého obdobia.' },
  { q: 'Aká je minimálna spolupráca?',
    a: '3 mesiace. Výkonnostný marketing potrebuje čas na učenie algoritmov. Po 3 mesiacoch pokračujeme mesačne s 30-dňovou výpovednou lehotou.' },
  { q: 'Ako funguje Premium balík?',
    a: 'Premium je určený pre väčšie projekty s individuálnymi potrebami. Cena sa stanovuje podľa rozsahu — počet kanálov, veľkosti rozpočtu, frekvencia stretnutí. Napíšte nám, dohodneme sa.' },
  { q: 'Sú v cene aj náklady na grafiku a copy?',
    a: 'Áno. Všetky reklamné vizuály a texty sú zahrnuté v cene podľa balíka. Nepriplácate za štandardné kreatívy.' },
];

// Helper na renderovanie buniek tabuľky
function cellContent(v: string) {
  if (v === '✓') return '<span style="color: rgb(22, 163, 74); font-weight: 700;">✓</span>';
  if (v === '—') return '<span style="color: var(--muted-2);">—</span>';
  return `<span style="font-size: 13px; color: var(--muted);">${v}</span>`;
}
---

<Layout
  title={meta.title}
  description={meta.description}
  lang={lang}
  pathname="/cennik"
>

  <PageHero
    num="004"
    kind="PRICING"
    title="Jednoduchý cenník."
    titleAccent="Bez prekvapení."
    lead="Fixný mesačný paušál. Žiadne provízie z reklamy, žiadne skryté poplatky. Minimálna spolupráca 3 mesiace."
  >
    <!-- Benefit chips pod lead -->
    <div style="display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px;">
      {['Žiadne provízie', 'Vlastníte všetky účty', '30-dňová výpoveď', 'NDA na vyžiadanie'].map((b) => (
        <span style="display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; background: var(--bg-soft); border: 1px solid var(--line); border-radius: 999px; font-size: 13px; color: var(--ink);">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="rgb(34,197,94)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          {b}
        </span>
      ))}
    </div>
  </PageHero>


  <!-- ============================================
       PRICING TOGGLE + 3 PLÁN KARTY
       ============================================ -->
  <section class="section" style="padding-top: 0;">
    <div class="container">

      <!-- Toggle: Mesačne / 6 mesiacov / 12 mesiacov -->
      <div style="display: flex; justify-content: center; margin-bottom: 56px;">
        <div data-pricing-toggle style="display: inline-flex; padding: 4px; background: var(--bg-soft); border: 1px solid var(--line); border-radius: 999px; flex-wrap: wrap;">
          <button class="pricing-toggle-btn active" data-pricing-mode="m1" data-pricing-discount="0" type="button" style="padding: 10px 18px; border-radius: 999px; font-size: 14px; font-weight: 500; background: var(--bg); color: var(--ink); border: none; cursor: pointer; transition: all 0.2s; box-shadow: 0 2px 6px rgba(0,0,0,0.06);">
            Mesačne
          </button>
          <button class="pricing-toggle-btn" data-pricing-mode="m6" data-pricing-discount="10" type="button" style="padding: 10px 18px; border-radius: 999px; font-size: 14px; font-weight: 500; background: transparent; color: var(--muted); border: none; cursor: pointer; transition: all 0.2s; display: inline-flex; align-items: center; gap: 8px;">
            6 mesiacov
            <span style="background: rgb(34,197,94); color: white; font-size: 10px; font-weight: 700; padding: 2px 8px; border-radius: 999px; letter-spacing: 0.02em;">−10%</span>
          </button>
          <button class="pricing-toggle-btn" data-pricing-mode="m12" data-pricing-discount="20" type="button" style="padding: 10px 18px; border-radius: 999px; font-size: 14px; font-weight: 500; background: transparent; color: var(--muted); border: none; cursor: pointer; transition: all 0.2s; display: inline-flex; align-items: center; gap: 8px;">
            12 mesiacov
            <span style="background: rgb(34,197,94); color: white; font-size: 10px; font-weight: 700; padding: 2px 8px; border-radius: 999px; letter-spacing: 0.02em;">−20%</span>
          </button>
        </div>
      </div>

      <!-- 4 plány -->
      <div class="plans-grid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; align-items: stretch;">
        {plans.map((plan) => {
          const isDark = plan.is_popular || plan.is_custom;
          const cardBg = plan.is_custom ? '#0f1729' : (plan.is_popular ? 'var(--ink)' : 'var(--bg)');
          const cardColor = isDark ? 'var(--bg)' : 'var(--ink)';
          const cardBorder = plan.is_custom ? '#F59E0B' : (plan.is_popular ? 'transparent' : 'var(--line-2)');
          const accentColor = plan.is_custom ? '#F59E0B' : 'var(--grad-start)';
          const checkColor = plan.is_custom ? '#FBBF24' : (plan.is_popular ? 'rgb(134,239,172)' : 'rgb(34,197,94)');
          return (
            <article
              class={`plan-card ${plan.is_popular ? 'plan-popular' : ''} ${plan.is_custom ? 'plan-custom' : ''}`}
              style={`background: ${cardBg}; color: ${cardColor}; border: 2px solid ${cardBorder}; border-radius: 24px; padding: 28px; position: relative; display: flex; flex-direction: column; ${plan.is_popular ? 'box-shadow: 0 24px 48px -16px rgba(241,100,52,0.25); transform: translateY(-8px);' : ''} ${plan.is_custom ? 'box-shadow: 0 24px 48px -16px rgba(245,158,11,0.25);' : ''}`}
            >
              <!-- Badge top-right -->
              {plan.badge_label && (
                <div style={`position: absolute; top: 16px; right: 16px; padding: 5px 12px; background: ${plan.is_custom ? 'rgba(245,158,11,0.95)' : (plan.is_popular ? 'linear-gradient(100deg, var(--grad-start), var(--grad-end))' : 'rgba(241,100,52,0.12)')}; color: ${plan.is_popular || plan.is_custom ? 'white' : 'var(--grad-start)'}; font-size: 11px; font-weight: 600; border-radius: 999px;`}>
                  {plan.badge_label}
                </div>
              )}

              <!-- Icon -->
              {plan.icon && (
                <div style="font-size: 32px; line-height: 1; margin-bottom: 28px;">{plan.icon}</div>
              )}

              <!-- Name -->
              <h3 style={`font-size: 28px; font-weight: 700; letter-spacing: -0.02em; margin-bottom: 16px; color: ${plan.is_popular ? accentColor : (plan.is_custom ? '#F59E0B' : 'var(--ink)')};`}>{plan.name}</h3>

              <!-- Price -->
              {plan.is_custom ? (
                <div style="margin-bottom: 16px;">
                  <div style="display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap;">
                    <span style="font-size: 22px; font-weight: 600; opacity: 0.85;">od</span>
                    <span class="num plan-price" data-plan-base={plan.price_monthly} style="font-size: 48px; font-weight: 700; letter-spacing: -0.03em; line-height: 1;">{plan.price_monthly}€</span>
                    <span style="font-size: 14px; opacity: 0.65;">/mes</span>
                  </div>
                </div>
              ) : (
                <div style="margin-bottom: 16px;">
                  <div style="display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap;">
                    <span class="plan-price-original" data-plan-base={plan.price_monthly} style={`font-size: 18px; font-weight: 500; text-decoration: line-through; opacity: 0.45; display: none;`}>{Math.round(plan.price_monthly / 0.8)}€</span>
                    <span class="num plan-price" data-plan-base={plan.price_monthly} style="font-size: 48px; font-weight: 700; letter-spacing: -0.03em; line-height: 1;">{plan.price_monthly}€</span>
                    <span style="font-size: 14px; opacity: 0.65;">/mes</span>
                  </div>
                  <!-- Total za obdobie (zobrazí sa pri 6m alebo 12m toggle) -->
                  <div class="plan-total" data-plan-base={plan.price_monthly} style={`font-size: 13px; opacity: 0.7; margin-top: 6px; display: none;`}>
                    <span class="plan-total-amount" style="font-weight: 600;">{plan.price_monthly * 12}</span>€ za <span class="plan-total-period">12 mesiacov</span> <span style="opacity: 0.7;">celkom</span>
                  </div>
                </div>
              )}

              <!-- Description -->
              <p style={`font-size: 13px; line-height: 1.55; opacity: ${isDark ? '0.7' : '1'}; color: ${isDark ? 'inherit' : 'var(--muted)'}; margin-bottom: 24px; min-height: 40px;`}>
                {plan.description || plan.tagline}
              </p>

              <!-- Separator -->
              <div style={`height: 1px; background: ${isDark ? 'rgba(255,255,255,0.12)' : 'var(--line)'}; margin-bottom: 24px;`}></div>

              <!-- Features -->
              <ul style="list-style: none; padding: 0; margin: 0 0 28px 0; display: flex; flex-direction: column; gap: 14px; flex: 1;">
                {plan.features.filter((f) => f.included).map((f) => (
                  <li style="display: flex; align-items: flex-start; gap: 10px; font-size: 14px; line-height: 1.45;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke={checkColor} stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 2px;" aria-hidden="true">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>{f.label}</span>
                  </li>
                ))}
              </ul>

              <!-- CTA -->
              <a
                href={plan.is_custom ? '/kontakt' : '#'}
                data-pricing-cta
                data-plan-slug={plan.slug}
                data-plan-name={plan.name}
                class={plan.is_popular ? 'btn btn-pricing-popular' : (plan.is_custom ? 'btn btn-pricing-custom' : 'btn btn-pricing-default')}
                style="width: 100%; justify-content: center;"
              >
                {plan.cta_label || `Vybrať ${plan.name}`}
              </a>
            </article>
          );
        })}
      </div>

      <!-- Disclaimer pod kartami -->
      <p style="text-align: center; margin-top: 32px; font-size: 13px; color: var(--muted); max-width: 700px; margin-left: auto; margin-right: auto; line-height: 1.6;">
        * Ceny sú bez DPH. <strong style="color: var(--ink-2);">Reklamný rozpočet</strong> (budget na reklamy v Google/Meta) <strong style="color: var(--ink-2);">nie je zahrnutý</strong> — platíte ho priamo platformám zo svojej karty.
      </p>
    </div>
  </section>


  <!-- ============================================
       REKLAMNÝ ROZPOČET — 3 príklady
       ============================================ -->
  <section class="section" style="background: var(--bg-soft);">
    <div class="container">
      <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
        <span class="eyebrow">[ Dôležité ]</span>
        <span style="flex: 1; height: 1px; background: var(--line);"></span>
      </div>
      <div class="sec-head">
        <h2 class="h1" style="max-width: 16ch;">Čo je reklamný rozpočet?</h2>
        <p class="lead">
          Okrem našej ceny za správu kampaní potrebujete aj <strong>reklamný rozpočet (budget)</strong> — peniaze, ktoré platíte priamo Facebooku alebo Google za zobrazovanie vašich reklám. Tento rozpočet si nastavujete vy podľa svojich možností. Čím viac investujete, tým viac ľudí oslovíte.
        </p>
      </div>

      <div class="budget-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 56px;">
        <!-- 150-300€ -->
        <div style="background: var(--bg); border: 1px solid var(--line); border-radius: 20px; padding: 32px; text-align: center; display: flex; flex-direction: column;">
          <div class="num grad" style="font-size: 36px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.1; margin-bottom: 12px;">150–300 €</div>
          <div style="font-size: 11px; font-family: var(--mono); color: var(--muted); letter-spacing: 0.05em; margin-bottom: 16px;">/MESIAC</div>
          <div style="font-size: 14px; font-weight: 600; margin-bottom: 8px;">Starter / Pro</div>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.55; margin: 0;">
            Pre živnostníkov a malé firmy. Test kampaní, prvé výsledky, overenie potenciálu.
          </p>
        </div>

        <!-- 300-700€ -->
        <div style="background: var(--bg); border: 1px solid var(--line); border-radius: 20px; padding: 32px; text-align: center; display: flex; flex-direction: column;">
          <div class="num grad" style="font-size: 36px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.1; margin-bottom: 12px;">300–700 €</div>
          <div style="font-size: 11px; font-family: var(--mono); color: var(--muted); letter-spacing: 0.05em; margin-bottom: 16px;">/MESIAC</div>
          <div style="font-size: 14px; font-weight: 600; margin-bottom: 8px;">Pro / Enterprise</div>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.55; margin: 0;">
            Pre stabilnejšie výsledky. Viacero kampaní paralelne, lepšie testovanie, väčší dosah.
          </p>
        </div>

        <!-- 1500€+ -->
        <div style="background: var(--bg); border: 1px solid var(--line); border-radius: 20px; padding: 32px; text-align: center; display: flex; flex-direction: column;">
          <div class="num grad" style="font-size: 36px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.1; margin-bottom: 12px;">1 500 €+</div>
          <div style="font-size: 11px; font-family: var(--mono); color: var(--muted); letter-spacing: 0.05em; margin-bottom: 16px;">/MESIAC</div>
          <div style="font-size: 14px; font-weight: 600; margin-bottom: 8px;">Premium</div>
          <p style="font-size: 13px; color: var(--muted); line-height: 1.55; margin: 0;">
            Pre veľké projekty s maximálnym dosahom. Plný škálovaný marketing s remarketingom.
          </p>
        </div>
      </div>
    </div>

    <style>
      @media (max-width: 1024px) { .budget-grid { grid-template-columns: 1fr 1fr !important; } }
      @media (max-width: 640px)  { .budget-grid { grid-template-columns: 1fr !important; } }
    </style>
  </section>


  <!-- ============================================
       JEDNORAZOVÉ PROJEKTY (3 karty)
       ============================================ -->
  <section class="section">
    <div class="container">
      <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 48px;">
        <span class="eyebrow">[ Jednorazové projekty ]</span>
        <span style="flex: 1; height: 1px; background: var(--line);"></span>
      </div>

      <div class="oneoff-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;">
        {oneOffs.map((o) => (
          <article style="background: var(--bg); border: 1px solid var(--line); border-radius: 20px; padding: 32px; display: flex; flex-direction: column;">
