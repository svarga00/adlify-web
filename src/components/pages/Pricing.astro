            </div>
          </details>
        ))}
      </div>
    </div>
  </section>


  <ContactSection accent="call" />


  <!-- Pricing toggle JS + drawer preset -->
  <script>
    (function () {
      // Toggle: Mesačne / 6 mes -10% / 12 mes -20%
      const btns = document.querySelectorAll<HTMLElement>('[data-pricing-mode]');
      const prices = document.querySelectorAll<HTMLElement>('.plan-price');
      const originals = document.querySelectorAll<HTMLElement>('.plan-price-original');
      const totals = document.querySelectorAll<HTMLElement>('.plan-total');

      function applyDiscount(discount: number) {
        // discount: 0 (Mesačne), 10 (6 mes), 20 (12 mes)
        const months = discount === 0 ? 0 : (discount === 10 ? 6 : 12);

        prices.forEach((p) => {
          const base = parseFloat(p.dataset.planBase || '0');
          if (!base) return;
          const newPrice = Math.round(base * (1 - discount / 100));
          p.textContent = newPrice + '€';
        });

        originals.forEach((o) => {
          const base = parseFloat(o.dataset.planBase || '0');
          if (!base) return;
          // Original cena = base (pôvodná) keď je discount > 0
          if (discount > 0) {
            o.textContent = base + '€';
            o.style.display = 'inline';
          } else {
            o.style.display = 'none';
          }
        });

        totals.forEach((t) => {
          const base = parseFloat(t.dataset.planBase || '0');
          if (!base || months === 0) {
            t.style.display = 'none';
            return;
          }
          const newPrice = Math.round(base * (1 - discount / 100));
          const totalAmount = newPrice * months;
          const amountEl = t.querySelector('.plan-total-amount') as HTMLElement;
          const periodEl = t.querySelector('.plan-total-period') as HTMLElement;
          if (amountEl) amountEl.textContent = totalAmount.toString();
          if (periodEl) periodEl.textContent = `${months} mesiacov`;
          t.style.display = 'block';
        });
      }

      btns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const discount = parseFloat(btn.dataset.pricingDiscount || '0');
          btns.forEach((b) => {
            const isActive = b === btn;
            b.classList.toggle('active', isActive);
            b.style.background = isActive ? 'var(--bg)' : 'transparent';
            b.style.color = isActive ? 'var(--ink)' : 'var(--muted)';
            b.style.boxShadow = isActive ? '0 2px 6px rgba(0,0,0,0.06)' : 'none';
          });
          applyDiscount(discount);
        });
      });

      // CTA tlačítko -> drawer preset
      const ctas = document.querySelectorAll<HTMLAnchorElement>('[data-pricing-cta]');
      ctas.forEach((cta) => {
        cta.addEventListener('click', (e) => {
          // Pre is_custom (Premium) ide na /kontakt — nechaj default behavior
          const slug = cta.dataset.planSlug;
          const planName = cta.dataset.planName || '';
          if (cta.getAttribute('href') === '#') {
            e.preventDefault();
          } else {
            // Aj ked ide na /kontakt, otvor drawer
            e.preventDefault();
          }
          // Ziskat aktuálne zvolený toggle
          const activeBtn = document.querySelector<HTMLElement>('[data-pricing-mode].active');
          const period = activeBtn?.dataset.pricingMode || 'm1';
          const periodLabel = period === 'm6' ? '6 mesiacov' : period === 'm12' ? '12 mesiacov' : 'mesačne';

          const w = window as any;
          if (typeof w.openContact === 'function') {
            w.openContact({
              plan: planName,
              planSlug: slug,
              period: periodLabel,
            });
          } else {
            // Fallback ak drawer nie je dostupny
            window.location.href = '/kontakt';
          }
        });
      });
    })();
  </script>

