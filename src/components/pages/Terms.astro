---
/**
 * /obchodne-podmienky — Všeobecné obchodné podmienky
 *
 * Vzorová šablóna pre marketingovú agentúru. Údaje firmy sa
 * dotahujú zo web_settings (cez admin). Ak nie sú vyplnené,
 * zobrazia sa placeholdery v hranatých zátvorkách.
 *
 * VYHRADENÝ: tento dokument je len vzor. Pred živým použitím
 * by mal byť skontrolovaný advokátom alebo právnym poradcom,
 * najmä ak meníte rozsah služieb alebo cenovú štruktúru.
 */

import Layout from '../../layouts/Layout.astro';
import { fetchSettings } from '../../lib/content';
import { pageMeta } from '../../lib/pageMeta';
import type { Lang } from '../../lib/i18n';
import { t } from '../../lib/translations';

interface Props {
  lang?: Lang;
}
const { lang = 'sk' } = Astro.props;
const meta = pageMeta.terms[lang];
const settings = await fetchSettings(lang);

// Placeholder ak admin Settings nemá údaje vyplnené
const ph = (val: string, label: string) => val || `[${label}]`;
const company    = ph(settings.company_name,    'názov firmy');
const ico        = ph(settings.company_ico,     'IČO');
const dic        = ph(settings.company_dic,     'DIČ');
const address    = ph(settings.contact_address, 'sídlo');
const email      = ph(settings.contact_email,   'e-mail');

const dateLocale = ({ sk: 'sk-SK', cs: 'cs-CZ', hu: 'hu-HU', en: 'en-GB', de: 'de-DE' } as const)[lang];
const today = new Date().toLocaleDateString(dateLocale);
---

<Layout
  title={meta.title}
  description={meta.description}
  lang={lang}
  pathname="/obchodne-podmienky"
>

  <!-- Subtílny hero -->
  <section class="legal-hero">
    <div class="container" style="max-width: 1080px;">
      <nav class="legal-breadcrumb" aria-label="Breadcrumb">
        <a href="/">{t('legal.crumbHome', lang)}</a>
        <span class="sep">/</span>
        <span>{t('legal.crumbTerms', lang)}</span>
      </nav>
      <div class="legal-eyebrow">{t('terms.docEyebrow', lang)}</div>
      <h1 class="legal-h1">{t('terms.h1', lang)}</h1>
      <p class="legal-lead">
        {t('terms.lead', lang).replace('{company}', company)}
      </p>
      <div class="legal-meta-row">
        <span><strong>{t('legal.effectiveFrom', lang)}:</strong> {today}</span>
        <span class="dot">·</span>
        <span><strong>{t('legal.version', lang)}:</strong> 1.0</span>
        <span class="dot">·</span>
        <a href={`mailto:${settings.contact_email || 'info@adlify.eu'}`}>{settings.contact_email || 'info@adlify.eu'}</a>
      </div>
    </div>
  </section>

  <section style="padding-bottom: clamp(80px, 10vw, 140px);">
    <div class="container" style="max-width: 1080px;">
      <div class="legal-layout">

        <!-- Obsah článku -->
        <article class="legal-prose">

          <h2 id="vseobecne">{t('terms.s1Title', lang)}</h2>
          <p>
            {t('terms.s1p1Prefix', lang)} <strong>„{t('terms.s1p1VopAbbr', lang)}"</strong>{t('terms.s1p1Middle', lang)} <strong>{company}</strong>, {t('terms.s1p1IcoLabel', lang)}: {ico}, {t('terms.s1p1DicLabel', lang)}: {dic}, {t('terms.s1p1AddressLabel', lang)} {address}
            (<strong>„{t('terms.s1p1ProviderLabel', lang)}"</strong>) {t('terms.s1p1Suffix', lang)} (<strong>„{t('terms.s1p1ClientLabel', lang)}"</strong>).
          </p>
          <p>{t('terms.s1p2', lang)}</p>

          <h2 id="uzatvorenie">{t('terms.s2Title', lang)}</h2>
          <p>{t('terms.s2Body', lang).replace('{email}', email)}</p>

          <h2 id="cena">{t('terms.s3Title', lang)}</h2>
          <ul>
            <li>{t('terms.s3item1', lang)}</li>
            <li>{t('terms.s3item2', lang)}</li>
            <li>{t('terms.s3item3', lang)}</li>
            <li>{t('terms.s3item4', lang)}</li>
            <li>{t('terms.s3item5', lang)}</li>
          </ul>

          <h2 id="poskytovatel">{t('terms.s4Title', lang)}</h2>
          <ul>
            <li>{t('terms.s4item1', lang)}</li>
            <li>{t('terms.s4item2', lang)}</li>
            <li>{t('terms.s4item3', lang)}</li>
            <li>{t('terms.s4item4', lang)}</li>
          </ul>

          <h2 id="objednavatel">{t('terms.s5Title', lang)}</h2>
          <ul>
            <li>{t('terms.s5item1', lang)}</li>
            <li>{t('terms.s5item2', lang)}</li>
            <li>{t('terms.s5item3', lang)}</li>
            <li>{t('terms.s5item4', lang)}</li>
          </ul>

          <h2 id="garancie">{t('terms.s6Title', lang)}</h2>
          <p>
            {t('terms.s6p1Prefix', lang)} <strong>{t('terms.s6p1Bold', lang)}</strong> {t('terms.s6p1Rest', lang)}
          </p>
          <p>{t('terms.s6p2', lang)}</p>
          <ul>
            <li>{t('terms.s6item1', lang)}</li>
            <li>{t('terms.s6item2', lang)}</li>
            <li>{t('terms.s6item3', lang)}</li>
          </ul>
          <p>{t('terms.s6p3', lang)}</p>

          <h2 id="trvanie">{t('terms.s7Title', lang)}</h2>
          <ul>
            <li>{t('terms.s7item1', lang)}</li>
            <li>{t('terms.s7item2', lang)}</li>
            <li>{t('terms.s7item3', lang)}</li>
            <li>{t('terms.s7item4', lang)}</li>
            <li>{t('terms.s7item5', lang)}</li>
          </ul>

          <h2 id="dusevne">{t('terms.s8Title', lang)}</h2>
          <p>{t('terms.s8Body', lang)}</p>

          <h2 id="mlcanlivost">{t('terms.s9Title', lang)}</h2>
          <p>{t('terms.s9Body', lang)}</p>

          <h2 id="reklamacie">{t('terms.s10Title', lang)}</h2>
          <p>{t('terms.s10Body', lang).replace('{email}', email)}</p>

          <h2 id="zaverecne">{t('terms.s11Title', lang)}</h2>
          <ul>
            <li>{t('terms.s11item1', lang)}</li>
            <li>{t('terms.s11item2', lang)}</li>
            <li>{t('terms.s11item3', lang)}</li>
          </ul>

          <hr />
          <p class="legal-meta">
            {t('legal.lastUpdate', lang)}: {today}<br />
            {t('legal.questionsAt', lang)}: <a href={`mailto:${settings.contact_email || 'info@adlify.eu'}`}>{settings.contact_email || 'info@adlify.eu'}</a>
          </p>
        </article>

        <!-- Sticky ToC sidebar -->
        <aside class="legal-sidebar">
          <div class="legal-sidebar-sticky">
            <div class="legal-sidebar-eyebrow">{t('legal.tocEyebrow', lang)}</div>
            <nav class="legal-toc" aria-label={t('legal.tocAria', lang)}>
              <ol>
                <li><a href="#vseobecne">{t('terms.toc1', lang)}</a></li>
                <li><a href="#uzatvorenie">{t('terms.toc2', lang)}</a></li>
                <li><a href="#cena">{t('terms.toc3', lang)}</a></li>
                <li><a href="#poskytovatel">{t('terms.toc4', lang)}</a></li>
                <li><a href="#objednavatel">{t('terms.toc5', lang)}</a></li>
                <li><a href="#garancie">{t('terms.toc6', lang)}</a></li>
                <li><a href="#trvanie">{t('terms.toc7', lang)}</a></li>
                <li><a href="#dusevne">{t('terms.toc8', lang)}</a></li>
                <li><a href="#mlcanlivost">{t('terms.toc9', lang)}</a></li>
                <li><a href="#reklamacie">{t('terms.toc10', lang)}</a></li>
                <li><a href="#zaverecne">{t('terms.toc11', lang)}</a></li>
              </ol>
            </nav>
          </div>
        </aside>
      </div>
    </div>
  </section>

</Layout>
