---
/**
 * /faq — Časté otázky
 *
 * Sekcie:
 *  1. PageHero
 *  2. Kategória taby (Spolupráca 5, Cena a fakturácia 5, Výsledky 4, Tracking a dáta 3, Služby 4)
 *  3. Akordeón otázok pre aktívnu kategóriu
 *  4. CTA box "Nenašli ste odpoveď?"
 *  5. ContactSection
 */

import Layout from '../../layouts/Layout.astro';
import PageHero from '../PageHero.astro';
import ContactSection from '../ContactSection.astro';
import { pageMeta } from '../../lib/pageMeta';
import { glossary } from '../../lib/glossary';
import type { Lang } from '../../lib/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'sk' } = Astro.props;
const meta = pageMeta.faq[lang];

// Slovník — kategórie + abecedné indexy
const glossaryCategories: Array<{ key: GlossaryTerm['category']; label: string }> = [
  { key: 'reklama',    label: 'Reklama' },
  { key: 'meranie',    label: 'Meranie' },
  { key: 'seo',        label: 'SEO' },
  { key: 'email',      label: 'E-mail' },
  { key: 'eshop',      label: 'E-shop' },
  { key: 'vseobecne',  label: 'Všeobecné' },
];

// Helper: normalize diakritiku
function normalizeLetter(ch: string): string {
  return ch.toUpperCase().normalize('NFD').replace(/\p{Diacritic}/gu, '');
}

// Zoradiť pojmy abecedne (pre konzistentné poradie)
const sortedGlossary = [...glossary].sort((a, b) =>
  a.term.localeCompare(b.term, 'sk', { sensitivity: 'base' })
).map((t) => ({
  ...t,
  letter: normalizeLetter(t.term.charAt(0)),
  searchText: `${t.term.toLowerCase()} ${(t.shortcut || '').toLowerCase()} ${t.description.toLowerCase()}`,
}));

// Abeceda (písmená kde mám aspoň 1 termín)
const usedLetters = Array.from(new Set(
  sortedGlossary.map((t) => t.letter)
)).sort();

import type { GlossaryTerm } from '../../lib/glossary';

// 5 kategórií, každá s vlastnými otázkami
const categories = [
  {
    key: 'spolupraca',
    label: 'Spolupráca',
    questions: [
      { q: 'Mám nejakú viazanosť?',
        a: 'Nie. Žiadna minimálna doba ani výpovedná lehota — odísť môžete kedykoľvek. Iba upozorňujeme, že výkonnostný marketing potrebuje čas (typicky 2–3 mesiace) aby kampane získali dáta a ukázali plný potenciál.' },
      { q: 'Pracujete s konkurenciou v rovnakom odvetví?',
        a: 'V malých nikách (napr. lokálni floristi v Bratislave) máme exkluzivitu. Pri väčších kategóriách (e-commerce fashion) striktne oddeľujeme tímy aj komunikačné kanály a chránime všetky dôverné informácie.' },
      { q: 'Komunikujete cez Slack alebo e-mail?',
        a: 'Oboje. Slack alebo Teams pre rýchle veci, e-mail pre dôležité rozhodnutia. Týždenné reporty chodia automaticky e-mailom.' },
      { q: 'Vlastním reklamné účty?',
        a: 'Áno, všetky účty (Google Ads, Meta, GA4) sú na vašu firmu. My máme prístup ako agentúra. Keď spolupráca skončí, prístupy odoberieme — vy si všetko ponecháte.' },
      { q: 'Koľko trvá onboarding?',
        a: '7–10 pracovných dní. Najprv discovery call, potom audit, stratégia, podpis a setup. Prvá kampaň beží do 14 dní od podpisu.' },
    ],
  },
  {
    key: 'cena',
    label: 'Cena a fakturácia',
    questions: [
      { q: 'Sú v cene aj reklamné rozpočty?',
        a: 'Nie. Mesačný paušál pokrýva našu prácu (správa kampaní, kreatívy, optimalizácia, reporting). Reklamné rozpočty (Google, Meta, atď.) si platíte priamo platformám zo svojej karty.' },
      { q: 'Koľko musím minimálne minúť na reklamu?',
        a: 'Neexistuje tvrdý minimálny budget, ale reálne odporúčame aspoň 500–1 000 € mesačne na jeden kanál. Pod túto sumu kampane nevedia získať dosť dát na efektívne učenie.' },
      { q: 'Aké sú platobné podmienky?',
        a: 'Prvá platba je vopred. Ďalšie faktúry majú splatnosť podľa dohody. Akceptujeme bankový prevod aj kartu. Pri 6-mesačnej platbe vopred dostávate 10 % zľavu, pri 12-mesačnej 20 %.' },
      { q: 'Môžete robiť aj jednorazové projekty?',
        a: 'Áno — audit účtu (€290), Nastavenie GA + tag manager (€490), Optimalizácia konverzií (€990). Pre kontinuálne riadenie kampaní však dlhodobá spolupráca dáva oveľa väčší zmysel.' },
    ],
  },
  {
    key: 'vysledky',
    label: 'Výsledky',
    questions: [
      { q: 'Garantujete výsledky?',
        a: 'Negarantujeme konkrétne čísla — to nikto seriózny nemôže. Garantujeme ale prácu na výsledku, transparentné dáta a otvorenú komunikáciu. Ak vám nevieme priniesť hodnotu, povieme vám to ako prví.' },
      { q: 'Kedy uvidím prvé výsledky?',
        a: 'Search kampane (Google Ads) prinášajú prvé konverzie už v prvom týždni. Display a Meta kampane potrebujú 2–4 týždne na učenie. Pokročilé optimalizácie sú merateľné po 2–3 mesiacoch.' },
      { q: 'Aký ROAS je realistický?',
        a: 'Závisí od kategórie. E-commerce (jednorazový nákup): 3–5×. Subscription / repeat purchase: 4–8×. Lead gen: meriame skôr CPA. Pri starte vás vždy upozorníme, kde sú benchmarky vašej kategórie.' },
      { q: 'Čo robíte, keď kampaň nefunguje?',
        a: 'Najprv hľadáme, či je problém v kampani (bidding, kreatíva, audience) alebo mimo nej (web, ponuka, ceny). Pri dlhšom probléme zvolávame ad-hoc retrospektívu, kde si rovno povieme, čo skúsime ďalej.' },
    ],
  },
  {
    key: 'tracking',
    label: 'Tracking a dáta',
    questions: [
      { q: 'Riešite GDPR a cookie compliance?',
        a: 'Áno. Pri onboarde nasadíme cookie consent (Cookiebot alebo Iubenda), nastavíme Google Analytics 4 v EÚ móde, použijeme server-side tracking pre Meta a Google, a všetko zdokumentujeme do GDPR DPA, ktorú s vami podpíšeme.' },
      { q: 'Čo je server-side tracking?',
        a: 'Klasický tracking funguje cez prehliadač, ktorý môže byť blokovaný (iOS, ad blockery). Server-side tracking posiela dáta z vášho servera priamo do reklamných platforiem — nezávisle od prehliadača. Výsledok: 20–40 % viac zachytených konverzií.' },
      { q: 'Komu patria dáta?',
        a: 'Vám. Všetky účty sú na vašu firmu, dáta sa ukladajú vo vašich Google a Meta účtoch. Naše dashboardy v Looker Studio sú postavené nad vašimi dátami — keď spolupráca skončí, máte ich naďalej.' },
    ],
  },
  {
    key: 'sluzby',
    label: 'Služby',
    questions: [
      { q: 'Robíte aj SEO?',
        a: 'Áno, ale pristupujeme k tomu inak ako klasické SEO agentúry. Náš fokus je na technickom SEO (rýchlosť, indexácia, štruktúrované dáta), keyword research orientovaný na komerčný úmysel a kvalitný content. Linkbuilding robíme len cestou cez digital PR alebo guest posty na overených weboch.' },
      { q: 'Robíte e-mail marketing?',
        a: 'Áno. Najmä cez Klaviyo (e-commerce) alebo Mailchimp / ActiveCampaign (B2B). Pripravujeme welcome flows, abandoned cart automatizácie, segmentáciu, A/B testy subject lines.' },
      { q: 'Vyrábate kreatívu (videá, bannery, copy)?',
        a: 'Áno, in-house designer pripraví prvý balík static a video kreatív (zvyčajne 12 variantov pre Meta). Pre rozsiahlejšie produkcie spolupracujeme s overenými partnermi.' },
      { q: 'Robíte aj lokalizáciu kampaní (CZ, HU, DE)?',
        a: 'Áno, vrátane native copy. V tíme máme natívnych Slovákov a Čechov, pre HU a DE spolupracujeme s native špecialistami. Lokalizácia nie je len preklad — adaptujeme aj kreatívu, ponuku a CTA.' },
    ],
  },
];
---

<Layout
  title={meta.title}
  description={meta.description}
  lang={lang}
  pathname="/faq"
>

  <PageHero
    num={meta.hero!.num}
    kind={meta.hero!.kind}
    title={meta.hero!.title}
    titleAccent={meta.hero!.titleAccent}
    lead={meta.hero!.lead}
  />


  <!-- ============================================
       KATEGÓRIA TABS + OTÁZKY
       ============================================ -->
  <section class="section" style="padding-top: 0;">
    <div class="container" style="max-width: 980px;">

      <!-- Taby -->
      <div class="faq-tabs" style="display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 40px; padding: 6px; background: var(--bg-soft); border: 1px solid var(--line); border-radius: 16px;">
        {categories.map((cat, i) => (
          <button
            class={`faq-tab ${i === 1 ? 'active' : ''}`}
            data-faq-tab={cat.key}
            type="button"
            style={`flex: 1; min-width: 120px; padding: 14px 16px; border-radius: 12px; border: none; font-size: 14px; font-weight: 600; background: ${i === 1 ? 'var(--ink)' : 'transparent'}; color: ${i === 1 ? 'var(--bg)' : 'var(--ink)'}; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 8px;`}
          >
            <span>{cat.label}</span>
            <span class="num" style={`font-family: var(--mono); font-size: 11px; padding: 2px 8px; border-radius: 999px; background: ${i === 1 ? 'rgba(255,255,255,0.15)' : 'var(--bg)'}; opacity: 0.85;`}>
              {cat.questions.length}
            </span>
          </button>
        ))}
        <!-- Tab Pojmy (slovník) -->
        <button
          class="faq-tab"
          data-faq-tab="pojmy"
          type="button"
          style="flex: 1; min-width: 120px; padding: 14px 16px; border-radius: 12px; border: none; font-size: 14px; font-weight: 600; background: transparent; color: var(--ink); cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 8px;"
        >
          <span>Pojmy</span>
          <span class="num" style="font-family: var(--mono); font-size: 11px; padding: 2px 8px; border-radius: 999px; background: var(--bg); opacity: 0.85;">
            {sortedGlossary.length}
          </span>
        </button>
      </div>

      <!-- Otázky pre každú kategóriu -->
      {categories.map((cat, i) => (
        <div
          class={`faq-pane ${i === 1 ? 'active' : ''}`}
          data-faq-pane={cat.key}
          style={`display: ${i === 1 ? 'block' : 'none'};`}
        >
          <div style="display: flex; flex-direction: column; border-top: 1px solid var(--line);">
            {cat.questions.map((item, qi) => (
              <details class="faq-item" style="border-bottom: 1px solid var(--line); padding: 0;" open={qi === 0}>
                <summary style="padding: 28px 4px; cursor: pointer; display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; font-size: 18px; font-weight: 600; letter-spacing: -0.015em; line-height: 1.35; list-style: none;">
                  <span>{item.q}</span>
                  <svg class="faq-chev" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 3px; transition: transform 0.25s;" aria-hidden="true">
                    <path d="m6 9 6 6 6-6"></path>
                  </svg>
                </summary>
                <div style="padding: 0 56px 28px 4px; font-size: 15px; line-height: 1.65; color: var(--muted);">
                  {item.a}
                </div>
              </details>
            ))}
          </div>
        </div>
      ))}

      <!-- ============================================
           PANE: POJMY (slovník)
           ============================================ -->
      <div class="faq-pane" data-faq-pane="pojmy" style="display: none;">

        <!-- Hľadací box -->
        <div style="position: relative; margin-bottom: 24px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; left: 18px; top: 50%; transform: translateY(-50%); color: var(--muted); pointer-events: none;" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <input
            type="search"
            id="glossary-search"
            placeholder="Hľadať pojem… (napr. ROAS, CPA, GA4)"
            style="width: 100%; padding: 16px 18px 16px 50px; background: var(--bg); border: 1px solid var(--line); border-radius: 14px; font-size: 15px; color: var(--ink); outline: none; transition: border-color 0.15s;"
          />
        </div>

        <!-- Filtre: Kategórie -->
        <div style="display: flex; gap: 24px; margin-bottom: 24px; flex-wrap: wrap; align-items: center;">
          <div style="display: flex; gap: 6px; flex-wrap: wrap; align-items: center;">
            <span class="eyebrow" style="font-size: 10px; margin-right: 6px;">KATEGÓRIA</span>
            <button
              class="g-cat-btn active"
              data-g-cat="all"
              type="button"
              style="padding: 6px 14px; border-radius: 999px; border: 1px solid var(--ink); background: var(--ink); color: var(--bg); font-size: 12px; font-weight: 600; cursor: pointer; transition: all 0.15s;"
            >
              Všetko
            </button>
            {glossaryCategories.map((cat) => (
              <button
                class="g-cat-btn"
                data-g-cat={cat.key}
                type="button"
                style="padding: 6px 14px; border-radius: 999px; border: 1px solid var(--line); background: var(--bg); color: var(--ink); font-size: 12px; font-weight: 600; cursor: pointer; transition: all 0.15s;"
              >
                {cat.label}
              </button>
            ))}
          </div>
        </div>

        <!-- Abeceda -->
        <div style="display: flex; gap: 4px; margin-bottom: 32px; flex-wrap: wrap; align-items: center;">
          <span class="eyebrow" style="font-size: 10px; margin-right: 6px;">PÍSMENO</span>
          <button
            class="g-letter-btn active"
            data-g-letter="all"
            type="button"
            style="padding: 6px 12px; border-radius: 8px; border: 1px solid var(--ink); background: var(--ink); color: var(--bg); font-family: var(--mono); font-size: 11px; font-weight: 600; cursor: pointer; transition: all 0.15s; min-width: 32px;"
          >
            Všetky
          </button>
          {usedLetters.map((letter) => (
            <button
              class="g-letter-btn"
              data-g-letter={letter}
              type="button"
              style="padding: 6px 10px; border-radius: 8px; border: 1px solid var(--line); background: var(--bg); color: var(--ink); font-family: var(--mono); font-size: 11px; font-weight: 600; cursor: pointer; transition: all 0.15s; min-width: 32px;"
            >
              {letter}
            </button>
          ))}
        </div>

        <!-- Pojmy zoznam -->
        <div id="glossary-list" style="display: flex; flex-direction: column; border-top: 1px solid var(--line);">
          {sortedGlossary.map((t) => (
            <details
              class="g-item faq-item"
              data-g-cat={t.category}
              data-g-letter={t.letter}
              data-g-search={t.searchText}
              style="border-bottom: 1px solid var(--line); padding: 0;"
            >
              <summary style="padding: 22px 4px; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 16px; list-style: none;">
                <div style="display: flex; align-items: center; gap: 14px; flex: 1; min-width: 0;">
                  {t.shortcut ? (
                    <span style="font-family: var(--mono); font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 6px; background: linear-gradient(135deg, var(--grad-start), var(--grad-end)); color: white; flex-shrink: 0;">
                      {t.shortcut}
                    </span>
                  ) : (
                    <span style="font-family: var(--mono); font-size: 10px; padding: 4px 10px; border-radius: 6px; background: var(--bg-soft); color: var(--muted); flex-shrink: 0;">
                      {t.term.charAt(0).toUpperCase()}
                    </span>
                  )}
                  <span style="font-size: 16px; font-weight: 600; letter-spacing: -0.01em;">{t.term}</span>
                  <span class="g-cat-tag" style="font-size: 10px; color: var(--muted); font-family: var(--mono); margin-left: auto; margin-right: 8px;">
                    {glossaryCategories.find(c => c.key === t.category)?.label.toUpperCase()}
                  </span>
                </div>
                <svg class="faq-chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; transition: transform 0.25s;" aria-hidden="true">
                  <path d="m6 9 6 6 6-6"></path>
                </svg>
              </summary>
              <div style="padding: 0 4px 22px 44px; font-size: 14px; line-height: 1.65; color: var(--muted); margin-top: -4px;">
                {t.description}
              </div>
            </details>
          ))}
        </div>

        <!-- Empty state pre filter -->
        <div id="glossary-empty" style="display: none; padding: 48px 24px; text-align: center; background: var(--bg-soft); border: 1px solid var(--line); border-radius: 16px; margin-top: 16px;">
          <p style="font-size: 15px; color: var(--muted); margin: 0;">
            Žiadny pojem nezodpovedá tomuto filtru. Skúste iné slovo alebo kategóriu.
          </p>
        </div>

      </div>

      <!-- CTA box "Nenašli ste odpoveď?" -->
      <div style="margin-top: 56px; padding: clamp(28px, 4vw, 44px); background: var(--bg-soft); border: 1px solid var(--line); border-radius: 20px; display: grid; grid-template-columns: 1fr auto; gap: 28px; align-items: center;" class="faq-cta">
        <div>
          <div class="eyebrow" style="margin-bottom: 12px;">Nenašli ste odpoveď?</div>
          <h3 class="h3" style="font-size: clamp(22px, 2.4vw, 30px); margin-bottom: 8px;">
            Napíšte nám priamo.
          </h3>
          <p class="body" style="font-size: 14px; max-width: 50ch; margin-bottom: 8px;">
            Konkrétne otázky o vašom prípade vždy odpovieme do 24 hodín. Bez predajného tlaku.
          </p>
          <a href="mailto:info@adlify.eu" class="num" style="font-family: var(--mono); font-size: 13px; color: var(--ink); font-weight: 600; text-decoration: underline;">
            info@adlify.eu
          </a>
        </div>
        <a href="/kontakt#formular" class="btn btn-grad" style="white-space: nowrap;">
          Otvoriť formulár
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>

    <style>
      .faq-tab:hover:not(.active) { background: var(--bg) !important; }
      details[open] .faq-chev { transform: rotate(180deg); }
      details > summary::-webkit-details-marker { display: none; }
      .g-cat-btn:hover:not(.active), .g-letter-btn:hover:not(.active) {
        border-color: var(--ink-2) !important;
      }
      #glossary-search:focus { border-color: var(--ink) !important; }
      @media (max-width: 600px) {
        .faq-cta { grid-template-columns: 1fr !important; }
        .g-cat-tag { display: none; }
      }
    </style>
  </section>


  <ContactSection accent="audit" />


  <!-- Tab switcher + Slovník search/filter -->
  <script is:inline>
    (function () {
      const tabs  = document.querySelectorAll('[data-faq-tab]');
      const panes = document.querySelectorAll('[data-faq-pane]');
      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const key = tab.dataset.faqTab;
          tabs.forEach((t) => {
            const isActive = t === tab;
            t.classList.toggle('active', isActive);
            t.style.background = isActive ? 'var(--ink)' : 'transparent';
            t.style.color = isActive ? 'var(--bg)' : 'var(--ink)';
            // Update count badge background
            const badge = t.querySelector('.num');
            if (badge) badge.style.background = isActive ? 'rgba(255,255,255,0.15)' : 'var(--bg)';
          });
          panes.forEach((p) => {
            const isMatch = p.dataset.faqPane === key;
            p.style.display = isMatch ? 'block' : 'none';
            p.classList.toggle('active', isMatch);
          });
        });
      });
    })();

    // Slovník: search + kategória + abeceda
    (function () {
      const searchInput = document.getElementById('glossary-search');
      const items = document.querySelectorAll('.g-item');
      const empty = document.getElementById('glossary-empty');
      const catBtns = document.querySelectorAll('.g-cat-btn');
      const letterBtns = document.querySelectorAll('.g-letter-btn');

      if (!searchInput || !items.length) return;

      let activeCategory = 'all';
      let activeLetter = 'all';
      let activeSearch = '';

      function applyFilters() {
        let visibleCount = 0;
        items.forEach((item) => {
          const cat = item.dataset.gCat || '';
          const letter = item.dataset.gLetter || '';
          const search = item.dataset.gSearch || '';

          const catMatch    = activeCategory === 'all' || cat === activeCategory;
          const letterMatch = activeLetter === 'all'   || letter === activeLetter;
          const searchMatch = activeSearch === ''      || search.includes(activeSearch);

          const show = catMatch && letterMatch && searchMatch;
          item.style.display = show ? '' : 'none';
          if (show) visibleCount++;
        });

        if (empty) empty.style.display = visibleCount === 0 ? 'block' : 'none';
      }

      // Search input
      searchInput.addEventListener('input', () => {
        activeSearch = searchInput.value.trim().toLowerCase();
        applyFilters();
      });

      // Kategórie buttons
      catBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          activeCategory = btn.dataset.gCat || 'all';
          catBtns.forEach((b) => {
            const isActive = b === btn;
            b.classList.toggle('active', isActive);
            b.style.background = isActive ? 'var(--ink)' : 'var(--bg)';
            b.style.color      = isActive ? 'var(--bg)' : 'var(--ink)';
            b.style.borderColor = isActive ? 'var(--ink)' : 'var(--line)';
          });
          applyFilters();
        });
      });

      // Abeceda buttons
      letterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          activeLetter = btn.dataset.gLetter || 'all';
          letterBtns.forEach((b) => {
            const isActive = b === btn;
            b.classList.toggle('active', isActive);
            b.style.background = isActive ? 'var(--ink)' : 'var(--bg)';
            b.style.color      = isActive ? 'var(--bg)' : 'var(--ink)';
            b.style.borderColor = isActive ? 'var(--ink)' : 'var(--line)';
          });
          applyFilters();
        });
      });
    })();
  </script>

</Layout>
