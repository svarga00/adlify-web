---
import BlogDetail from '../../components/pages/BlogDetail.astro';
import { fetchAllPosts } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await fetchAllPosts('sk');
  return posts.map((p) => ({
    params: { slug: p.slug },
    props:  { post: p },
  }));
}

const { post } = Astro.props;
---
<BlogDetail post={post} lang="sk" />
