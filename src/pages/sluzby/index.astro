---
/**
 * /sluzby — Služby listing
 *
 * REFACTOROVANÉ: dáta zo Supabase (web_services).
 * Linky vedú na detail /sluzby/[slug].
 */

import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import ServicesAccordion from '../../components/ServicesAccordion.astro';
import ProcessGrid from '../../components/ProcessGrid.astro';
import ContactSection from '../../components/ContactSection.astro';
import { fetchAllServices } from '../../lib/content';

const services = await fetchAllServices();
---

<Layout
  title="Služby — Adlify"
  description="Google Ads, Meta Ads, SEO, e-mailové kampane, meranie a vstupné stránky. Postaráme sa o všetko, čo vám prinesie zákazníkov."
  lang="sk"
  pathname="/sluzby"
>

  <PageHero
    num="002"
    kind="SERVICES"
    title="Čo pre vás vieme"
    titleAccent="zariadiť."
    lead="Postaráme sa o všetko, čo vám prinesie zákazníkov. Vy len sledujete čísla — my dolaďujeme detaily."
  />

  <ServicesAccordion services={services} linkToDetail={true} />

  <ProcessGrid background="soft" />

  <ContactSection accent="audit" />

</Layout>
