---
/**
 * /sluzby/[slug] — detail služby
 *
 * Generuje sa cez getStaticPaths zo Supabase data.
 */

import Layout from '../../layouts/Layout.astro';
import ContactSection from '../../components/ContactSection.astro';
import { fetchAllServices, type Service } from '../../lib/content';

export async function getStaticPaths() {
  const services = await fetchAllServices();
  return services.map((s) => ({
    params: { slug: s.slug },
    props:  { service: s },
  }));
}

interface Props {
  service: Service;
}

const { service: s } = Astro.props;
---

<Layout
  title={`${s.title} — Služby | Adlify`}
  description={s.short_desc}
  lang="sk"
  pathname={`/sluzby/${s.slug}`}
>

  <!-- ============================================
       HERO
       ============================================ -->
  <section class="section" style="padding-top: clamp(60px, 7vw, 100px); padding-bottom: clamp(40px, 5vw, 64px);">
    <div class="container">

      <!-- Breadcrumb -->
      <a href="/sluzby" style="display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; background: var(--bg-soft); border: 1px solid var(--line); border-radius: 999px; font-family: var(--mono); font-size: 11px; color: var(--ink); margin-bottom: 32px; text-decoration: none;">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m15 18-6-6 6-6"></path>
        </svg>
        Späť na služby
      </a>

      <div class="svc-hero" style="display: grid; grid-template-columns: 1fr 280px; gap: 48px; align-items: end;">
        <div>
          <!-- Eyebrow + ikonka -->
          <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 24px;">
            <div style="width: 64px; height: 64px; border-radius: 16px; background: linear-gradient(135deg, var(--grad-start), var(--grad-end)); color: white; display: flex; align-items: center; justify-content: center; box-shadow: 0 12px 24px -10px rgba(241,100,52,0.4);">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon_svg} aria-hidden="true"></svg>
            </div>
            <div>
              <div class="eyebrow" style="margin-bottom: 4px;">[ SERVICE ]</div>
              <div style="font-family: var(--mono); font-size: 13px; color: var(--muted);">{s.pricing_note || 'Súčasť každého plánu'}</div>
            </div>
          </div>

          <!-- Title -->
          <h1 style="font-size: clamp(48px, 7vw, 96px); font-weight: 700; letter-spacing: -0.04em; line-height: 0.98; margin-bottom: 24px;">
            {s.title}
          </h1>

          <!-- Lead -->
          <p style="font-size: clamp(17px, 1.7vw, 22px); color: var(--muted); line-height: 1.5; max-width: 60ch;">
            {s.hero_lead || s.short_desc}
          </p>
        </div>

        <!-- Specs sidebar -->
        <aside style="background: var(--bg-soft); border: 1px solid var(--line); border-radius: 20px; padding: 28px;" class="svc-specs">
          <div class="eyebrow" style="margin-bottom: 20px;">[ Zhrnutie ]</div>
          <div style="display: flex; flex-direction: column; gap: 18px;">
            {s.specs.map((sp) => (
              <div>
                <div style="font-size: 11px; font-family: var(--mono); color: var(--muted); margin-bottom: 4px; letter-spacing: 0.04em;">{sp.label}</div>
                <div style="font-size: 15px; font-weight: 600;">{sp.value}</div>
              </div>
            ))}
          </div>
        </aside>
      </div>

      <style>
        @media (max-width: 900px) {
          .svc-hero { grid-template-columns: 1fr !important; }
          .svc-specs { order: 2; }
        }
      </style>
    </div>
  </section>


  <!-- ============================================
       ČO ZÍSKATE
       ============================================ -->
  {s.what_you_get && s.what_you_get.length > 0 && (
    <section class="section" style="background: var(--bg-soft);">
      <div class="container">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 48px;">
          <span class="eyebrow">[ 01 — Čo získate ]</span>
          <span style="flex: 1; height: 1px; background: var(--line);"></span>
        </div>

        <h2 class="h1" style="max-width: 14ch; margin-bottom: 48px;">
          Čo získate <span class="grad">v cene služby.</span>
        </h2>

        <div class="get-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          {s.what_you_get.map((item) => (
            <div style="display: flex; align-items: flex-start; gap: 14px; padding: 20px 24px; background: var(--bg); border: 1px solid var(--line); border-radius: 14px;">
              <div style="width: 28px; height: 28px; border-radius: 50%; background: linear-gradient(135deg, var(--grad-start), var(--grad-end)); color: white; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 1px;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <span style="font-size: 15px; line-height: 1.5; font-weight: 500;">{item}</span>
            </div>
          ))}
        </div>
      </div>

      <style>
        @media (max-width: 720px) { .get-grid { grid-template-columns: 1fr !important; } }
      </style>
    </section>
  )}


  <!-- ============================================
       PROCES — kroky
       ============================================ -->
  {s.process_steps && s.process_steps.length > 0 && (
    <section class="section">
      <div class="container">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 48px;">
          <span class="eyebrow">[ 02 — Proces ]</span>
          <span style="flex: 1; height: 1px; background: var(--line);"></span>
        </div>

        <h2 class="h1" style="max-width: 16ch; margin-bottom: 48px;">
          Ako to <span class="grad">prebieha.</span>
        </h2>

        <div class="process-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px;">
          {s.process_steps.map((step, i) => (
            <article style="background: var(--bg-soft); border: 1px solid var(--line); border-radius: 20px; padding: 32px; position: relative; overflow: hidden;">
              <div aria-hidden="true" style="position: absolute; top: -30px; right: -30px; width: 140px; height: 140px; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--grad-start) 14%, transparent), transparent 70%); pointer-events: none;"></div>
              <div style="position: relative;">
                <div style="font-family: var(--mono); font-size: 11px; color: var(--muted); margin-bottom: 12px;">STEP / {String(i + 1).padStart(2, '0')}</div>
                <div class="num grad" style="font-size: 48px; font-weight: 700; letter-spacing: -0.03em; line-height: 1; margin-bottom: 16px;">{String(i + 1).padStart(2, '0')}</div>
                <h3 class="h3" style="margin-bottom: 12px;">{step.title}</h3>
                <p class="body" style="font-size: 14px;">{step.desc}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}


  <!-- ============================================
       FAQ
       ============================================ -->
  {s.faq && s.faq.length > 0 && (
    <section class="section" style="background: var(--bg-soft);">
      <div class="container" style="max-width: 880px;">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 48px;">
          <span class="eyebrow">[ 03 — Časté otázky ]</span>
          <span style="flex: 1; height: 1px; background: var(--line);"></span>
        </div>

        <div class="faq-list" style="display: flex; flex-direction: column; gap: 12px;">
          {s.faq.map((item, i) => (
            <details class="faq-item" style="background: var(--bg); border: 1px solid var(--line); border-radius: 16px; overflow: hidden;" open={i === 0}>
              <summary style="padding: 24px 28px; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 16px; font-size: 17px; font-weight: 600; letter-spacing: -0.01em; list-style: none;">
                <span>{item.q}</span>
                <svg class="faq-chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; transition: transform 0.25s;" aria-hidden="true">
                  <path d="m6 9 6 6 6-6"></path>
                </svg>
              </summary>
              <div style="padding: 0 28px 24px; font-size: 15px; line-height: 1.6; color: var(--muted);">
                {item.a}
              </div>
            </details>
          ))}
        </div>
      </div>

      <style>
        details[open] .faq-chev { transform: rotate(180deg); }
        details > summary::-webkit-details-marker { display: none; }
      </style>
    </section>
  )}


  <ContactSection accent="audit" />

</Layout>
