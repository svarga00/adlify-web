---
import ServiceDetail from '../../components/pages/ServiceDetail.astro';
import { fetchAllServices } from '../../lib/content';

export async function getStaticPaths() {
  const services = await fetchAllServices('sk');
  return services.map((s) => ({
    params: { slug: s.slug },
    props:  { service: s },
  }));
}

const { service } = Astro.props;
---
<ServiceDetail service={service} lang="sk" />
