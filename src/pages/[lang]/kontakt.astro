---
import Contact from '../../components/pages/Contact.astro';
import type { Lang } from '../../lib/i18n';

export async function getStaticPaths() {
  return [
    { params: { lang: 'cs' } },
    { params: { lang: 'hu' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
---
<Contact lang={lang} />
