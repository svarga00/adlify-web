---
import BlogDetail from '../../../components/pages/BlogDetail.astro';
import { fetchAllPosts } from '../../../lib/content';
import type { Lang } from '../../../lib/i18n';

export async function getStaticPaths() {
  const langs: Lang[] = ['cs', 'hu', 'en', 'de'];
  const paths = [];
  for (const lang of langs) {
    const posts = await fetchAllPosts(lang);
    for (const p of posts) {
      paths.push({
        params: { lang, slug: p.slug },
        props:  { post: p },
      });
    }
  }
  return paths;
}

const { post } = Astro.props;
const { lang } = Astro.params as { lang: Lang };
---
<BlogDetail post={post} lang={lang} />
