---
import Cases from '../../../components/pages/Cases.astro';
import { EXTRA_LANGS, type Lang } from '../../../lib/i18n';

export async function getStaticPaths() {
  return EXTRA_LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
---
<Cases lang={lang} />
