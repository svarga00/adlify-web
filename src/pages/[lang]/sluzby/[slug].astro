---
import ServiceDetail from '../../../components/pages/ServiceDetail.astro';
import { SERVICE_DETAILS, SERVICE_DETAIL_SLUGS } from '../../../data/serviceDetails';
import { EXTRA_LANGS, type Lang } from '../../../lib/i18n';

export async function getStaticPaths() {
  const langs = EXTRA_LANGS;
  const paths = [];
  for (const lang of langs) {
    for (const slug of SERVICE_DETAIL_SLUGS) {
      paths.push({ params: { lang, slug } });
    }
  }
  return paths;
}

const { lang, slug } = Astro.params as { lang: Lang; slug: string };
const service = SERVICE_DETAILS[slug];
if (!service) {
  return Astro.redirect(`/${lang}/sluzby`);
}
---
<ServiceDetail service={service} lang={lang} />
