      <!-- Split: hlavné CTA vľavo + 4 ci-chan boxy vpravo -->
      <div class="contact-split">
        <!-- Hlavné CTA -->
        <a href="/kontakt" class="contact-cta">
          <div aria-hidden="true" class="contact-cta-orb"></div>
          <div style="position: relative;">
            <div class="eyebrow" style="opacity: 0.55; color: var(--bg); margin-bottom: 20px;">[ Hlavné CTA ]</div>
            <div style="font-size: clamp(26px, 3vw, 40px); font-weight: 600; letter-spacing: -0.025em; line-height: 1.1; margin-bottom: 24px; max-width: 16ch;">
              Otvoriť formulár<br>a napísať nám za 60 sekúnd
            </div>
            <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 32px;">
              <div style="display: flex; align-items: center; gap: 10px; font-size: 14px; opacity: 0.7;">
                <span style="width: 8px; height: 8px; border-radius: 50%; background: rgb(34, 197, 94); box-shadow: 0 0 12px rgb(34, 197, 94);"></span>
                <span>
                  <span class="num" style="font-weight: 600; color: var(--bg);">1</span> voľná konzultácia tento týždeň
                </span>
              </div>
              <div style="width: 56px; height: 56px; border-radius: 50%; background: linear-gradient(100deg, var(--grad-start), var(--grad-end)); display: flex; align-items: center; justify-content: center;">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 17 17 7"></path>
                  <path d="M7 7h10v10"></path>
