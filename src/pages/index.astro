---
/**
 * HOMEPAGE — SK verzia (root /).
 *
 * Sekcie tejto dávky (1–4 z 12):
 *   1. Hero (s animovaným chart cardom)
 *   2. Trust ticker (logos marquee)
 *   3. Stats riadok (4 čísla)
 *   4. Manifest (čierna sekcia + 4 metric cards)
 *
 * Obsah je zatiaľ SK-only hardcoded; v ďalšej etape sa nahradí
 * fetchom z Supabase tabuliek `web_*`.
 */

import Layout from '../layouts/Layout.astro';

const trustLogos = [
  'Zlatka.sk', 'NovaShop', 'Bonsai Lab', 'Krajčírstvo', 'Kaffe & Co',
  'EkoDom', 'Motorista', 'Drevárik', 'OptikaPro', 'TechPark',
  'Bicykle SK', 'Kvetinár',
];

const stats = [
  { label: 'Spustených kampaní',  value: '847',   color: 'rgb(241, 100, 52)' },
  { label: 'Priemerný ROAS',       value: '5.2×',  color: 'rgb(232, 93, 156)' },
  { label: 'Optimalizácií / mes.', value: '312',   color: 'rgb(244, 127, 63)' },
  { label: 'Uptime trackingu',     value: '99.9%', color: 'rgb(34, 197, 94)' },
];

const manifestItems = [
  { num: '48+',   label: 'Klientov od 2021' },
  { num: '€680k', label: 'Spravovaný budget / mesiac' },
  { num: '5.2×',  label: 'Priemerný ROAS' },
  { num: '7',     label: 'Krajín EÚ' },
];
---

<Layout
  title="Adlify — Výkonnostný marketing pre ambiciózne firmy"
  description="Spravujeme Google a Meta reklamy pre e-shopy a remeselníkov tak, aby ste videli, kam každé euro ide. 48+ klientov, €680k tržieb, 5.2× priemerný návrat."
  lang="sk"
  pathname="/"
>

  <!-- ============================================
       SECTION 1 — HERO
       ============================================ -->
  <section class="hero-new" style="padding-top: 32px; padding-bottom: 96px; position: relative; overflow: hidden;">
    <div class="container">

      <!-- Top eyebrow row -->
      <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 32px;">
        <div class="pill"><span class="dot"></span><span>Výkonnostný marketing pre malé a stredné firmy</span></div>
        <span style="flex: 1; height: 1px; background: var(--line); max-width: 240px;"></span>
        <span class="eyebrow">EST. 2021 · BA / PRG / BUD</span>
      </div>

      <!-- 2-col grid: text left, chart right -->
      <div class="hero-grid" style="display: grid; grid-template-columns: 1.05fr 1fr; gap: 64px; align-items: center;">

        <!-- LEFT: text -->
        <div>
          <h1 class="hero-h1" style="font-size: clamp(44px, 5.5vw, 80px); font-weight: 700; letter-spacing: -0.035em; line-height: 1.08; margin-bottom: 24px; max-width: 14ch; padding-top: 0.12em;">
            Marketing, ktorý <span class="grad" style="display: inline-block; padding: 0 0.04em; line-height: 1.08;">prináša&nbsp;čísla</span>.
          </h1>

          <p class="lead" style="font-size: clamp(17px, 1.4vw, 21px); max-width: 50ch; margin-bottom: 28px; color: var(--muted); line-height: 1.5;">
            <span style="color: var(--ink); font-weight: 600;">Bez sľubov, bez prázdnych slov, bez teórií.</span>
            Spravujeme Google a Meta reklamy pre e-shopy a remeselníkov tak, aby ste videli, kam&nbsp;každé&nbsp;euro&nbsp;ide.
          </p>

          <!-- Statický ticker pillsa -->
          <div class="hero-ticker" style="display: inline-flex; gap: 18px; padding: 10px 18px; background: var(--bg-soft); border: 1px solid var(--line); border-radius: 999px; margin-bottom: 32px; font-size: 13px; align-items: center; flex-wrap: wrap;">
            <span style="display: inline-flex; align-items: center; gap: 8px; font-family: var(--mono); color: var(--muted);">
              <span style="width: 8px; height: 8px; border-radius: 50%; background: rgb(34,197,94); box-shadow: 0 0 12px rgb(34,197,94); animation: heroPulse 2s ease infinite;"></span>
              AKTUÁLNE
            </span>
            <span style="display: inline-flex; align-items: center; gap: 8px; flex-wrap: wrap;">
              <strong style="color: var(--ink); font-weight: 700;">48+ klientov</strong>
              <span style="color: var(--muted);">·</span>
              <strong style="color: var(--ink); font-weight: 700;">€680k tržieb</strong>
              <span style="color: var(--muted);">·</span>
              <strong style="color: rgb(22, 163, 74); font-weight: 700;">5.2× návrat</strong>
            </span>
          </div>

          <!-- CTA buttons -->
          <div style="display: flex; gap: 14px; flex-wrap: wrap; align-items: center; margin-bottom: 36px;">
            <a href="/kontakt" class="btn btn-grad" style="padding: 18px 30px; font-size: 16px;">
              Získať audit zadarmo
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
            </a>
            <a href="/ako-to-funguje" class="btn btn-ghost" style="padding: 18px 24px; font-size: 16px;">
              Ako pracujeme
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
          </div>

          <!-- Social proof riadok -->
          <div style="display: flex; gap: 28px; flex-wrap: wrap; align-items: center; padding-top: 28px; border-top: 1px solid var(--line);">
            <!-- Avatary -->
            <div style="display: flex; align-items: center;">
              {['JK', 'MP', 'SV', 'LH'].map((init, idx) => (
                <div style={`width: 34px; height: 34px; border-radius: 50%; border: 2px solid var(--bg); ${idx > 0 ? 'margin-left: -10px;' : ''} background: linear-gradient(${idx * 40}deg, var(--grad-start), var(--grad-end)); display: flex; align-items: center; justify-content: center; color: white; font-size: 11px; font-weight: 700;`}>
                  {init}
                </div>
              ))}
            </div>
            <!-- Stars + rating -->
            <div>
              <div style="display: flex; gap: 2px; margin-bottom: 2px;">
                {Array.from({ length: 5 }).map(() => (
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="rgb(245,158,11)" stroke="none"><path d="M12 2 14.5 9 22 9.5 16 14.5 18 22 12 18 6 22 8 14.5 2 9.5 9.5 9z"></path></svg>
                ))}
              </div>
              <div style="font-size: 13px; color: var(--muted);">
                <span style="font-weight: 700; color: var(--ink);">4.9</span> · 48+ klientov
              </div>
            </div>
            <!-- Bez výpovednej lehoty -->
            <div style="display: flex; gap: 6px; align-items: center; font-size: 13px; color: var(--muted);">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="color: rgb(34,197,94);"><polyline points="20 6 9 17 4 12"></polyline></svg>
              Bez výpovednej lehoty
            </div>
          </div>
        </div>

        <!-- RIGHT: animated chart card -->
        <div class="hero-chart-card" style="position: relative;">
          <div style="position: relative; aspect-ratio: 1 / 1; max-width: 560px; margin-left: auto; border-radius: 28px; overflow: hidden; background: linear-gradient(180deg, #0d0d0d, #1a1a1a); border: 1px solid rgba(255,255,255,0.08); box-shadow: 0 40px 100px -30px rgba(0,0,0,0.4);">
            <!-- Soft mesh -->
            <div aria-hidden="true" style="position: absolute; inset: -10%; background: radial-gradient(circle at 30% 30%, var(--grad-start), transparent 45%), radial-gradient(circle at 70% 70%, var(--grad-end), transparent 50%); filter: blur(50px); opacity: 0.6;"></div>
            <!-- Grid -->
            <div aria-hidden="true" style="position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px); background-size: 32px 32px;"></div>

            <!-- Card content -->
            <div style="position: absolute; inset: 0; padding: 32px; color: white; display: flex; flex-direction: column;">

              <!-- Header -->
              <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px;">
                <div>
                  <div style="font-family: var(--mono); font-size: 10px; opacity: 0.55; letter-spacing: 0.05em; margin-bottom: 6px;">LIVE · TÝŽDEŇ 17/2026</div>
                  <div style="font-size: 16px; font-weight: 500; opacity: 0.92; margin-bottom: 14px;">Agregovaný dashboard</div>
                  <div style="display: flex; align-items: baseline; gap: 10px;">
                    <div style="font-size: clamp(28px, 3.5vw, 40px); font-weight: 700; letter-spacing: -0.02em;">€680&nbsp;000</div>
                    <div style="font-size: 13px; font-weight: 700; color: rgb(134,239,172); font-family: var(--mono);">+312%</div>
                  </div>
                </div>
                <div style="padding: 5px 11px; border: 1px solid rgba(255,255,255,0.18); border-radius: 999px; font-size: 10px; font-family: var(--mono); display: flex; align-items: center; gap: 6px; flex-shrink: 0;">
                  <span style="width: 6px; height: 6px; border-radius: 50%; background: rgb(34,197,94); box-shadow: 0 0 10px rgb(34,197,94); animation: heroPulse 2s infinite ease;"></span>
                  LIVE
                </div>
              </div>

              <!-- Months row -->
              <div style="display: flex; gap: 4px; font-family: var(--mono); font-size: 9px; opacity: 0.4; margin-bottom: 8px;">
                {['JAN', 'FEB', 'MAR', 'APR', 'MÁJ', 'JÚN', 'JÚL', 'AUG', 'SEP', 'OKT', 'NOV', 'DEC'].map((m) => (
                  <div style="flex: 1; text-align: center;">{m}</div>
                ))}
              </div>

              <!-- Bars -->
              <div style="flex: 1; position: relative; min-height: 200px;">
                <!-- Trend line -->
                <svg viewBox="0 0 100 100" preserveAspectRatio="none" style="position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none;">
                  <path d="M2 92 L10 86 L18 78 L26 70 L34 64 L42 56 L50 48 L58 38 L66 32 L74 26 L82 18 L92 10" fill="none" stroke="rgba(255,255,255,0.25)" stroke-width="0.5" stroke-dasharray="1.5 1.5" />
                </svg>
                <!-- Bars container -->
                <div data-hero-bars style="position: absolute; inset: 0; display: flex; gap: 6px; align-items: flex-end;">
                  {Array.from({ length: 12 }).map((_, i) => {
                    // Stúpajúce výšky 12% → 96%
                    const height = 12 + (i * 84) / 11;
                    return (
                      <div
                        class="hero-bar"
                        style={`flex: 1; background: linear-gradient(180deg, var(--grad-start), var(--grad-end)); border-radius: 6px 6px 2px 2px; box-shadow: 0 -8px 24px -10px var(--grad-start); height: ${height}%; transition: height 0.8s cubic-bezier(0.2,0.8,0.2,1) ${i * 0.04}s;`}
                      ></div>
                    );
                  })}
                </div>
              </div>

            </div>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- ============================================
       SECTION 2 — TRUST TICKER (logos marquee)
       ============================================ -->
  <section style="padding-bottom: 80px;">
    <div class="container" style="margin-bottom: 32px;">
      <div style="display: flex; align-items: center; gap: 16px;">
        <span class="eyebrow">Dôverujú nám</span>
        <span style="flex: 1; height: 1px; background: var(--line);"></span>
      </div>
    </div>
    <div class="marquee">
      <div class="marquee-track">
        <!-- Renderujeme dvojnásobne pre seamless loop -->
        {[...trustLogos, ...trustLogos].map((logo) => (
          <div style="display: flex; align-items: center; gap: 64px;">
            <span style="font-size: 34px; font-weight: 700; color: var(--muted-2); letter-spacing: -0.02em;">{logo}</span>
            <span style="width: 6px; height: 6px; border-radius: 50%; background: var(--line-2);"></span>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ============================================
       SECTION 3 — STATS RIADOK (4 čísla)
       ============================================ -->
  <section style="padding: 64px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--bg); position: relative; overflow: hidden;">
    <!-- Pozadie: jemná mriežka s radial mask -->
    <div aria-hidden="true" style="position: absolute; inset: 0; background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: 120px 120px; opacity: 0.4; mask-image: radial-gradient(black 30%, transparent 80%); -webkit-mask-image: radial-gradient(black 30%, transparent 80%);"></div>

    <div class="container" style="position: relative;">
      <div class="tick-grid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px;">
        {stats.map((s) => (
          <div style="text-align: center;">
            <div class="eyebrow" style="margin-bottom: 14px;">{s.label}</div>
            <div class="num" style="font-size: clamp(40px, 5vw, 72px); font-weight: 700; letter-spacing: -0.03em; line-height: 1;">
              <span style={`color: ${s.color};`}>{s.value}</span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <style>
      @media (max-width: 780px) {
        .tick-grid { grid-template-columns: 1fr 1fr !important; }
      }
    </style>
  </section>


  <!-- ============================================
       SECTION 4 — MANIFEST (čierna)
       ============================================ -->
  <section class="section" style="background: var(--ink); color: var(--bg);">
    <div class="container">

      <!-- Eyebrow -->
      <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 40px;">
        <span style="font-family: var(--mono); font-size: 12px; opacity: 0.6;">[ 01 — MANIFEST ]</span>
        <span style="flex: 1; height: 1px; background: rgba(255, 255, 255, 0.15);"></span>
      </div>

      <!-- Hlavný headline -->
      <div class="rv" style="font-size: clamp(32px, 4.5vw, 68px); font-weight: 500; letter-spacing: -0.03em; line-height: 1.1; max-width: 22ch;">
        Výkonnostný marketing
        <span style="opacity: 0.4;">bez zbytočných prezentácií, prázdnych mítingov a magických čísel.</span>
        <span class="grad">Len to, čo prináša tržby.</span>
      </div>

      <!-- 4-card grid -->
      <div class="manifest-grid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 16px; overflow: hidden; margin-top: 64px;">
        {manifestItems.map((item, idx) => (
          <div style="padding: 32px; background: var(--ink);">
            <div style="font-family: var(--mono); font-size: 11px; opacity: 0.5; margin-bottom: 16px;">[ {String(idx + 1).padStart(2, '0')} ]</div>
            <div class="num" style="font-size: clamp(40px, 4vw, 64px); font-weight: 700; letter-spacing: -0.03em; line-height: 1;">{item.num}</div>
            <div style="font-size: 13px; opacity: 0.7; margin-top: 12px;">{item.label}</div>
          </div>
        ))}
      </div>
    </div>

    <style>
      @media (max-width: 760px) {
        .manifest-grid { grid-template-columns: 1fr 1fr !important; }
      }
    </style>
  </section>


  <!-- ============================================
       SECTION 5 — PRED A PO (NovaShop interaktívne)
       ============================================ -->
  <section class="section" style="background: var(--bg-soft); position: relative; overflow: hidden;">
    <!-- Pozadie radial gradient -->
    <div aria-hidden="true" style="position: absolute; inset: 0; background-image: radial-gradient(circle at 20% 30%, color-mix(in srgb, var(--grad-start) 8%, transparent), transparent 50%), radial-gradient(circle at 80% 70%, color-mix(in srgb, var(--grad-end) 8%, transparent), transparent 50%); pointer-events: none;"></div>

    <div class="container" style="position: relative;">
      <!-- Eyebrow -->
      <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 32px;">
        <span class="eyebrow">[ INTERAKTÍVNE — REÁLNY KLIENT ]</span>
        <span style="flex: 1; height: 1px; background: var(--line);"></span>
        <span class="pill" style="background: var(--bg); border: 1px solid var(--line);">
          <span class="dot" style="background: rgb(34, 197, 94);"></span>
          <span style="font-size: 11px; font-family: var(--mono);">LIVE DATA</span>
        </span>
      </div>

      <div class="ba-grid">
        <!-- LEFT: text + metriky + timeline -->
        <div>
          <h2 class="h1" style="max-width: 11ch; margin-bottom: 20px;">
            Pred a <span class="grad">po.</span>
          </h2>
          <p class="lead" style="color: var(--muted); max-width: 38ch; margin-bottom: 32px;">
            NovaShop. 6 mesiacov spolupráce. <strong style="color: var(--ink);">Pretiahni posuvník</strong> a sleduj, ako sa menia čísla.
          </p>

          <!-- 4 metriky -->
          <div class="ba-metrics-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 32px;">
            <div class="ba-metric">
              <div class="eyebrow" style="margin-bottom: 6px; font-size: 10px;">MESAČNÉ TRŽBY</div>
              <div class="num" data-ba-metric="revenue" style="font-size: 22px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.1;">€34&nbsp;939</div>
              <div data-ba-delta="revenue" style="font-size: 11px; font-family: var(--mono); font-weight: 600; color: rgb(22, 163, 74); margin-top: 4px;">+27%</div>
            </div>
            <div class="ba-metric">
              <div class="eyebrow" style="margin-bottom: 6px; font-size: 10px;">ROAS</div>
              <div class="num" data-ba-metric="roas" style="font-size: 22px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.1;">2.52×</div>
              <div data-ba-delta="roas" style="font-size: 11px; font-family: var(--mono); font-weight: 600; color: rgb(22, 163, 74); margin-top: 4px;">+20%</div>
            </div>
            <div class="ba-metric">
              <div class="eyebrow" style="margin-bottom: 6px; font-size: 10px;">KONVERZIE</div>
              <div class="num" data-ba-metric="conv" style="font-size: 22px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.1;">380</div>
              <div data-ba-delta="conv" style="font-size: 11px; font-family: var(--mono); font-weight: 600; color: rgb(22, 163, 74); margin-top: 4px;">+51%</div>
            </div>
            <div class="ba-metric">
              <div class="eyebrow" style="margin-bottom: 6px; font-size: 10px;">CPA</div>
              <div class="num" data-ba-metric="cpa" style="font-size: 22px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.1;">€17.0</div>
              <div data-ba-delta="cpa" style="font-size: 11px; font-family: var(--mono); font-weight: 600; color: rgb(22, 163, 74); margin-top: 4px;">−7%</div>
            </div>
          </div>

          <!-- Timeline -->
          <div>
            <div class="eyebrow" style="margin-bottom: 10px;">Časová os</div>
            <div class="ba-timeline" style="display: flex; gap: 4px; margin-bottom: 6px;">
              {['MAR', 'APR', 'MÁJ', 'JÚN', 'JÚL', 'AUG', 'SEP', 'OKT'].map((m, i) => (
                <button
                  class={`ba-month ${i < 2 ? 'active' : ''}`}
                  data-ba-month={i}
                  type="button"
                >
                  {m}
                </button>
              ))}
            </div>
            <div data-ba-month-label style="font-size: 12px; color: var(--muted); font-family: var(--mono);">Mesiac 2/8</div>
          </div>
        </div>

        <!-- RIGHT: dashboard preview card -->
        <div class="ba-dashboard">
          <div class="ba-dashboard-mesh"></div>
          <div class="ba-dashboard-grid"></div>

          <div style="position: relative; display: flex; flex-direction: column; height: 100%; min-height: 416px;">
            <!-- Header -->
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px;">
              <div>
                <div style="font-family: var(--mono); font-size: 10px; opacity: 0.55; letter-spacing: 0.05em; margin-bottom: 6px;">NOVASHOP · DASHBOARD</div>
                <div data-ba-dash-month style="font-size: 18px; font-weight: 600; opacity: 0.92; margin-bottom: 14px;">Apríl 2026</div>
                <div style="display: flex; align-items: baseline; gap: 10px;">
                  <div data-ba-dash-revenue style="font-size: clamp(28px, 3.5vw, 40px); font-weight: 700; letter-spacing: -0.02em;">€34&nbsp;939</div>
                  <div data-ba-dash-delta style="font-size: 13px; font-weight: 700; color: rgb(134,239,172); font-family: var(--mono);">+27%</div>
                </div>
              </div>
              <div style="padding: 5px 11px; border: 1px solid rgba(255,255,255,0.18); border-radius: 999px; font-size: 10px; font-family: var(--mono); display: flex; align-items: center; gap: 6px; flex-shrink: 0;">
                <span style="width: 6px; height: 6px; border-radius: 50%; background: rgb(34,197,94); box-shadow: 0 0 10px rgb(34,197,94);"></span>
                LIVE
              </div>
            </div>

            <!-- Mini-grid metrics 2×2 -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 28px;">
              <div style="padding: 14px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.06); border-radius: 12px;">
                <div style="font-family: var(--mono); font-size: 9px; opacity: 0.5; letter-spacing: 0.05em; margin-bottom: 6px;">ROAS</div>
                <div data-ba-dash-roas style="font-size: 22px; font-weight: 700; letter-spacing: -0.02em;">2.52×</div>
              </div>
              <div style="padding: 14px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.06); border-radius: 12px;">
                <div style="font-family: var(--mono); font-size: 9px; opacity: 0.5; letter-spacing: 0.05em; margin-bottom: 6px;">KONV.</div>
                <div data-ba-dash-conv style="font-size: 22px; font-weight: 700; letter-spacing: -0.02em;">380</div>
              </div>
              <div style="padding: 14px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.06); border-radius: 12px;">
                <div style="font-family: var(--mono); font-size: 9px; opacity: 0.5; letter-spacing: 0.05em; margin-bottom: 6px;">CPA</div>
                <div data-ba-dash-cpa style="font-size: 22px; font-weight: 700; letter-spacing: -0.02em;">€17.0</div>
              </div>
              <div style="padding: 14px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.06); border-radius: 12px;">
                <div style="font-family: var(--mono); font-size: 9px; opacity: 0.5; letter-spacing: 0.05em; margin-bottom: 6px;">TREND</div>
                <div style="font-size: 22px; font-weight: 700; color: rgb(134,239,172);">↗</div>
              </div>
            </div>

            <!-- Bars: weekly revenue -->
            <div style="margin-top: auto;">
