---
import CaseDetail from '../../components/pages/CaseDetail.astro';
import { fetchAllCases } from '../../lib/content';

export async function getStaticPaths() {
  const cases = await fetchAllCases('sk');
  return cases.map((c) => ({
    params: { slug: c.slug },
    props:  { caseStudy: c },
  }));
}

const { caseStudy } = Astro.props;
---
<CaseDetail caseStudy={caseStudy} lang="sk" />
