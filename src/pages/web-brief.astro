    <!-- Success -->
    <div class="done" id="done">
      <div class="check">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
      </div>
      <h2>Ďakujeme! Podklad máme.</h2>
      <p>Prešli sme si vaše predstavy a pripravíme prvý návrh. Ozveme sa vám e-mailom hneď, ako budeme mať vizuály pripravené.</p>
    </div>

    <div class="foot">ADLIFY · <a href="https://adlify.eu">adlify.eu</a></div>
  </div>

  <script>
    (function () {
      const form = document.getElementById('briefForm');
      const submitBtn = document.getElementById('submitBtn');
      const status = document.getElementById('status');
      const done = document.getElementById('done');
      const fill = document.getElementById('progressFill');
      const plabel = document.getElementById('progressLabel');

      // ── Color picker ↔ hex sync ───────────────────────────────────
      document.querySelectorAll('input[type="color"]').forEach((picker) => {
        const hexId = picker.getAttribute('data-hex');
        const hexInput = document.getElementById(hexId);
        picker.addEventListener('input', () => { hexInput.value = picker.value.toUpperCase(); updateProgress(); });
        hexInput.addEventListener('input', () => {
          let v = hexInput.value.trim();
          if (!v.startsWith('#')) v = '#' + v;
          if (/^#[0-9a-fA-F]{6}$/.test(v)) picker.value = v;
        });
      });

      // ── Color presets ─────────────────────────────────────────────
      document.querySelectorAll('#colorPresets .preset').forEach((btn) => {
        btn.addEventListener('click', () => {
          const colors = JSON.parse(btn.getAttribute('data-colors'));
          const ids = ['hexPrimary', 'hexSecondary', 'hexAccent'];
          const names = ['colorPrimary', 'colorSecondary', 'colorAccent'];
          colors.forEach((c, i) => {
            document.getElementById(ids[i]).value = c;
            document.querySelector('input[name="' + names[i] + '"]').value = c;
          });
          document.querySelectorAll('#colorPresets .preset').forEach((p) => p.classList.remove('active'));
          btn.classList.add('active');
          updateProgress();
        });
      });

      // ── "Iné…" conditional inputs ─────────────────────────────────
      // Select-based
      document.querySelectorAll('select[data-other-trigger]').forEach((sel) => {
        const box = document.querySelector('.other-input[data-other-for="' + sel.name + '"]');
        sel.addEventListener('change', () => {
          if (sel.value === 'iné') box.classList.add('show');
          else box.classList.remove('show');
          updateProgress();
        });
      });
      // Checkbox-based ("iné" chip with data-other)
      document.querySelectorAll('input[type="checkbox"][data-other]').forEach((cb) => {
        const key = cb.getAttribute('data-other');
        const box = document.querySelector('.other-input[data-other-for="' + key + '"]');
        cb.addEventListener('change', () => {
          if (cb.checked) box.classList.add('show');
          else box.classList.remove('show');
        });
      });

      // ── Progress bar ──────────────────────────────────────────────
      const tracked = Array.from(form.elements).filter((el) =>
        el.name && el.name !== '_gotcha' && el.type !== 'submit'
      );
      function updateProgress() {
        const groups = {};
        tracked.forEach((el) => {
          if (el.type === 'checkbox' || el.type === 'radio') {
            groups[el.name] = groups[el.name] || false;
            if (el.checked && el.value !== 'true') groups[el.name] = true;
            else if (el.checked) groups[el.name] = true;
          } else if (el.type === 'color') {
            // colors always count as touched-by-default; skip from %
          } else {
            groups[el.name] = (el.value || '').trim() !== '';
          }
        });
        const keys = Object.keys(groups);
        const filled = keys.filter((k) => groups[k]).length;
        const pct = keys.length ? Math.round((filled / keys.length) * 100) : 0;
        fill.style.width = pct + '%';
        plabel.textContent = pct + ' % vyplnené';
      }
      form.addEventListener('input', updateProgress);
      form.addEventListener('change', updateProgress);
      updateProgress();

      // ── Submit ────────────────────────────────────────────────────
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Validate required
        const required = ['contactName', 'contactEmail', 'companyName'];
        for (const name of required) {
          const el = form.elements[name];
          if (!el || !el.value.trim()) {
            status.style.color = 'rgb(220,38,38)';
            status.textContent = '✗ Vyplňte prosím meno, e-mail a názov firmy.';
            el && el.focus();
            return;
          }
        }
        const pt = form.querySelector('input[name="projectType"]:checked');
        if (!pt) {
          status.style.color = 'rgb(220,38,38)';
          status.textContent = '✗ Vyberte prosím typ projektu.';
          return;
        }

        submitBtn.disabled = true;
        status.style.color = 'var(--muted)';
        status.textContent = 'Odosielame…';

        // Build payload
        const fd = new FormData(form);
        const payload = {};
        const multi = ['goals', 'languages', 'markets', 'sections', 'features', 'styleKeywords', 'integrations'];
        // single-value fields
        for (const [k, v] of fd.entries()) {
          if (multi.includes(k)) {
            payload[k] = payload[k] || [];
            payload[k].push(v);
          } else {
            payload[k] = v;
          }
        }

        try {
          const res = await fetch('/.netlify/functions/web-brief', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          if (!res.ok) {
            let msg = 'Odoslanie zlyhalo (HTTP ' + res.status + ')';
            try { const j = await res.json(); if (j.error) msg = j.error; } catch (e) {}
            throw new Error(msg);
          }
          form.style.display = 'none';
          document.getElementById('progressWrap').style.display = 'none';
          done.classList.add('show');
          done.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } catch (err) {
          console.error(err);
          status.style.color = 'rgb(220,38,38)';
          status.textContent = '✗ ' + (err.message || 'Niečo zlyhalo. Skúste znova alebo napíšte na info@adlify.eu');
        } finally {
          submitBtn.disabled = false;
        }
      });
    })();
  </script>
