---
/**
 * /kontakt — Kontaktná stránka
 *
 * Sekcie:
 *  1. PageHero
 *  2. Hlavné CTA + 4 kontaktné kanály (email, telefón, WhatsApp, LinkedIn)
 *  3. Kancelária (adresa, otváracie hodiny, GPS)
 *  4. 4 ľudia s priamym kontaktom
 *  5. Obchodné údaje (firma, IČO, DIČ, banka...)
 *  6. 4 trust pillars (4 hod, GDPR, NDA, 0€)
 *  7. ContactSection
 */

import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ContactSection from '../components/ContactSection.astro';

// 4 kontaktné kanály
const channels = [
  {
    label: 'E-mail',
    value: 'hello@adlify.eu',
    sub:   'Odpoveď do 24 hod',
    href:  'mailto:hello@adlify.eu',
    icon:  '<rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path>',
  },
  {
    label: 'Telefón',
    value: '+421 905 123 456',
    sub:   'Po–Pi · 9:00–18:00',
    href:  'tel:+421905123456',
    icon:  '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 20 20 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A20 20 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7 12 12 0 0 0 .7 2.8 2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5 12 12 0 0 0 2.8.7 2 2 0 0 1 1.7 2z"></path>',
  },
  {
    label: 'WhatsApp',
    value: '+421 905 123 456',
    sub:   'Rýchla komunikácia',
    href:  'https://wa.me/421905123456',
    icon:  '<path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"></path><path d="M9 10a.5 .5 0 0 0 1 0V9a.5 .5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0-1h-1a.5 .5 0 0 0 0 1"></path>',
  },
  {
    label: 'LinkedIn',
    value: '/company/adlify',
    sub:   'Sledujte updates',
    href:  'https://linkedin.com/company/adlify',
    icon:  '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle>',
  },
];

// 4 ľudia
const people = [
  { initials: 'JK', name: 'Jakub Kováč',       role: 'Managing Partner',  email: 'jakub@adlify.eu',   phone: '+421 905 123 456' },
  { initials: 'MP', name: 'Martina Pavelková', role: 'Head of Paid Media',email: 'martina@adlify.eu', phone: '+421 905 234 567' },
  { initials: 'SV', name: 'Samuel Varga',      role: 'Head of Analytics', email: 'samuel@adlify.eu',  phone: '+421 905 345 678' },
  { initials: 'LH', name: 'Lucia Horváthová',  role: 'New Business',      email: 'lucia@adlify.eu',   phone: '+421 905 456 789' },
];

// Obchodné údaje (riadky tabuľky)
const businessData = [
  { label: 'Obchodný názov',    value: 'Adlify s.r.o.', copyable: true },
  { label: 'Sídlo spoločnosti', value: 'Štúrova 12, 811 02 Bratislava, Slovenská republika', copyable: true },
  { label: 'IČO',               value: '52 841 937', copyable: true },
  { label: 'DIČ',               value: '2121 176 842', copyable: true },
  { label: 'IČ DPH',            value: 'SK2121176842', copyable: true },
  { label: 'Bankové spojenie',  value: 'Tatra banka, a.s.', copyable: false },
  { label: 'IBAN',              value: 'SK12 1100 0000 0012 3456 7890', copyable: true },
  { label: 'SWIFT / BIC',       value: 'TATRSKBX', copyable: true },
  { label: 'Zápis v OR',        value: 'Okresný súd Bratislava I, oddiel Sro, vložka č. 142857/B', copyable: false },
  { label: 'Dátum vzniku',      value: '4. 3. 2021', copyable: false },
  { label: 'Konateľ',           value: 'Jakub Kováč', copyable: false },
];

// 4 trust pillars
const pillars = [
  {
    big:   '~4 hod',
    title: 'Priemerná doba odpovede',
    sub:   'Počas pracovných dní',
  },
  {
    big:   'GDPR',
    title: 'Dáta držíme v EÚ',
    sub:   'Frankfurt · Hetzner / AWS eu-central-1',
  },
  {
    big:   'NDA',
    title: 'Podpíšeme NDA',
    sub:   'Na požiadanie pred prvým callom',
  },
  {
    big:   '0 €',
    title: 'Prvý audit zdarma',
    sub:   'Bez záväzku, bez predajného tlaku',
  },
];
---

<Layout
  title="Kontakt — Adlify"
  description="Napíšte nám. Audit zdarma, jasné odporúčania a plán, čo by sa dalo zlepšiť. Odpovieme do 24 hodín. Bez záväzku, bez predajného tlaku."
  lang="sk"
  pathname="/kontakt"
>

  <PageHero
    num="008"
    kind="CONTACT"
    title="Napíšte nám."
    titleAccent="Odpovieme do 24 hodín."
    lead="Audit zdarma, jasné odporúčania a plán, čo by sa dalo zlepšiť. Bez záväzku, bez predajného tlaku."
  />


  <!-- ============================================
       HLAVNÉ CTA + 4 KONTAKTNÉ KANÁLY
       ============================================ -->
  <section class="section" style="padding-top: 0;">
    <div class="container">
      <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 32px;">
        <span class="pill">
          <span class="dot"></span>
          <span>LIVE · ODPOVEDÁME</span>
        </span>
        <span style="flex: 1; height: 1px; background: var(--line);"></span>
      </div>

      <div class="contact-cta-grid" style="display: grid; grid-template-columns: 1.4fr 1fr; gap: 32px; align-items: stretch;">
        <!-- Hlavné CTA blok -->
        <div style="background: var(--ink); color: var(--bg); border-radius: 24px; padding: clamp(32px, 4vw, 48px); position: relative; overflow: hidden;">
          <div aria-hidden="true" style="position: absolute; top: -60px; right: -60px; width: 320px; height: 320px; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--grad-start) 40%, transparent), transparent 65%); opacity: 0.6; pointer-events: none;"></div>
          <div style="position: relative;">
            <div class="eyebrow" style="opacity: 0.55; color: var(--bg); margin-bottom: 20px;">[ Hlavné CTA ]</div>
            <h2 style="font-size: clamp(28px, 3.6vw, 44px); font-weight: 700; letter-spacing: -0.025em; line-height: 1.1; margin-bottom: 16px;">
              Povedzte nám, čo potrebujete.
            </h2>
            <p style="font-size: 16px; opacity: 0.7; line-height: 1.55; margin-bottom: 32px; max-width: 50ch;">
              30-minútový discovery call, audit vašich účtov a jasný plán, kde sú peniaze na stole.
            </p>
            <div style="display: flex; gap: 12px; flex-wrap: wrap;">
              <button class="btn btn-grad" style="padding: 14px 22px;">
                Otvoriť formulár
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </button>
              <a href="#" class="btn btn-outline" style="border-color: rgba(255,255,255,0.18); color: var(--bg); padding: 14px 22px;">
                Rezervovať call
              </a>
            </div>
          </div>
        </div>

        <!-- 4 kanály -->
        <div style="display: flex; flex-direction: column; gap: 12px;">
          {channels.map((c) => (
            <a href={c.href} class="contact-channel" style="display: flex; align-items: center; gap: 16px; padding: 18px 22px; background: var(--bg); border: 1px solid var(--line); border-radius: 16px; color: var(--ink); transition: border-color 0.2s, transform 0.2s;">
              <div style="width: 44px; height: 44px; border-radius: 12px; background: linear-gradient(135deg, var(--grad-start), var(--grad-end)); color: white; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={c.icon} aria-hidden="true"></svg>
              </div>
              <div style="flex: 1; min-width: 0;">
                <div class="eyebrow" style="margin-bottom: 4px;">{c.label}</div>
                <div style="font-weight: 600; font-size: 15px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{c.value}</div>
                <div style="font-size: 12px; color: var(--muted); margin-top: 2px;">{c.sub}</div>
              </div>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="opacity: 0.4; flex-shrink: 0;">
                <path d="M7 17 17 7"></path>
                <path d="M7 7h10v10"></path>
              </svg>
            </a>
          ))}
        </div>
      </div>
    </div>

    <style>
      .contact-channel:hover { border-color: var(--ink) !important; transform: translateX(2px); }
      @media (max-width: 900px) {
        .contact-cta-grid { grid-template-columns: 1fr !important; }
      }
    </style>
  </section>


  <!-- ============================================
       KANCELÁRIA
       ============================================ -->
  <section class="section" style="background: var(--bg-soft);">
    <div class="container">
      <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 48px;">
        <span class="eyebrow">[ Kancelária ]</span>
        <span style="flex: 1; height: 1px; background: var(--line);"></span>
      </div>

      <div class="office-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: stretch;">
        <!-- Info -->
        <div style="background: var(--bg); border: 1px solid var(--line); border-radius: 20px; padding: clamp(28px, 3.5vw, 40px);">
          <h3 style="font-size: clamp(28px, 3vw, 40px); font-weight: 700; letter-spacing: -0.025em; line-height: 1.1; margin-bottom: 32px;">
            Bratislava<br>
            <span class="grad">Staré Mesto</span>
          </h3>

          <div style="display: flex; flex-direction: column; gap: 20px;">
            <div>
              <div class="eyebrow" style="margin-bottom: 6px;">Adresa</div>
              <div style="font-size: 16px; font-weight: 500;">Štúrova 12</div>
              <div style="font-size: 14px; color: var(--muted);">811 02 Bratislava, Slovensko</div>
            </div>
            <div>
              <div class="eyebrow" style="margin-bottom: 6px;">Otváracie hodiny</div>
              <div style="font-size: 16px; font-weight: 500;">Po–Pi 9:00–18:00</div>
              <div style="font-size: 13px; color: var(--muted);">Stretnutie si prosím rezervujte vopred</div>
            </div>
            <div>
              <div class="eyebrow" style="margin-bottom: 6px;">Káva na nás</div>
              <div style="font-size: 14px; color: var(--muted);">Urbania pod budovou, espresso bar ☕</div>
            </div>
          </div>

          <a href="https://www.google.com/maps/search/?api=1&query=Štúrova+12,+Bratislava" target="_blank" rel="noopener" class="btn btn-ink btn-sm" style="margin-top: 32px;">
            Navigovať v Google Maps
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 17 17 7"></path>
              <path d="M7 7h10v10"></path>
            </svg>
          </a>
        </div>

        <!-- Mapa-mock (gradient + pin) -->
        <div style="background: var(--ink); border-radius: 20px; padding: 32px; position: relative; overflow: hidden; min-height: 360px; color: var(--bg);">
          <!-- Gradient mesh pozadie -->
          <div aria-hidden="true" style="position: absolute; inset: -10%; background: radial-gradient(circle at 30% 30%, color-mix(in srgb, var(--grad-start) 40%, transparent), transparent 50%), radial-gradient(circle at 70% 70%, color-mix(in srgb, var(--grad-end) 30%, transparent), transparent 55%); filter: blur(40px); opacity: 0.5; pointer-events: none;"></div>
          <!-- Mriežka -->
          <div aria-hidden="true" style="position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,0.06) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.06) 1px, transparent 1px); background-size: 32px 32px; pointer-events: none;"></div>

          <div style="position: relative; height: 100%; display: flex; flex-direction: column;">
            <!-- Pin uprostred -->
            <div style="flex: 1; display: flex; align-items: center; justify-content: center; position: relative;">
              <div style="position: relative;">
                <!-- Vlna -->
                <div aria-hidden="true" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 120px; height: 120px; border-radius: 50%; border: 1px solid rgba(241,100,52,0.5); animation: pulse 3s ease-out infinite;"></div>
                <div aria-hidden="true" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 70px; height: 70px; border-radius: 50%; border: 1px solid rgba(241,100,52,0.7); animation: pulse 3s ease-out infinite 1s;"></div>
                <!-- Pin -->
                <div style="position: relative; width: 56px; height: 56px; border-radius: 50%; background: linear-gradient(135deg, var(--grad-start), var(--grad-end)); display: flex; align-items: center; justify-content: center; box-shadow: 0 16px 32px -10px rgba(241,100,52,0.6);">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="white" stroke="white" stroke-width="0" aria-hidden="true">
                    <path d="M12 2 14.5 9 22 9.5 16 14.5 18 22 12 18 6 22 8 14.5 2 9.5 9.5 9z"></path>
                  </svg>
                </div>
                <div style="position: absolute; top: calc(100% + 12px); left: 50%; transform: translateX(-50%); padding: 4px 10px; background: rgba(0,0,0,0.6); border: 1px solid rgba(255,255,255,0.18); border-radius: 999px; font-family: var(--mono); font-size: 10px; letter-spacing: 0.05em; white-space: nowrap;">
                  ADLIFY
                </div>
              </div>
            </div>

            <!-- GPS koordináty dole -->
            <div style="font-family: var(--mono); font-size: 11px; opacity: 0.55; padding-top: 24px; border-top: 1px solid rgba(255,255,255,0.08); display: flex; justify-content: space-between;">
              <span>48.1441° N, 17.1129° E</span>
              <span>STÚROVA 12</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <style>
      @media (max-width: 900px) {
        .office-grid { grid-template-columns: 1fr !important; }
      }
    </style>
  </section>


  <!-- ============================================
       PRIAMY KONTAKT — 4 ĽUDIA
       ============================================ -->
  <section class="section">
    <div class="container">
      <div class="sec-head">
        <div>
          <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 24px;">
            <span class="eyebrow">[ Priamy kontakt ]</span>
            <span style="flex: 1; height: 1px; background: var(--line);"></span>
          </div>
          <h2 class="h1" style="max-width: 16ch;">
            Ľudia, ktorým môžete <span class="grad">napísať priamo.</span>
          </h2>
        </div>
        <p class="lead">
          Bez recepcie, bez ticketov.<br>
          Píšte rovno tomu, kto vám vie pomôcť.
        </p>
      </div>

      <div class="people-grid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px;">
        {people.map((p, i) => (
          <a href={`mailto:${p.email}`} class="person-card" style="background: var(--bg); border: 1px solid var(--line); border-radius: 20px; padding: 28px; transition: border-color 0.2s, transform 0.2s; color: var(--ink);">
            <!-- Avatar -->
            <div style={`width: 56px; height: 56px; border-radius: 50%; background: linear-gradient(${i * 30 + 100}deg, var(--grad-start), var(--grad-end)); color: white; font-weight: 700; font-size: 18px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;`}>
              {p.initials}
            </div>

            <h3 style="font-size: 18px; font-weight: 600; letter-spacing: -0.015em; margin-bottom: 4px;">{p.name}</h3>
            <div style="font-size: 13px; color: var(--muted); margin-bottom: 16px;">{p.role}</div>

            <div style="display: flex; flex-direction: column; gap: 6px; padding-top: 16px; border-top: 1px solid var(--line);">
              <div style="font-size: 12px; font-family: var(--mono); color: var(--muted); display: flex; align-items: center; gap: 6px;">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                  <path d="m3 7 9 6 9-6"></path>
                </svg>
                <span style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">{p.email}</span>
              </div>
              <div style="font-size: 12px; font-family: var(--mono); color: var(--muted); display: flex; align-items: center; gap: 6px;">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="M22 16.9v3a2 2 0 0 1-2.2 2 20 20 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A20 20 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7 12 12 0 0 0 .7 2.8 2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5 12 12 0 0 0 2.8.7 2 2 0 0 1 1.7 2z"></path>
                </svg>
                <span>{p.phone}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>

    <style>
      .person-card:hover { border-color: var(--ink) !important; transform: translateY(-2px); }
      @media (max-width: 1024px) { .people-grid { grid-template-columns: 1fr 1fr !important; } }
      @media (max-width: 480px)  { .people-grid { grid-template-columns: 1fr !important; } }
    </style>
  </section>


  <!-- ============================================
       OBCHODNÉ ÚDAJE
       ============================================ -->
  <section class="section" style="background: var(--bg-soft);">
    <div class="container">
      <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 32px;">
        <span class="eyebrow">[ 009 ]</span>
        <span style="flex: 1; height: 1px; background: var(--line);"></span>
      </div>

      <h2 class="h1" style="max-width: 12ch; margin-bottom: 16px;">
        Obchodné <span class="grad">údaje</span>
      </h2>
      <p class="lead" style="max-width: 60ch; margin-bottom: 48px;">
        Pre fakturáciu, zmluvy a oficiálnu komunikáciu.
      </p>

      <div style="background: var(--bg); border: 1px solid var(--line); border-radius: 20px; overflow: hidden; max-width: 880px;">
        {businessData.map((row, i) => (
          <div class="biz-row" style={`display: grid; grid-template-columns: 200px 1fr auto; gap: 16px; padding: 18px 24px; align-items: center; ${i < businessData.length - 1 ? 'border-bottom: 1px solid var(--line);' : ''}`}>
            <div class="eyebrow" style="font-size: 11px;">{row.label}</div>
            <div style="font-size: 15px; font-weight: 500;">{row.value}</div>
            {row.copyable ? (
              <button class="copy-btn" data-copy={row.value} style="padding: 6px 12px; border: 1px solid var(--line); background: transparent; border-radius: 8px; font-family: var(--mono); font-size: 10px; letter-spacing: 0.05em; color: var(--muted); cursor: pointer; transition: all 0.2s;">
                COPY
              </button>
            ) : (
              <span></span>
            )}
          </div>
        ))}
      </div>
    </div>

    <style>
      .copy-btn:hover { border-color: var(--ink); color: var(--ink); }
      .copy-btn.copied { background: rgb(34, 197, 94); border-color: rgb(34, 197, 94); color: white; }
      @media (max-width: 720px) {
        .biz-row { grid-template-columns: 1fr auto !important; }
        .biz-row > .eyebrow { grid-column: 1 / -1; }
      }
    </style>
  </section>


  <!-- ============================================
       4 TRUST PILLARS
       ============================================ -->
  <section class="section">
    <div class="container">
      <div class="pillars-grid" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 20px; overflow: hidden;">
        {pillars.map((p) => (
          <div style="background: var(--bg); padding: 32px;">
            <div class="num grad" style="font-size: clamp(36px, 4vw, 56px); font-weight: 700; letter-spacing: -0.03em; line-height: 1; margin-bottom: 16px;">
              {p.big}
            </div>
            <div style="font-size: 15px; font-weight: 600; margin-bottom: 6px;">{p.title}</div>
            <div style="font-size: 13px; color: var(--muted); line-height: 1.45;">{p.sub}</div>
          </div>
        ))}
      </div>
    </div>

    <style>
      @media (max-width: 900px) {
        .pillars-grid { grid-template-columns: 1fr 1fr !important; }
      }
    </style>
  </section>


  <ContactSection accent="audit" />


  <!-- Copy-to-clipboard handler -->
  <script>
    (function () {
      document.querySelectorAll<HTMLElement>('.copy-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const text = btn.dataset.copy || '';
          try {
            await navigator.clipboard.writeText(text);
            const original = btn.textContent;
            btn.textContent = 'COPIED ✓';
            btn.classList.add('copied');
            setTimeout(() => {
              btn.textContent = original;
              btn.classList.remove('copied');
            }, 1500);
          } catch (e) {
            console.warn('Clipboard zlyhal', e);
          }
        });
      });
    })();
  </script>

</Layout>
