---
/**
 * /blog — Blog & Insights
 *
 * Sekcie:
 *  1. PageHero
 *  2. Featured article (najvrchnejší článok)
 *  3. Kategória filtre (Všetko, Google Ads, Analytika, ...)
 *  4. Grid 8 článkov (3 stĺpce × ~3 riadky)
 *  5. Newsletter CTA
 *  6. ContactSection
 */

import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ContactSection from '../components/ContactSection.astro';

const featured = {
  category:   'Google Ads',
  date:       '12. 04. 2026',
  readTime:   '12 min',
  title:      'Performance Max: kedy pomáha a kedy škodí tržbám',
  excerpt:    'PMax funguje skvele pre retailerov s kvalitným feedom. Horšie pre lead gen a brand-heavy kategórie. Kedy ho zapnúť a kedy nechať tak.',
  author:     'Peter Novák',
  initials:   'PN',
  href:       '/blog/performance-max-kedy-pomaha',
  gradient:   'linear-gradient(135deg, rgb(241, 100, 52), rgb(232, 93, 156))',
};

const categories = [
  'Všetko',
  'Google Ads',
  'Analytika',
  'Case Study',
  'Meta Ads',
  'E-mail',
  'SEO',
  'Optimalizácia',
  'Strategy',
];

const articles = [
  {
    category:  'Analytika',
    date:      '05. 04. 2026',
    readTime:  '10 min',
    title:     'Ako nastaviť meranie tak, aby ste konečne videli reálne tržby',
    excerpt:   'Bežný Google Analytics vám ukazuje cca 70 % reálnych transakcií. Pokročilé meranie a aj offline predaje.',
    author:    'Lucia Horváthová',
    href:      '/blog/meranie-realne-trzby',
    gradient:  'linear-gradient(135deg, rgb(232, 93, 156), rgb(244, 127, 63))',
  },
  {
    category:  'Case Study',
    date:      '28. 03. 2026',
    readTime:  '8 min',
    title:     'Ako sme zdvojnásobili výnosy z reklamy e-shopu so šperkami',
    excerpt:   '6 mesiacov, €84k budget, tržby z €180k na €520k. Čo fungovalo, čo nie.',
    author:    'Mária Kováčová',
    href:      '/blog/zlatka-case-study',
    gradient:  'linear-gradient(135deg, rgb(10, 10, 10), rgb(241, 100, 52))',
  },
  {
    category:  'Meta Ads',
    date:      '20. 03. 2026',
    readTime:  '9 min',
    title:     'iOS 17 a Meta Ads: čo to znamená pre váš pixel',
    excerpt:   'Atribúcia je čoraz krehkejšia. CAPI, Advanced Matching a modelling ako záchrana dát.',
    author:    'Peter Novák',
    href:      '/blog/ios-17-meta-ads',
    gradient:  'linear-gradient(135deg, rgb(244, 127, 63), rgb(232, 93, 156))',
  },
  {
    category:  'E-mail',
    date:      '15. 03. 2026',
    readTime:  '7 min',
    title:     '7 chýb v e-mail marketingu, ktoré robí 90 % e-shopov',
    excerpt:   'Neexistujúci welcome flow, zmiešaná segmentácia, žiadne A/B testovanie. Vďaka odstráneniu chýb sa email stáva najziskovejším kanálom.',
    author:    'Juraj Bartoš',
    href:      '/blog/7-chyb-email-marketing',
    gradient:  'linear-gradient(135deg, rgb(241, 100, 52), rgb(244, 127, 63))',
  },
  {
    category:  'SEO',
    date:      '08. 03. 2026',
    readTime:  '11 min',
    title:     'AI-generated content a Google: čo reálne funguje v 2026',
    excerpt:   'AI content nie je automaticky penalizovaný — ale AI slop áno. Editorial process, ktorý robíme pre klientov.',
    author:    'Lucia Horváthová',
    href:      '/blog/ai-content-seo-2026',
    gradient:  'linear-gradient(135deg, rgb(10, 10, 10), rgb(232, 93, 156))',
  },
  {
    category:  'Optimalizácia',
    date:      '01. 03. 2026',
    readTime:  '6 min',
    title:     'Heatmapy klamú. Čo sledovať namiesto toho.',
    excerpt:   'Scroll depth a click maps sú pekné ale misleading. Ako čítať skutočné user behaviour.',
    author:    'Mária Kováčová',
    href:      '/blog/heatmapy-klamu',
    gradient:  'linear-gradient(135deg, rgb(232, 93, 156), rgb(241, 100, 52))',
  },
  {
    category:  'Google Ads',
    date:      '22. 02. 2026',
    readTime:  '8 min',
    title:     'Broad match v 2026: áno alebo nie?',
    excerpt:   'S kvalitnými conversion signálmi broad match začína dávať zmysel. Kedy riskovať.',
    author:    'Peter Novák',
    href:      '/blog/broad-match-2026',
    gradient:  'linear-gradient(135deg, rgb(241, 100, 52), rgb(232, 93, 156))',
  },
  {
    category:  'Strategy',
    date:      '15. 02. 2026',
    readTime:  '9 min',
    title:     'Kedy prestať liať peniaze do reklamy a investovať do SEO',
    excerpt:   'Paid má strop. Moment, keď sa treba zamerať na dlhodobé aktíva.',
    author:    'Juraj Bartoš',
    href:      '/blog/paid-vs-seo-kedy',
    gradient:  'linear-gradient(135deg, rgb(244, 127, 63), rgb(10, 10, 10))',
  },
];
---

<Layout
  title="Blog — Adlify"
  description="Praktické know-how, ktoré môžete použiť hneď. Bez copy-paste clickbaitov. Píšeme z toho, čo reálne robíme pre klientov."
  lang="sk"
  pathname="/blog"
>

  <PageHero
    num="006"
    kind="BLOG & INSIGHTS"
    title="Praktické know-how,"
    titleAccent="ktoré môžete použiť hneď."
    lead="Bez copy-paste clickbaitov. Píšeme z toho, čo reálne robíme pre klientov."
  />


  <!-- ============================================
       FEATURED ARTICLE
       ============================================ -->
  <section style="padding-bottom: clamp(48px, 6vw, 80px);">
    <div class="container">
      <a href={featured.href} class="featured-card" style="display: grid; grid-template-columns: 1fr 1fr; gap: 0; background: var(--bg); border: 1px solid var(--line); border-radius: 24px; overflow: hidden; color: var(--ink); transition: transform 0.3s, box-shadow 0.3s;">
        <!-- Cover s gradientom -->
        <div style={`position: relative; aspect-ratio: 4 / 3; background: ${featured.gradient}; min-height: 360px;`}>
          <div aria-hidden="true" style="position: absolute; inset: 0; background-image: radial-gradient(circle at 30% 40%, rgba(255,255,255,0.25), transparent 50%);"></div>

          <!-- FEATURED badge -->
          <div style="position: absolute; top: 24px; left: 24px;">
            <span style="display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; background: rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.18); border-radius: 999px; font-family: var(--mono); font-size: 10px; font-weight: 700; letter-spacing: 0.08em; color: white;">
              <span style="width: 6px; height: 6px; border-radius: 50%; background: rgb(34,197,94); box-shadow: 0 0 10px rgb(34,197,94);"></span>
              FEATURED
            </span>
          </div>

          <!-- Read time bottom-left -->
          <div style="position: absolute; bottom: 24px; left: 24px; color: white;">
            <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
              <span style="font-family: var(--mono); font-size: 11px; font-weight: 700; letter-spacing: 0.08em; padding: 4px 10px; background: rgba(255,255,255,0.18); border-radius: 999px;">
                {featured.category.toUpperCase()}
              </span>
              <span style="font-family: var(--mono); font-size: 11px; opacity: 0.8;">·</span>
              <span style="font-family: var(--mono); font-size: 11px; opacity: 0.8;">{featured.date}</span>
              <span style="font-family: var(--mono); font-size: 11px; opacity: 0.8;">·</span>
              <span style="font-family: var(--mono); font-size: 11px; opacity: 0.8;">{featured.readTime}</span>
            </div>
          </div>
        </div>

        <!-- Content -->
        <div style="padding: clamp(32px, 4vw, 56px); display: flex; flex-direction: column; justify-content: center;">
          <h2 style="font-size: clamp(28px, 3.6vw, 44px); font-weight: 700; letter-spacing: -0.025em; line-height: 1.1; margin-bottom: 20px;">
            {featured.title}
          </h2>
          <p class="body" style="font-size: 16px; line-height: 1.6; max-width: 50ch; margin-bottom: 32px;">
            {featured.excerpt}
          </p>

          <!-- Autor + CTA -->
          <div style="display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-top: 24px; border-top: 1px solid var(--line);">
            <div style="display: flex; align-items: center; gap: 12px;">
              <div style="width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, var(--grad-start), var(--grad-end)); color: white; font-weight: 700; font-size: 13px; display: flex; align-items: center; justify-content: center;">
                {featured.initials}
              </div>
              <div>
                <div style="font-size: 14px; font-weight: 600;">{featured.author}</div>
                <div style="font-size: 12px; color: var(--muted);">Autor článku</div>
              </div>
            </div>
            <span class="btn btn-sm btn-ink">
              Čítať
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </span>
          </div>
        </div>
      </a>
    </div>

    <style>
      .featured-card:hover { transform: translateY(-4px); box-shadow: 0 32px 64px -20px rgba(0,0,0,0.18); }
      @media (max-width: 900px) {
        .featured-card { grid-template-columns: 1fr !important; }
      }
    </style>
  </section>


  <!-- ============================================
       KATEGÓRIA FILTRE + GRID 8 ČLÁNKOV
       ============================================ -->
  <section class="section" style="padding-top: 0;">
    <div class="container">

      <!-- Filtre -->
      <div class="cat-bar" style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 48px; padding-bottom: 24px; border-bottom: 1px solid var(--line);">
        {categories.map((cat, i) => (
          <button
            class={`cat-chip ${i === 0 ? 'active' : ''}`}
            data-cat-filter={cat.toLowerCase().replace(/\s+/g, '-')}
            style={`padding: 8px 16px; border-radius: 999px; font-size: 13px; font-weight: 500; border: 1px solid var(--line); background: ${i === 0 ? 'var(--ink)' : 'transparent'}; color: ${i === 0 ? 'var(--bg)' : 'var(--ink)'}; cursor: pointer; transition: all 0.2s;`}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Grid 8 článkov -->
      <div class="articles-grid" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;">
        {articles.map((a) => (
          <a
            href={a.href}
            class="article-card"
            data-cat={a.category.toLowerCase().replace(/\s+/g, '-')}
            style="background: var(--bg); border: 1px solid var(--line); border-radius: 20px; overflow: hidden; color: var(--ink); display: flex; flex-direction: column; transition: transform 0.3s, box-shadow 0.3s;"
          >
            <!-- Cover -->
            <div style={`aspect-ratio: 16 / 9; background: ${a.gradient}; position: relative; overflow: hidden;`}>
              <div aria-hidden="true" style="position: absolute; inset: 0; background-image: radial-gradient(circle at 30% 40%, rgba(255,255,255,0.2), transparent 50%);"></div>
              <div style="position: absolute; top: 16px; left: 16px;">
                <span style="display: inline-flex; padding: 4px 10px; background: rgba(0,0,0,0.45); border: 1px solid rgba(255,255,255,0.18); border-radius: 999px; font-family: var(--mono); font-size: 9px; font-weight: 700; letter-spacing: 0.08em; color: white;">
                  {a.category.toUpperCase()}
                </span>
              </div>
            </div>

            <!-- Content -->
            <div style="padding: 24px; display: flex; flex-direction: column; flex: 1;">
              <div style="display: flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: 10px; color: var(--muted); margin-bottom: 12px;">
                <span>{a.date}</span>
                <span>·</span>
                <span>{a.readTime}</span>
              </div>

              <h3 style="font-size: 18px; font-weight: 600; letter-spacing: -0.015em; line-height: 1.3; margin-bottom: 10px;">{a.title}</h3>

              <p class="body" style="font-size: 13px; line-height: 1.55; flex: 1; margin-bottom: 16px;">{a.excerpt}</p>

              <div style="display: flex; align-items: center; justify-content: space-between; padding-top: 14px; border-top: 1px solid var(--line); font-size: 12px; color: var(--muted);">
                <span>{a.author}</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 17 17 7"></path>
                  <path d="M7 7h10v10"></path>
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>

    <style>
      .article-card:hover { transform: translateY(-4px); box-shadow: 0 24px 48px -16px rgba(0,0,0,0.12); }
      .cat-chip:hover:not(.active) { background: var(--bg-soft); }
      .cat-chip.active { background: var(--ink) !important; color: var(--bg) !important; border-color: var(--ink) !important; }
      .article-card.hidden { display: none; }
      @media (max-width: 1024px) { .articles-grid { grid-template-columns: 1fr 1fr !important; } }
      @media (max-width: 600px)  { .articles-grid { grid-template-columns: 1fr !important; } }
    </style>
  </section>


  <!-- ============================================
       NEWSLETTER CTA
       ============================================ -->
  <section style="padding: clamp(56px, 7vw, 96px) 0; background: var(--bg-soft);">
    <div class="container" style="max-width: 720px; text-align: center;">
      <h2 style="font-size: clamp(28px, 4vw, 44px); font-weight: 700; letter-spacing: -0.03em; line-height: 1.15; margin-bottom: 16px; max-width: 22ch; margin-left: auto; margin-right: auto;">
        Nový článok raz za 2 týždne. <span class="grad">Bez spamu.</span>
      </h2>
      <p class="lead" style="margin-bottom: 32px;">
        Pracovné nálezy, mini case studies a veci, ktoré nás prekvapili. Odhlásiť sa dá jedným klikom.
      </p>

      <form data-newsletter-form style="display: flex; gap: 8px; max-width: 480px; margin: 0 auto; flex-wrap: wrap;">
        <input
          type="email"
          name="email"
          required
          placeholder="meno@firma.sk"
          class="field"
          style="flex: 1; min-width: 240px;"
        >
        <button type="submit" class="btn btn-grad">
          Prihlásiť
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </button>
      </form>

      <div data-newsletter-status style="margin-top: 16px; font-size: 13px; display: none;"></div>
    </div>
  </section>


  <ContactSection accent="call" />


  <!-- ============================================
       INTERACTIVITY
       ============================================ -->
  <script>
    // Kategória filter
    (function () {
      const chips = document.querySelectorAll<HTMLButtonElement>('.cat-chip');
      const cards = document.querySelectorAll<HTMLElement>('.article-card');
      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          chips.forEach((c) => c.classList.remove('active'));
          chip.classList.add('active');
          const filter = chip.dataset.catFilter;
          cards.forEach((card) => {
            const isMatch = filter === 'všetko' || card.dataset.cat === filter;
            card.classList.toggle('hidden', !isMatch);
          });
        });
      });
    })();

    // Newsletter signup (zatiaľ klientská validácia + status, neskôr ide na backend)
    (function () {
      const form = document.querySelector<HTMLFormElement>('[data-newsletter-form]');
      const status = document.querySelector<HTMLElement>('[data-newsletter-status]');
      if (!form || !status) return;
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const fd = new FormData(form);
        const email = fd.get('email') as string;
        if (!email) return;
        // TODO: napojiť na /.netlify/functions/newsletter-subscribe
        status.style.display = 'block';
        status.style.color = 'rgb(22, 163, 74)';
        status.textContent = `✓ Ďakujeme! Prihlásili sme ${email} do newslettra.`;
        form.reset();
      });
    })();
  </script>

</Layout>
