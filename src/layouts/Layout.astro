---
/**
 * Hlavný layout pre celý web Adlify.
 * Obsahuje:
 *  - <head> so SEO meta (title, description, og:*, hreflang)
 *  - sticky header s desktop navigáciou + jazykový switcher
 *  - mobile hamburger drawer
 *  - footer s CTA blokom + 4-stĺpcová navigácia
 *
 * Props:
 *  - title: string             — <title> + og:title
 *  - description: string       — meta description + og:description
 *  - lang: 'sk'|'cs'|'hu'|'en'|'de'  — aktuálny jazyk (default 'sk')
 *  - pathname: string          — aktuálna cesta (napr. "/sluzby") pre hreflang
 *  - ogImage?: string          — full URL na OG obrázok
 */

import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: 'sk' | 'cs' | 'hu' | 'en' | 'de';
  pathname?: string;
  ogImage?: string;
}

const {
  title,
  description,
  lang = 'sk',
  pathname = '/',
  ogImage = '/img/og-default.jpg',
} = Astro.props;

const SITE = 'https://adlify.eu';

// Lang config — labels, kódy, locale identifikátory
const LANGS = [
  { code: 'sk', label: 'Slovenčina', short: 'SK', locale: 'sk_SK' },
  { code: 'cs', label: 'Čeština',    short: 'CS', locale: 'cs_CZ' },
  { code: 'hu', label: 'Magyar',     short: 'HU', locale: 'hu_HU' },
  { code: 'en', label: 'English',    short: 'EN', locale: 'en_US' },
  { code: 'de', label: 'Deutsch',    short: 'DE', locale: 'de_DE' },
] as const;

// Funkcia na zostavenie URL pre konkrétny jazyk
// SK = root, ostatné majú prefix /xx/
function buildUrl(targetLang: string, path: string): string {
  // Odstráň existujúci jazykový prefix z path
  let cleanPath = path.replace(/^\/(cs|hu|en|de)(\/|$)/, '/');
  if (!cleanPath.startsWith('/')) cleanPath = '/' + cleanPath;

  if (targetLang === 'sk') return cleanPath;
  // Pre ne-SK pridáme prefix
  return `/${targetLang}${cleanPath === '/' ? '' : cleanPath}`;
}

const canonicalPath = buildUrl(lang, pathname);
const canonicalUrl = SITE + canonicalPath;

// Navigačné položky — preložené stringy
// Zatiaľ SK hardcoded, neskôr nahradíme z DB
const NAV_ITEMS = [
  { href: '/',                 label: 'Domov' },
  { href: '/sluzby',           label: 'Služby' },
  { href: '/ako-to-funguje',   label: 'Ako to funguje' },
  { href: '/pripadove-studie', label: 'Prípadové štúdie' },
  { href: '/cennik',           label: 'Cenník' },
  { href: '/o-nas',            label: 'O nás' },
  { href: '/blog',             label: 'Blog' },
];

const currentLangObj = LANGS.find((l) => l.code === lang) ?? LANGS[0];
---

<!DOCTYPE html>
<html
  lang={lang}
  data-theme="light"
  style="--grad-start: #F16434; --grad-mid: #F47F3F; --grad-end: #E85D9C;"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Canonical + hreflang -->
    <link rel="canonical" href={canonicalUrl} />
    {LANGS.map((l) => (
      <link
        rel="alternate"
        hreflang={l.code}
        href={SITE + buildUrl(l.code, pathname)}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={SITE + buildUrl('sk', pathname)}
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.startsWith('http') ? ogImage : SITE + ogImage} />
    <meta property="og:locale" content={currentLangObj.locale} />
    {LANGS.filter((l) => l.code !== lang).map((l) => (
      <meta property="og:locale:alternate" content={l.locale} />
    ))}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.startsWith('http') ? ogImage : SITE + ogImage} />

    <!-- Performance: preload assets, preconnect fonty -->
    <link rel="preload" href="/img/logo.webp" as="image" fetchpriority="high" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
  </head>

  <body>
    <!-- Scroll progress bar (gradient line) -->
    <div
      aria-hidden="true"
      id="scroll-progress"
      style="position: fixed; top: 0; left: 0; right: 0; height: 2px; z-index: 999; background: linear-gradient(90deg, var(--grad-start), var(--grad-end)); transform-origin: 0 0; transform: scaleX(0); transition: transform 0.08s linear; box-shadow: 0 0 12px color-mix(in srgb, var(--grad-start) 50%, transparent);"
    ></div>

    <!-- ============ HEADER ============ -->
    <header class="topbar">
      <div class="container topbar-row">
        <!-- Logo -->
        <a href={lang === 'sk' ? '/' : `/${lang}/`} class="brand" aria-label="Adlify">
          <img src="/img/logo.webp" alt="Adlify" style="height: 32px; width: auto;" fetchpriority="high" loading="eager" />
        </a>

        <!-- Desktop nav -->
        <nav class="main">
          {NAV_ITEMS.map((item) => {
            const href = buildUrl(lang, item.href);
            const isActive = canonicalPath === href;
            return (
              <a href={href} class={isActive ? 'active' : ''}>
                {item.label}
              </a>
            );
          })}
        </nav>

        <!-- Topbar actions -->
        <div class="topbar-actions">
          <!-- Language switcher -->
          <div style="position: relative;" id="lang-wrap">
            <button class="lang-btn" id="lang-btn" aria-haspopup="listbox" aria-expanded="false">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M3 12h18"></path>
                <path d="M12 3a14 14 0 0 1 0 18"></path>
                <path d="M12 3a14 14 0 0 0 0 18"></path>
              </svg>
              <span style="text-transform: uppercase;">{currentLangObj.short}</span>
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </button>
            <div class="lang-dd" id="lang-dd" role="listbox">
              {LANGS.map((l) => (
                <a
                  href={buildUrl(l.code, pathname)}
                  style={l.code === lang ? 'background: var(--bg-soft);' : 'background: transparent;'}
                  role="option"
                  aria-selected={l.code === lang}
                >
                  <span>{l.label}</span>
                  <span class="code">{l.short}</span>
                </a>
              ))}
            </div>
          </div>

          <!-- CTA -->
          <a href={buildUrl(lang, '/kontakt')} class="btn btn-sm btn-ink">
            Bezplatná konzultácia
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>
        </div>

        <!-- Hamburger (mobile only) -->
        <button class="hamburger" id="hamburger-btn" aria-label="Otvoriť menu">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="3" y1="6"  x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>
    </header>

    <!-- ============ MOBILE DRAWER ============ -->
    <aside class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
      <div class="mobile-drawer-header">
        <a href={lang === 'sk' ? '/' : `/${lang}/`} class="brand" aria-label="Adlify">
          <img src="/img/logo.webp" alt="Adlify" style="height: 28px; width: auto;" />
        </a>
        <button class="mobile-drawer-close" id="drawer-close-btn" aria-label="Zavrieť menu">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="18" y1="6"  x2="6"  y2="18"></line>
            <line x1="6"  y1="6"  x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <nav>
        {NAV_ITEMS.map((item) => {
          const href = buildUrl(lang, item.href);
          const isActive = canonicalPath === href;
          return (
            <a href={href} class={isActive ? 'active' : ''}>
              <span>{item.label}</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m9 18 6-6-6-6"></path>
              </svg>
            </a>
          );
        })}
      </nav>

      <div class="mobile-drawer-footer">
        <div class="mobile-drawer-lang">
          {LANGS.map((l) => (
            <a
              href={buildUrl(l.code, pathname)}
              class={l.code === lang ? 'active' : ''}
            >
              {l.short}
            </a>
          ))}
        </div>
        <a href={buildUrl(lang, '/kontakt')} class="btn btn-grad" style="justify-content: center;">
          Bezplatná konzultácia
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </aside>

    <!-- ============ MAIN CONTENT ============ -->
    <main>
      <slot />
    </main>

    <!-- ============ FOOTER ============ -->
    <footer class="footer">
      <div class="container">
        <!-- CTA strip -->
        <a href={buildUrl(lang, '/kontakt')} class="footer-cta">
          <div>
            <div class="eyebrow" style="opacity: 0.55; color: var(--bg); margin-bottom: 12px;">[ NESTRÁCAJTE ČAS ]</div>
            <div style="font-size: clamp(28px, 4vw, 48px); font-weight: 700; letter-spacing: -0.03em; line-height: 1.1;">
              Bezplatný audit za 30 min
            </div>
          </div>
          <div style="display: flex; align-items: center; gap: 16px;">
            <div style="text-align: right; font-size: 13px; opacity: 0.7;">
              <div class="mono">E-MAIL</div>
              <div style="font-weight: 600; opacity: 1; font-size: 15px;">hello@adlify.eu</div>
            </div>
            <div style="width: 56px; height: 56px; border-radius: 50%; background: linear-gradient(100deg, var(--grad-start), var(--grad-end)); display: flex; align-items: center; justify-content: center;">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7 17 17 7"></path>
                <path d="M7 7h10v10"></path>
              </svg>
            </div>
          </div>
        </a>

        <!-- 4-col footer nav -->
        <div class="footer-grid">
          <div>
            <a href={lang === 'sk' ? '/' : `/${lang}/`} aria-label="Adlify domov">
              <img src="/img/logo.webp" alt="Adlify" style="height: 32px; width: auto; margin-bottom: 20px;" />
            </a>
            <p class="body" style="font-size: 14px; max-width: 28ch; margin-bottom: 24px;">
              Výkonnostný marketing bez prázdnych slov.
            </p>
            <div style="display: flex; gap: 12px;">
              <a href="#" aria-label="LinkedIn" style="width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--line); display: flex; align-items: center; justify-content: center;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
              </a>
              <a href="#" aria-label="Instagram" style="width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--line); display: flex; align-items: center; justify-content: center;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              </a>
              <a href="#" aria-label="Facebook" style="width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--line); display: flex; align-items: center; justify-content: center;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M9.198 21.5h4v-8.01h3.604l.396-3.98h-4V7.5a1 1 0 0 1 1-1h3v-4h-3a5 5 0 0 0-5 5v2.01h-2l-.396 3.98h2.396v8.01z"/></svg>
              </a>
            </div>
          </div>

          <div>
            <h5>Navigácia</h5>
            <ul>
              <li><a href={buildUrl(lang, '/')}>Domov</a></li>
              <li><a href={buildUrl(lang, '/sluzby')}>Služby</a></li>
              <li><a href={buildUrl(lang, '/pripadove-studie')}>Prípadové štúdie</a></li>
              <li><a href={buildUrl(lang, '/cennik')}>Cenník</a></li>
            </ul>
          </div>

          <div>
            <h5>Firma</h5>
            <ul>
              <li><a href={buildUrl(lang, '/o-nas')}>O nás</a></li>
              <li><a href={buildUrl(lang, '/ako-to-funguje')}>Ako to funguje</a></li>
              <li><a href={buildUrl(lang, '/partneri')}>Partneri</a></li>
              <li><a href={buildUrl(lang, '/kontakt')}>Kontakt</a></li>
            </ul>
          </div>

          <div>
            <h5>Zdroje</h5>
            <ul>
              <li><a href={buildUrl(lang, '/blog')}>Blog</a></li>
              <li><a href={buildUrl(lang, '/faq')}>FAQ</a></li>
              <li><a href={buildUrl(lang, '/partneri')}>Partneri</a></li>
            </ul>
          </div>
        </div>

        <!-- Bottom strip -->
        <div class="footer-bottom">
          <div>© {new Date().getFullYear()} Adlify s.r.o. — Všetky práva vyhradené.</div>
          <div class="footer-bottom-links">
            <a href={buildUrl(lang, '/ochrana-udajov')}>Ochrana údajov</a>
            <a href={buildUrl(lang, '/obchodne-podmienky')}>Obchodné podmienky</a>
            <a href={buildUrl(lang, '/cookies')}>Cookies</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- ============ INTERACTIVITY ============ -->
    <!-- Externý JS modul: cursor blob, word rotator, hero chart, counters,
         contact drawer, BEFORE/AFTER slider. Defer = beží po HTML parsingu. -->
    <script src="/js/adlify-app.js" defer></script>

    <script>
      // === Scroll progress bar ===
      const sp = document.getElementById('scroll-progress');
      if (sp) {
        const onScroll = () => {
          const h = document.documentElement;
          const max = h.scrollHeight - h.clientHeight;
          const p = max > 0 ? h.scrollTop / max : 0;
          sp.style.transform = `scaleX(${p})`;
        };
        document.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }

      // === Language dropdown ===
      const langBtn = document.getElementById('lang-btn');
      const langDd  = document.getElementById('lang-dd');
      if (langBtn && langDd) {
        langBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = langDd.classList.toggle('open');
          langBtn.setAttribute('aria-expanded', String(isOpen));
        });
        document.addEventListener('click', (e) => {
          if (!langDd.contains(e.target) && !langBtn.contains(e.target)) {
            langDd.classList.remove('open');
            langBtn.setAttribute('aria-expanded', 'false');
          }
        });
      }

      // === Mobile drawer ===
      const ham    = document.getElementById('hamburger-btn');
      const drawer = document.getElementById('mobile-drawer');
      const close  = document.getElementById('drawer-close-btn');
      const openDrawer = () => {
        drawer?.classList.add('open');
        drawer?.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      };
      const closeDrawer = () => {
        drawer?.classList.remove('open');
        drawer?.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      };
      ham?.addEventListener('click', openDrawer);
      close?.addEventListener('click', closeDrawer);
      // Zavrieť drawer pri kliku na link vo vnútri
      drawer?.querySelectorAll('a').forEach((a) => {
        a.addEventListener('click', () => setTimeout(closeDrawer, 50));
      });
      // ESC zavrie drawer
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeDrawer();
      });

      // === Reveal on scroll (.rv → .rv.in) ===
      const rvEls = document.querySelectorAll('.rv');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('in');
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });
        rvEls.forEach((el) => io.observe(el));
      } else {
        rvEls.forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>
