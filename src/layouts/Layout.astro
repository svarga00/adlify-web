---
/**
 * Hlavný layout pre celý web Adlify.
 * Obsahuje:
 *  - <head> so SEO meta (title, description, og:*, hreflang)
 *  - sticky header s desktop navigáciou + jazykový switcher
 *  - mobile hamburger drawer
 *  - footer s CTA blokom + 4-stĺpcová navigácia
 *
 * Props:
 *  - title: string             — <title> + og:title
 *  - description: string       — meta description + og:description
 *  - lang: 'sk'|'cs'|'hu'|'en'|'de'  — aktuálny jazyk (default 'sk')
 *  - pathname: string          — aktuálna cesta (napr. "/sluzby") pre hreflang
 *  - ogImage?: string          — full URL na OG obrázok
 */

import '../styles/global.css';
import { LANGS, EXTRA_LANGS, buildUrl, type Lang } from '../lib/i18n';
import { t } from '../lib/translations';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  pathname?: string;
  ogImage?: string;
  /**
   * Type of page for JSON-LD schema generation.
   *  - 'website' (default): Adds Organization schema only
   *  - 'article':           Adds Article schema (use with articleData)
   *  - 'localbusiness':     Adds LocalBusiness schema (kontakt page)
   */
  pageType?: 'website' | 'article' | 'localbusiness';
  /**
   * Article-specific data (only used when pageType='article')
   */
  articleData?: {
    publishedTime?: string;  // ISO date
    modifiedTime?: string;   // ISO date
    author?: string;
    section?: string;        // category
  };
}

const {
  title,
  description,
  lang = 'sk',
  pathname = '/',
  ogImage = '/img/og-default.jpg',
  pageType = 'website',
  articleData,
} = Astro.props;

const SITE = 'https://adlify.eu';

const canonicalPath = buildUrl(lang, pathname);
const canonicalUrl = SITE + canonicalPath;

// Navigation — preložené per lang cez t()
const NAV_ITEMS: Array<{ href: string; key: string }> = [
  { href: '/',                 key: 'nav.home' },
  { href: '/sluzby',           key: 'nav.services' },
  { href: '/ako-to-funguje',   key: 'nav.howItWorks' },
  { href: '/pripadove-studie', key: 'nav.cases' },
  { href: '/cennik',           key: 'nav.pricing' },
  { href: '/o-nas',            key: 'nav.about' },
  { href: '/kontakt',          key: 'nav.contact' },
];

const currentLangObj = LANGS.find((l) => l.code === lang) ?? LANGS[0];

// Site settings (footer email, social linky, copyright)
import { fetchSettings } from '../lib/content';
const siteSettings = await fetchSettings(lang);
---

<!DOCTYPE html>
<html
  lang={lang}
  data-theme="light"
  style="--grad-start: #F16434; --grad-mid: #F47F3F; --grad-end: #E85D9C;"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Canonical + hreflang -->
    <link rel="canonical" href={canonicalUrl} />
    {LANGS.map((l) => (
      <link
        rel="alternate"
        hreflang={l.code}
        href={SITE + buildUrl(l.code, pathname)}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={SITE + buildUrl('sk', pathname)}
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.startsWith('http') ? ogImage : SITE + ogImage} />
    <meta property="og:locale" content={currentLangObj.locale} />
    {LANGS.filter((l) => l.code !== lang).map((l) => (
      <meta property="og:locale:alternate" content={l.locale} />
    ))}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.startsWith('http') ? ogImage : SITE + ogImage} />

    <!-- Performance: preload assets, preconnect fonty -->
    <link rel="preload" href="/img/logo.webp" as="image" fetchpriority="high" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Async font load (non-render-blocking). Fallback in <noscript> for no-JS clients. -->
    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
        rel="stylesheet"
      />
    </noscript>

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- ============ JSON-LD STRUCTURED DATA ============ -->
    <!-- Organization schema (vždy prítomný) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Adlify',
      url: SITE,
      logo: SITE + '/img/logo.webp',
      description: 'Výkonnostná marketingová agentúra. Spravujeme Google a Meta Ads pre e-shopy a remeselníkov.',
      sameAs: [
        'https://www.facebook.com/adlify',
        'https://www.linkedin.com/company/adlify',
      ],
      contactPoint: {
        '@type': 'ContactPoint',
        email: 'info@adlify.eu',
        contactType: 'customer service',
        availableLanguage: ['Slovak', 'Czech', 'English'],
      },
    })} />

    <!-- Article schema (pre blog detail stránky) -->
    {pageType === 'article' && articleData && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: title,
        description: description,
        image: ogImage.startsWith('http') ? ogImage : SITE + ogImage,
        datePublished: articleData.publishedTime,
        dateModified: articleData.modifiedTime || articleData.publishedTime,
        author: {
          '@type': 'Person',
          name: articleData.author || 'Adlify',
        },
        publisher: {
          '@type': 'Organization',
          name: 'Adlify',
          logo: {
            '@type': 'ImageObject',
            url: SITE + '/img/logo.webp',
          },
        },
        mainEntityOfPage: {
          '@type': 'WebPage',
          '@id': canonicalUrl,
        },
        ...(articleData.section && { articleSection: articleData.section }),
      })} />
    )}

    <!-- LocalBusiness schema (pre kontakt) -->
    {pageType === 'localbusiness' && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'ProfessionalService',
        name: 'Adlify',
        image: SITE + '/img/logo.webp',
        '@id': SITE,
        url: SITE,
        email: 'info@adlify.eu',
        priceRange: '€€',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Prešov',
          addressCountry: 'SK',
        },
        areaServed: ['SK', 'CZ', 'HU'],
      })} />
    )}
    <!-- ============ GOOGLE CONSENT MODE v2 (must be FIRST script) ============ -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      // Default: deny all until consent
      gtag('consent', 'default', {
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'analytics_storage': 'denied',
        'functionality_storage': 'granted',
        'security_storage': 'granted',
        'wait_for_update': 500
      });
      // Check saved consent
      if (localStorage.getItem('adlify_consent') === 'all') {
        gtag('consent', 'update', {
          'ad_storage': 'granted',
          'ad_user_data': 'granted',
          'ad_personalization': 'granted',
          'analytics_storage': 'granted'
        });
      }
    </script>

    <!-- ============ GTM (Google Tag Manager) ============ -->
    <!-- TODO: nahradiť GT-WR9NW2FV za reálne GTM container ID -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GT-WR9NW2FV');
    </script>

    <!-- ============ GA4 (fallback ak GTM nie je nastavený) ============ -->
    <!-- TODO: nahradiť G-8XXE3MYJMN za reálne GA4 Measurement ID -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-8XXE3MYJMN"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-8XXE3MYJMN', { send_page_view: true });
    </script>

    <!-- ============ Microsoft Clarity ============ -->
    <!-- TODO: nahradiť 515578426 za reálne Clarity project ID -->
    <script is:inline>
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window,document,"clarity","script","515578426");
    </script>
  </head>

  <body>
    <!-- GTM noscript fallback -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GT-WR9NW2FV" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

    <!-- Scroll progress bar (gradient line) -->
    <div
      aria-hidden="true"
      id="scroll-progress"
      style="position: fixed; top: 0; left: 0; right: 0; height: 2px; z-index: 999; background: linear-gradient(90deg, var(--grad-start), var(--grad-end)); transform-origin: 0 0; transform: scaleX(0); transition: transform 0.08s linear; box-shadow: 0 0 12px color-mix(in srgb, var(--grad-start) 50%, transparent);"
    ></div>

    <!-- ============ HEADER ============ -->
    <header class="topbar">
      <div class="container topbar-row">
        <!-- Logo -->
        <a href={lang === 'sk' ? '/' : `/${lang}/`} class="brand" aria-label="Adlify">
          <img src="/img/logo.webp" alt="Adlify" style="height: 32px; width: auto;" fetchpriority="high" loading="eager" />
        </a>

        <!-- Desktop nav -->
        <nav class="main">
          {NAV_ITEMS.map((item) => {
            const href = buildUrl(lang, item.href);
            const isActive = canonicalPath === href;
            return (
              <a href={href} class={isActive ? 'active' : ''}>
                {t(item.key, lang)}
              </a>
            );
          })}
        </nav>

        <!-- Topbar actions -->
        <div class="topbar-actions">
          <!-- Language switcher (skrytý keď EXTRA_LANGS je prázdny) -->
          {EXTRA_LANGS.length > 0 && (
          <div style="position: relative;" id="lang-wrap">
            <button class="lang-btn" id="lang-btn" aria-haspopup="listbox" aria-expanded="false">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9"></circle>
                <path d="M3 12h18"></path>
                <path d="M12 3a14 14 0 0 1 0 18"></path>
                <path d="M12 3a14 14 0 0 0 0 18"></path>
              </svg>
              <span style="text-transform: uppercase;">{currentLangObj.short}</span>
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </button>
            <div class="lang-dd" id="lang-dd" role="listbox">
              {LANGS.map((l) => (
                <a
                  href={buildUrl(l.code, pathname)}
                  style={l.code === lang ? 'background: var(--bg-soft);' : 'background: transparent;'}
                  role="option"
                  aria-selected={l.code === lang}
                >
                  <span>{l.label}</span>
                  <span class="code">{l.short}</span>
                </a>
              ))}
            </div>
          </div>
          )}

          <!-- CTA -->
          <a href={`${buildUrl(lang, '/kontakt')}#formular`} class="btn btn-sm btn-ink">
            {t('cta.freeConsultation', lang)}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>
        </div>

        <!-- Hamburger (mobile only) -->
        <button class="hamburger" id="hamburger-btn" aria-label={t('nav.home', lang)}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="3" y1="6"  x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>
    </header>

    <!-- ============ MOBILE DRAWER ============ -->
    <aside class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
      <div class="mobile-drawer-header">
        <a href={lang === 'sk' ? '/' : `/${lang}/`} class="brand" aria-label="Adlify">
          <img src="/img/logo.webp" alt="Adlify" style="height: 28px; width: auto;" />
        </a>
        <button class="mobile-drawer-close" id="drawer-close-btn" aria-label="Zavrieť menu">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="18" y1="6"  x2="6"  y2="18"></line>
            <line x1="6"  y1="6"  x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <nav>
        {NAV_ITEMS.map((item) => {
          const href = buildUrl(lang, item.href);
          const isActive = canonicalPath === href;
          return (
            <a href={href} class={isActive ? 'active' : ''}>
              <span>{t(item.key, lang)}</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m9 18 6-6-6-6"></path>
              </svg>
            </a>
          );
        })}
      </nav>

      <div class="mobile-drawer-footer">
        <div class="mobile-drawer-lang">
          {LANGS.map((l) => (
            <a
              href={buildUrl(l.code, pathname)}
              class={l.code === lang ? 'active' : ''}
            >
              {l.short}
            </a>
          ))}
        </div>
        <a href={`${buildUrl(lang, '/kontakt')}#formular`} class="btn btn-grad" style="justify-content: center;">
          {t('cta.freeConsultation', lang)}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"></path>
            <path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </aside>

    <!-- ============ MAIN CONTENT ============ -->
    <main>
      <slot />
    </main>

    <!-- ============ FOOTER ============ -->
    <footer class="footer">
      <div class="container">
        <!-- 4-col footer nav -->
        <div class="footer-grid">
          <div>
            <a href={lang === 'sk' ? '/' : `/${lang}/`} aria-label="Adlify domov">
              <img src="/img/logo.webp" alt="Adlify" style="height: 32px; width: auto; margin-bottom: 20px;" />
            </a>
            <p class="body" style="font-size: 14px; max-width: 28ch; margin-bottom: 24px;">
              {siteSettings.footer_tagline || t('footer.tagline', lang)}
            </p>
            <div style="display: flex; gap: 12px;">
              {siteSettings.social_linkedin && (
              <a href={siteSettings.social_linkedin} aria-label="LinkedIn" target="_blank" rel="noopener" style="width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--line); display: flex; align-items: center; justify-content: center;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
              </a>
              )}
              {siteSettings.social_instagram && (
              <a href={siteSettings.social_instagram} aria-label="Instagram" target="_blank" rel="noopener" style="width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--line); display: flex; align-items: center; justify-content: center;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              </a>
              )}
              {siteSettings.social_facebook && (
              <a href={siteSettings.social_facebook} aria-label="Facebook" target="_blank" rel="noopener" style="width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--line); display: flex; align-items: center; justify-content: center;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M9.198 21.5h4v-8.01h3.604l.396-3.98h-4V7.5a1 1 0 0 1 1-1h3v-4h-3a5 5 0 0 0-5 5v2.01h-2l-.396 3.98h2.396v8.01z"/></svg>
              </a>
              )}
            </div>
          </div>

          <div>
            <h5>{t('footer.colNav', lang)}</h5>
            <ul>
              <li><a href={buildUrl(lang, '/')}>{t('nav.home', lang)}</a></li>
              <li><a href={buildUrl(lang, '/sluzby')}>{t('nav.services', lang)}</a></li>
              <li><a href={buildUrl(lang, '/pripadove-studie')}>{t('nav.cases', lang)}</a></li>
              <li><a href={buildUrl(lang, '/cennik')}>{t('nav.pricing', lang)}</a></li>
            </ul>
          </div>

          <div>
            <h5>{t('footer.colCompany', lang)}</h5>
            <ul>
              <li><a href={buildUrl(lang, '/o-nas')}>{t('nav.about', lang)}</a></li>
              <li><a href={buildUrl(lang, '/ako-to-funguje')}>{t('nav.howItWorks', lang)}</a></li>
              <li><a href={buildUrl(lang, '/s-cim-pracujeme')}>{t('nav.tools', lang)}</a></li>
              <li><a href={buildUrl(lang, '/kontakt')}>{t('nav.contact', lang)}</a></li>
            </ul>
          </div>

          <div>
            <h5>{t('footer.colResources', lang)}</h5>
            <ul>
              <li><a href={buildUrl(lang, '/odvetvia')}>{t('nav.industries', lang)}</a></li>
              <li><a href={buildUrl(lang, '/blog')}>{t('nav.blog', lang)}</a></li>
              <li><a href={buildUrl(lang, '/faq')}>{t('nav.faq', lang)}</a></li>
            </ul>
          </div>
        </div>

        <!-- Bottom strip -->
        <div class="footer-bottom">
          <div>{siteSettings.footer_copyright || `© ${new Date().getFullYear()} ${siteSettings.company_name || 'Adlify s.r.o.'} — ${t('footer.copyright', lang)}`}</div>
          <div class="footer-bottom-links">
            <a href={buildUrl(lang, '/ochrana-udajov')}>{t('footer.privacy', lang)}</a>
            <a href={buildUrl(lang, '/obchodne-podmienky')}>{t('footer.terms', lang)}</a>
            <a href={buildUrl(lang, '/cookies')}>{t('footer.cookies', lang)}</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- ============ INTERACTIVITY ============ -->
    <!-- Externý JS modul: cursor blob, word rotator, hero chart, counters,
         contact drawer, BEFORE/AFTER slider. Defer = beží po HTML parsingu. -->
    <script src="/js/adlify-app.js?v=20260507f" defer></script>

    <script>
      // === Scroll progress bar ===
      const sp = document.getElementById('scroll-progress');
      if (sp) {
        const onScroll = () => {
          const h = document.documentElement;
          const max = h.scrollHeight - h.clientHeight;
          const p = max > 0 ? h.scrollTop / max : 0;
          sp.style.transform = `scaleX(${p})`;
        };
        document.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }

      // === Language dropdown ===
      const langBtn = document.getElementById('lang-btn');
      const langDd  = document.getElementById('lang-dd');
      if (langBtn && langDd) {
        langBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const isOpen = langDd.classList.toggle('open');
          langBtn.setAttribute('aria-expanded', String(isOpen));
        });
        document.addEventListener('click', (e) => {
          if (!langDd.contains(e.target) && !langBtn.contains(e.target)) {
            langDd.classList.remove('open');
            langBtn.setAttribute('aria-expanded', 'false');
          }
        });
      }

      // === Mobile drawer ===
      const ham    = document.getElementById('hamburger-btn');
      const drawer = document.getElementById('mobile-drawer');
      const close  = document.getElementById('drawer-close-btn');
      const openDrawer = () => {
        drawer?.classList.add('open');
        drawer?.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      };
      const closeDrawer = () => {
        drawer?.classList.remove('open');
        drawer?.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      };
      ham?.addEventListener('click', openDrawer);
      close?.addEventListener('click', closeDrawer);
      // Zavrieť drawer pri kliku na link vo vnútri
      drawer?.querySelectorAll('a').forEach((a) => {
        a.addEventListener('click', () => setTimeout(closeDrawer, 50));
      });
      // ESC zavrie drawer
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeDrawer();
      });

      // === Reveal on scroll (.rv → .rv.in) ===
      const rvEls = document.querySelectorAll('.rv');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('in');
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -10% 0px' });
        rvEls.forEach((el) => io.observe(el));
      } else {
        rvEls.forEach((el) => el.classList.add('in'));
      }
    </script>

    <!-- ============ COOKIE CONSENT BANNER ============ -->
    <div id="cookie-banner" style="position: fixed; bottom: 16px; left: 16px; right: 16px; max-width: 480px; margin: 0 auto; z-index: 9000; background: var(--ink); color: var(--bg); padding: 20px 24px; border-radius: 16px; box-shadow: 0 12px 40px rgba(0,0,0,0.25); display: none;">
      <div style="font-size: 13px; line-height: 1.5; margin-bottom: 16px;">
        Používame cookies pre fungovanie webu, analytiku a personalizáciu reklamy.
        Detaily nájdete v <a href={buildUrl(lang, '/cookies')} style="color: var(--bg); text-decoration: underline;">Cookies</a>.
      </div>
      <div style="display: flex; gap: 8px; flex-wrap: wrap;">
        <button id="cookie-accept-all" style="flex: 1; min-width: 120px; padding: 10px 14px; background: linear-gradient(135deg, var(--grad-start), var(--grad-end)); color: white; border: none; border-radius: 999px; font-size: 13px; font-weight: 600; cursor: pointer;">
          Prijať všetky
        </button>
        <button id="cookie-accept-essential" style="flex: 1; min-width: 120px; padding: 10px 14px; background: transparent; color: var(--bg); border: 1px solid rgba(255,255,255,0.25); border-radius: 999px; font-size: 13px; font-weight: 600; cursor: pointer;">
          Len nevyhnutné
        </button>
      </div>
    </div>

    <script is:inline>
      // Cookie consent + Google Consent Mode v2
      (function () {
        var KEY = 'adlify_consent';
        var banner = document.getElementById('cookie-banner');
        if (!banner) return;

        var saved = localStorage.getItem(KEY);
        if (!saved) {
          setTimeout(function() { banner.style.display = 'block'; }, 800);
        }

        function grantAll() {
          if (typeof gtag === 'function') {
            gtag('consent', 'update', {
              'ad_storage': 'granted',
              'ad_user_data': 'granted',
              'ad_personalization': 'granted',
              'analytics_storage': 'granted'
            });
          }
        }

        document.getElementById('cookie-accept-all').addEventListener('click', function() {
          localStorage.setItem(KEY, 'all');
          banner.style.display = 'none';
          grantAll();
        });

        document.getElementById('cookie-accept-essential').addEventListener('click', function() {
          localStorage.setItem(KEY, 'essential');
          banner.style.display = 'none';
          // consent zostáva denied (default)
        });

        // Reset z /cookies stránky
        var resetBtns = document.querySelectorAll('[data-cookie-reset]');
        for (var i = 0; i < resetBtns.length; i++) {
          resetBtns[i].addEventListener('click', function(e) {
            e.preventDefault();
            localStorage.removeItem(KEY);
            banner.style.display = 'block';
          });
        }
      })();
    </script>
    <!-- Scroll-spy pre legal stránky ToC -->
    <script is:inline>
      (function () {
        var tocLinks = document.querySelectorAll('.legal-toc a');
        if (!tocLinks.length) return;

        var ids = [];
        var idToLink = {};
        for (var i = 0; i < tocLinks.length; i++) {
          var href = tocLinks[i].getAttribute('href');
          if (href && href.charAt(0) === '#') {
            var id = href.slice(1);
            ids.push(id);
            idToLink[id] = tocLinks[i];
          }
        }

        var headings = [];
        for (var j = 0; j < ids.length; j++) {
          var el = document.getElementById(ids[j]);
          if (el) headings.push(el);
        }
        if (!headings.length) return;

        var observer = new IntersectionObserver(function (entries) {
          var visible = entries.filter(function (e) { return e.isIntersecting; });
          if (visible.length > 0) {
            visible.sort(function (a, b) { return a.boundingClientRect.top - b.boundingClientRect.top; });
            var activeId = visible[0].target.id;
            for (var k = 0; k < tocLinks.length; k++) {
              tocLinks[k].classList.remove('active');
            }
            if (idToLink[activeId]) {
              idToLink[activeId].classList.add('active');
            }
          }
        }, { rootMargin: '-100px 0px -70% 0px', threshold: 0 });

        for (var m = 0; m < headings.length; m++) {
          observer.observe(headings[m]);
        }
      })();
    </script>

  </body>
</html>
