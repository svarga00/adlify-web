  <!-- ============================================
       INTERACTIVITY pre tieto sekcie
       ============================================ -->
  <script>
    // === SECTION 5 — Pred a po: timeline + dashboard sync ===
    (function () {
      // 8 mesiacov, hodnoty interpolujú medzi PRED (€27 480, ROAS 2.11×, 251 konv, CPA €18.20)
      // a PO 6M (€87 412, ROAS 5.42×, 1284 konv, CPA €8.40).
      const months = ['Marec', 'Apríl', 'Máj', 'Jún', 'Júl', 'August', 'September', 'Október'];
      const data = [
        { rev: 27480, roas: 2.11, conv: 251,  cpa: 18.20 }, // PRED
        { rev: 34939, roas: 2.52, conv: 380,  cpa: 17.00 },
        { rev: 43200, roas: 3.05, conv: 520,  cpa: 15.40 },
        { rev: 52800, roas: 3.62, conv: 690,  cpa: 13.80 },
        { rev: 62500, roas: 4.18, conv: 850,  cpa: 12.20 },
        { rev: 71800, roas: 4.65, conv: 1010, cpa: 10.80 },
        { rev: 80100, roas: 5.05, conv: 1160, cpa: 9.50  },
        { rev: 87412, roas: 5.42, conv: 1284, cpa: 8.40  }, // PO 6M
      ];
      const baseline = data[0];

      const fmtEur = (n) => '€' + n.toLocaleString('sk-SK').replace(/\u00A0|\s/g, '\u00A0');
      const fmtRoas = (n) => n.toFixed(2) + '×';
      const fmtCpa  = (n) => '€' + n.toFixed(1);
      const pctDelta = (curr, base) => {
        const d = ((curr - base) / base) * 100;
        const sign = d >= 0 ? '+' : '−';
        return sign + Math.abs(Math.round(d)) + '%';
      };

      const monthBtns = document.querySelectorAll('[data-ba-month]');
      const labelEl   = document.querySelector('[data-ba-month-label]');

      const elRev  = document.querySelector('[data-ba-metric="revenue"]');
      const elRoas = document.querySelector('[data-ba-metric="roas"]');
      const elConv = document.querySelector('[data-ba-metric="conv"]');
      const elCpa  = document.querySelector('[data-ba-metric="cpa"]');
      const dRev   = document.querySelector('[data-ba-delta="revenue"]');
      const dRoas  = document.querySelector('[data-ba-delta="roas"]');
      const dConv  = document.querySelector('[data-ba-delta="conv"]');
      const dCpa   = document.querySelector('[data-ba-delta="cpa"]');

      const dashMonth = document.querySelector('[data-ba-dash-month]');
      const dashRev   = document.querySelector('[data-ba-dash-revenue]');
      const dashDelta = document.querySelector('[data-ba-dash-delta]');
      const dashRoas  = document.querySelector('[data-ba-dash-roas]');
      const dashConv  = document.querySelector('[data-ba-dash-conv]');
      const dashCpa   = document.querySelector('[data-ba-dash-cpa]');

      const bars = document.querySelectorAll('[data-ba-bars] .ba-bar');

      function setMonth(idx) {
        const d = data[idx];
        monthBtns.forEach((b, i) => b.classList.toggle('active', i <= idx));
        if (labelEl) labelEl.textContent = `Mesiac ${idx + 1}/8`;

        // CPA klesá → zobrazujeme ako "−X%"
        const cpaDeltaPct = ((d.cpa - baseline.cpa) / baseline.cpa) * 100;
        const cpaText = (cpaDeltaPct >= 0 ? '+' : '−') + Math.abs(Math.round(cpaDeltaPct)) + '%';

        if (elRev)  elRev.textContent  = fmtEur(d.rev);
        if (elRoas) elRoas.textContent = fmtRoas(d.roas);
        if (elConv) elConv.textContent = d.conv.toLocaleString('sk-SK');
        if (elCpa)  elCpa.textContent  = fmtCpa(d.cpa);
        if (dRev)   dRev.textContent   = pctDelta(d.rev,  baseline.rev);
        if (dRoas)  dRoas.textContent  = pctDelta(d.roas, baseline.roas);
        if (dConv)  dConv.textContent  = pctDelta(d.conv, baseline.conv);
        if (dCpa)   dCpa.textContent   = cpaText;

        if (dashMonth) dashMonth.textContent = months[idx] + ' 2026';
        if (dashRev)   dashRev.textContent   = fmtEur(d.rev);
        if (dashDelta) dashDelta.textContent = pctDelta(d.rev, baseline.rev);
        if (dashRoas)  dashRoas.textContent  = fmtRoas(d.roas);
        if (dashConv)  dashConv.textContent  = d.conv.toLocaleString('sk-SK');
        if (dashCpa)   dashCpa.textContent   = fmtCpa(d.cpa);

        // Bars rastú s mesiacom
        bars.forEach((bar, i) => {
          const progress = idx / 7;
          const baseHeight = 30 + (i * 10) / 25;
          const target = baseHeight + progress * 50;
          bar.style.height = target + '%';
        });
      }

      monthBtns.forEach((btn, i) => btn.addEventListener('click', () => setMonth(i)));

      // Auto-cycle (stop pri user-clicku)
      let i = 1;
      const interval = setInterval(() => {
        i++;
        if (i > 7) { clearInterval(interval); return; }
        setMonth(i);
      }, 2000);
      monthBtns.forEach((btn) =>
        btn.addEventListener('click', () => clearInterval(interval), { once: true })
      );
    })();

    // === SECTION 7 — Services accordion ===
    (function () {
      const toggles = document.querySelectorAll('[data-svc-toggle]');
      const panes   = document.querySelectorAll('[data-svc-pane]');
      toggles.forEach((btn) => {
        btn.addEventListener('click', () => {
          const idx = btn.getAttribute('data-svc-toggle');
          toggles.forEach((b) => b.classList.toggle('active', b.getAttribute('data-svc-toggle') === idx));
          panes.forEach((p)   => p.classList.toggle('active', p.getAttribute('data-svc-pane') === idx));
        });
      });
    })();
  </script>

